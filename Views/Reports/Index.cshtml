@using Student_Management_System.Services
@inject PermissionService Permissions
@{
    ViewData["Title"] = "Reports and analytics";
    var query = ViewBag.Query as ReportCenterQuery ?? new ReportCenterQuery();
    var dataset = ViewBag.Dataset as ReportDataset;
    var departments = ViewBag.Departments as IEnumerable<Department> ?? [];
    var classes = ViewBag.Classes as IEnumerable<Class> ?? [];
    var sections = ViewBag.Sections as IEnumerable<Section> ?? [];
    var subjects = ViewBag.Subjects as IEnumerable<Subject> ?? [];
    var years = ViewBag.Years as IEnumerable<AcademicYear> ?? [];
    var savedReports = ViewBag.SavedReports as IEnumerable<SavedReport> ?? [];
    var availableReports = ViewBag.AvailableReports as IReadOnlyList<string> ?? [];
    var canExport = await Permissions.HasAsync(User, "reports.export");
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Permission-aware analytics</span><h1>Reports and analytics</h1><p>Every report is calculated from the complete authorized filtered query—not the displayed browser page.</p></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Current report rows</span><strong class="metric-value">@(dataset?.Rows.Count ?? 0)</strong><span class="metric-note">Maximum safety limit applies</span></article><article class="metric-card info"><span class="metric-label">Saved filters</span><strong class="metric-value">@savedReports.Count()</strong><span class="metric-note">Owned or shared with you</span></article><article class="metric-card success"><span class="metric-label">Export formats</span><strong class="metric-value">3</strong><span class="metric-note">CSV, Excel, print/PDF</span></article></div>
<form method="get" class="card filter-panel">
<div class="filter-panel-grid">
    <div><label class="form-label" for="reportType">Report</label><select id="reportType" name="ReportType" class="form-select">@foreach(var type in availableReports){<option value="@type" selected="@(query.ReportType == type)">@System.Text.RegularExpressions.Regex.Replace(type, "([a-z])([A-Z])", "$1 $2")</option>}</select></div>
    <div><label class="form-label" for="field-reports-index-search-3152">Search</label><input id="field-reports-index-search-3152" name="Search" value="@query.Search" class="form-control" placeholder="Student or record search" /></div>
    <div><label class="form-label" for="field-reports-index-departmentid-3313">Department</label><select id="field-reports-index-departmentid-3313" name="DepartmentId" class="form-select"><option value="">All authorized</option>@foreach(var item in departments){<option value="@item.Id" selected="@(query.DepartmentId==item.Id)">@item.Name</option>}</select></div>
    <div><label class="form-label" for="field-reports-index-classid-3591">Class</label><select id="field-reports-index-classid-3591" name="ClassId" class="form-select"><option value="">All</option>@foreach(var item in classes){<option value="@item.Id" selected="@(query.ClassId==item.Id)">@item.Name</option>}</select></div>
    <div><label class="form-label" for="field-reports-index-sectionid-3839">Section</label><select id="field-reports-index-sectionid-3839" name="SectionId" class="form-select"><option value="">All</option>@foreach(var item in sections){<option value="@item.Id" selected="@(query.SectionId==item.Id)">@item.Name</option>}</select></div>
    <div><label class="form-label" for="field-reports-index-subjectid-4094">Subject</label><select id="field-reports-index-subjectid-4094" name="SubjectId" class="form-select"><option value="">All</option>@foreach(var item in subjects){<option value="@item.Id" selected="@(query.SubjectId==item.Id)">@item.Name</option>}</select></div>
    <div><label class="form-label" for="field-reports-index-academicyearid-4349">Academic year</label><select id="field-reports-index-academicyearid-4349" name="AcademicYearId" class="form-select"><option value="">All</option>@foreach(var item in years){<option value="@item.Id" selected="@(query.AcademicYearId==item.Id)">@item.Name</option>}</select></div>
    <div><label class="form-label" for="field-reports-index-from-4617">From</label><input id="field-reports-index-from-4617" name="From" type="date" value="@query.From?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div><label class="form-label" for="field-reports-index-to-4769">To</label><input id="field-reports-index-to-4769" name="To" type="date" value="@query.To?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="filter-actions"><button class="btn btn-primary" asp-action="Index">Run report</button>@if(canExport){<button class="btn btn-outline-success" asp-action="Export" name="Format" value="Excel" title="Exports all authorized filtered rows">Export all filtered · Excel</button><button class="btn btn-outline-secondary" asp-action="Export" name="Format" value="Csv" title="Exports all authorized filtered rows">CSV</button><button class="btn btn-outline-secondary" asp-action="Export" name="Format" value="Print" formtarget="_blank">Print / PDF</button>}</div>
</div>
</form>
@if(dataset != null)
{
<section class="card table-card"><div class="section-title-row p-3"><div><h2>@dataset.Title</h2><p>@dataset.ScopeDescription · @dataset.Rows.Count rows</p></div></div>@if(dataset.Rows.Count==0){<div class="empty-state"><span class="empty-state-icon"><i class="fa-solid fa-chart-column"></i></span><h3>No matching records</h3><p>Adjust the filters and run the report again.</p></div>}else{<div class="table-responsive"><table class="table"><caption class="visually-hidden">Authorized filtered report preview</caption><thead><tr>@foreach(var header in dataset.Headers){<th scope="col">@header</th>}</tr></thead><tbody>@foreach(var row in dataset.Rows.Take(250)){<tr>@foreach(var value in row){<td>@value</td>}</tr>}</tbody></table></div>@if(dataset.Rows.Count>250){<div class="alert alert-info m-3">The preview shows 250 rows. Exports contain all @dataset.Rows.Count authorized filtered rows.</div>}}</section>
<form asp-action="Save" method="post" class="card section-card mt-3"><div class="section-title-row"><div><h2>Save this filter</h2><p>Reuse the current report configuration without saving report data.</p></div></div><input type="hidden" name="query.ReportType" value="@query.ReportType" /><input type="hidden" name="query.Search" value="@query.Search" /><input type="hidden" name="query.DepartmentId" value="@query.DepartmentId" /><input type="hidden" name="query.ClassId" value="@query.ClassId" /><input type="hidden" name="query.SectionId" value="@query.SectionId" /><input type="hidden" name="query.SubjectId" value="@query.SubjectId" /><input type="hidden" name="query.AcademicYearId" value="@query.AcademicYearId" /><input type="hidden" name="query.From" value="@query.From?.ToString("O")" /><input type="hidden" name="query.To" value="@query.To?.ToString("O")" /><div class="row g-2"><div class="col-md-8"><label class="form-label" for="field-reports-index-name-7228">Saved report name</label><input id="field-reports-index-name-7228" name="name" class="form-control" maxlength="160" required /></div><div class="col-md-2 d-flex align-items-end"><label class="form-check"><input name="isShared" value="true" type="checkbox" class="form-check-input" /><span class="form-check-label">Share</span></label></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Save filter</button></div></div></form>
}
<div class="alert alert-warning mt-3"><i class="fa-solid fa-shield-halved"></i> Exports can contain personal or financial information. Store and share them only through approved institutional channels.</div>
@if(savedReports.Any()){
    <section class="card section-card mt-3" aria-labelledby="savedReportsHeading"><h2 id="savedReportsHeading">Saved filters</h2><p class="text-muted">Open a saved filter. Results are recalculated using your current permissions.</p><div class="d-flex gap-2 flex-wrap">
    @foreach(var saved in savedReports){<a asp-action="Index" asp-route-savedReportId="@saved.Id" class="btn btn-outline-secondary">@saved.Name</a>}
    </div></section>
}
