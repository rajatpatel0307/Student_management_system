@model TimetableEntry
@{ ViewData["Title"] = $"{Model.Subject?.Name} timetable period"; var substitutions = ViewBag.Substitutions as IEnumerable<TimetableSubstitution> ?? Enumerable.Empty<TimetableSubstitution>(); var teachers = ViewBag.Teachers as IEnumerable<Teacher> ?? Enumerable.Empty<Teacher>(); var rooms = ViewBag.Rooms as IEnumerable<Room> ?? Enumerable.Empty<Room>(); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Timetable / Period #@Model.Id</span><h1>@Model.Subject?.Name</h1><p>@Model.Class?.Name · @(((DayOfWeek)(Model.DayOfWeek % 7)).ToString()) · @Model.StartsAt.ToString(@"hh\:mm")–@Model.EndsAt.ToString(@"hh\:mm")</p></div><div class="page-actions">@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit period</a>}<a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<section class="card section-card"><div class="detail-grid"><div class="detail-item"><small>Class</small><strong>@if(User.IsInRole("Student")){<span>@Model.Class?.Name</span>}else{<a asp-controller="Classes" asp-action="Details" asp-route-id="@Model.ClassId">@Model.Class?.Name</a>}</strong></div><div class="detail-item"><small>Subject</small><strong><a asp-controller="Subject" asp-action="Details" asp-route-id="@Model.SubjectId">@Model.Subject?.Name</a></strong></div><div class="detail-item"><small>Teacher</small><strong>@if(User.IsInRole("Student")){<span>@Model.Teacher?.FullName</span>}else{<a asp-controller="Teachers" asp-action="Details" asp-route-id="@Model.TeacherId">@Model.Teacher?.FullName</a>}</strong></div><div class="detail-item"><small>Room</small><strong>@(string.IsNullOrWhiteSpace(Model.Room)?"Not assigned":Model.Room)</strong></div></div></section>
@if(User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
{
<section class="card section-card mt-3"><div class="section-title-row"><div><h2>Substitution or schedule exception</h2><p>Backend validation prevents Teacher and room conflicts.</p></div></div><form asp-action="Substitute" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="row g-3"><div class="col-md-3"><label class="form-label" for="field-timetable-details-occurson-2190">Date</label><input id="field-timetable-details-occurson-2190" type="date" name="occursOn" class="form-control" required /></div><div class="col-md-3"><label class="form-label" for="field-timetable-details-status-2323">Action</label><select id="field-timetable-details-status-2323" name="status" class="form-select"><option>Substituted</option><option>Cancelled</option><option>Rescheduled</option><option>SpecialLecture</option></select></div><div class="col-md-3"><label class="form-label" for="field-timetable-details-substituteteacherid-2555">Substitute Teacher</label><select id="field-timetable-details-substituteteacherid-2555" name="substituteTeacherId" class="form-select"><option value="">Not applicable</option>@foreach(var teacher in teachers){<option value="@teacher.Id">@teacher.FullName</option>}</select></div><div class="col-md-3"><label class="form-label" for="field-timetable-details-roomid-2828">Room</label><select id="field-timetable-details-roomid-2828" name="roomId" class="form-select"><option value="">Keep current / none</option>@foreach(var room in rooms){<option value="@room.Id">@room.Name</option>}</select></div><div class="col-12"><label class="form-label" for="field-timetable-details-reason-3061">Reason</label><input id="field-timetable-details-reason-3061" name="reason" class="form-control" maxlength="500" /></div></div><div class="form-actions"><button class="btn btn-primary" data-confirm="Create this schedule exception?">Save exception</button></div></form></section>
}
<section class="card table-card mt-3"><div class="section-title-row p-3"><div><h2>Schedule history</h2><p>Cancelled, substituted, rescheduled, and special periods.</p></div></div>@if(!substitutions.Any()){<div class="empty-state compact"><p>No schedule exceptions recorded.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Status</th><th>Teacher</th><th>Room</th><th>Reason</th></tr></thead><tbody>@foreach(var item in substitutions){<tr><td>@item.OccursOn.ToString("dd MMM yyyy")</td><td><span class="badge bg-info">@item.Status</span></td><td>@(item.SubstituteTeacher?.FullName ?? "—")</td><td>@(item.Room?.Name ?? "—")</td><td>@(item.Reason ?? "—")</td></tr>}</tbody></table></div>}</section>
