@model TimetableEntry
@{ ViewData["Title"]="Edit timetable period"; var classes=ViewBag.Classes as IEnumerable<Class>??Enumerable.Empty<Class>(); var subjects=ViewBag.Subjects as IEnumerable<Subject>??Enumerable.Empty<Subject>(); var teachers=ViewBag.Teachers as IEnumerable<Teacher>??Enumerable.Empty<Teacher>(); var rooms=ViewBag.Rooms as IEnumerable<Room>??Enumerable.Empty<Room>(); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Timetable / #@Model.Id / Edit</span><h1>Edit timetable period</h1><p>Class, subject and time conflicts are validated on the backend.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-md-6"><label asp-for="ClassId" class="form-label required">Class</label><select asp-for="ClassId" class="form-select" required>@foreach(var c in classes){<option value="@c.Id" selected="@(c.Id==Model.ClassId?"selected":null)">@c.Name</option>}</select></div><div class="col-md-6"><label asp-for="SubjectId" class="form-label required">Subject</label><select asp-for="SubjectId" class="form-select" required>@foreach(var s in subjects){<option value="@s.Id" selected="@(s.Id==Model.SubjectId?"selected":null)">@s.Name · @(s.Class?.Name ?? "Unassigned class")</option>}</select><span asp-validation-for="SubjectId"></span></div>
<div class="col-md-6"><label asp-for="TeacherId" class="form-label required">Teacher</label><select asp-for="TeacherId" class="form-select" required>@foreach(var t in teachers){<option value="@t.Id" selected="@(t.Id==Model.TeacherId?"selected":null)">@t.FullName</option>}</select></div><div class="col-md-6"><label asp-for="DayOfWeek" class="form-label required">Day</label><select asp-for="DayOfWeek" class="form-select" required>@for(var i=1;i<=7;i++){<option value="@i">@(((DayOfWeek)(i%7)).ToString())</option>}</select></div>
<div class="col-md-4"><label asp-for="StartsAt" class="form-label required">Starts</label><input asp-for="StartsAt" type="time" class="form-control" required /><span asp-validation-for="StartsAt"></span></div><div class="col-md-4"><label asp-for="EndsAt" class="form-label required">Ends</label><input asp-for="EndsAt" type="time" class="form-control" required /><span asp-validation-for="EndsAt"></span></div><div class="col-md-4"><label asp-for="RoomId" class="form-label">Room</label><select asp-for="RoomId" class="form-select"><option value="">No room</option>@foreach(var room in rooms){<option value="@room.Id">@room.Name · @room.Code</option>}</select></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
