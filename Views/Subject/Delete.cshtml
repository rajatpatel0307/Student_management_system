@model Subject
@{ ViewData["Title"] = "Archive subject"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Sensitive action</span><h1>Archive subject</h1><p>Retire the subject while preserving enrollments, attendance, marks, and materials.</p></div></div>
<div class="error-state card"><span class="error-state-icon"><i class="fa-solid fa-box-archive"></i></span><h2>Archive @Model.Name?</h2><p>The subject will stop appearing in active management lists after their archived filters are applied.</p><form asp-action="Delete" method="post" class="w-100"><input asp-for="Id" type="hidden" /><div class="mb-3 text-start"><label class="form-label required" for="archiveReason">Archive reason</label><textarea id="archiveReason" name="reason" class="form-control" maxlength="500" required></textarea></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-danger" type="submit" data-confirm="Archive this subject?">Archive subject</button></div></form></div>
