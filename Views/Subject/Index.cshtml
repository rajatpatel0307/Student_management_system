@model Student_Management_System.Models.PagedResult<Subject>
@using Student_Management_System.Models
@{ViewData["Title"]="Subjects";var query=ViewContext.HttpContext.Request.Query;}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Curriculum",Title="Subjects",Description="Manage curriculum placement, Professor responsibility, enrollment and outcomes from real academic records.",PrimaryAction="Create",PrimaryLabel="Add subject",PrimaryController="Subject",ExportAction="Export",ExportController="Subject"})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-subject-index-search-713">Search subjects</label><input id="field-subject-index-search-713" name="search" value="@Model.Search" class="form-control" placeholder="Subject name"/></div><div><label class="form-label" for="field-subject-index-departmentid-865">Department</label><select id="field-subject-index-departmentid-865" name="departmentId" class="form-select"><option value="">All departments</option>@foreach(var d in (IEnumerable<Department>)ViewBag.Departments){<option value="@d.Id" selected="@(query["departmentId"]==d.Id.ToString())">@d.Name</option>}</select></div><div><label class="form-label" for="field-subject-index-classid-1174">Class</label><select id="field-subject-index-classid-1174" name="classId" class="form-select"><option value="">All classes</option>@foreach(var c in (IEnumerable<Class>)ViewBag.Classes){<option value="@c.Id" selected="@(query["classId"]==c.Id.ToString())">@c.Name</option>}</select></div><div><label class="form-label" for="field-subject-index-status-1455">Professor</label><select id="field-subject-index-status-1455" name="status" class="form-select"><option value="">All</option><option value="unassigned" selected="@(query["status"]=="unassigned")">Unassigned</option></select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Items.Count==0){<partial name="_EmptyRecords" model="@(("No subjects found","Adjust the filters or create a subject.","Create","Add subject"))"/>}else{<div class="table-responsive"><table class="table table-hover" data-enhanced="true"><thead><tr><th>Subject</th><th>Class</th><th>Department</th><th>Semester</th><th>Professor</th><th>Students</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@item.Id" class="record-link">@item.Name</a><small class="d-block text-muted">Subject #@item.Id</small></td><td><a asp-controller="Classes" asp-action="Details" asp-route-id="@item.ClassId" class="record-link">@item.Class.Name</a></td><td>@(item.Department?.Name??"Unassigned")</td><td>@(item.Semester?.Name??"Unassigned")</td><td>@if(item.Teacher!=null){<a asp-controller="Teachers" asp-action="Details" asp-route-id="@item.TeacherId" class="record-link">@item.Teacher.FullName</a>}else{<span class="badge bg-warning">Unassigned</span>}</td><td>@item.StudentEnrollments.Count</td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fa-regular fa-eye"></i></a><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-pen-to-square"></i></a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"><i class="fa-regular fa-trash-can"></i></a></div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/>}</section>
