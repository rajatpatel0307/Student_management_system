@model Student_Management_System.Models.SubjectDetailsViewModel
@{ViewData["Title"]=$"{Model.Subject.Name} · Subject";var item=Model.Subject;}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Curriculum / Subjects / #@item.Id</span><h1>@item.Name</h1><p>Professor assignments, enrollment, attendance, marks, assignments and study materials.</p></div><div class="page-actions"><button data-print-page class="btn btn-outline-secondary"><i class="fa-solid fa-print"></i> Print</button>@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit subject</a>}<a href="#" data-history-back class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Students</span><strong class="metric-value">@Model.Students.Count</strong></article><article class="metric-card info"><span class="metric-label">Professors</span><strong class="metric-value">@Model.Teachers.Count</strong></article><article class="metric-card success"><span class="metric-label">Attendance</span><strong class="metric-value">@Model.AttendancePercentage.ToString("0.0")%</strong></article><article class="metric-card warning"><span class="metric-label">Average score</span><strong class="metric-value">@Model.AverageScore.ToString("0.0")%</strong></article></div>
<div class="row g-3"><div class="col-lg-4"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Subject profile</h2></div></div><div class="detail-grid"><div class="detail-item"><small>Class</small><strong>@item.Class.Name</strong></div><div class="detail-item"><small>Department</small><strong>@(item.Department?.Name??"Unassigned")</strong></div><div class="detail-item"><small>Semester</small><strong>@(item.Semester?.Name??"Unassigned")</strong></div><div class="detail-item"><small>Primary Professor</small><strong>@(item.Teacher?.FullName??"Unassigned")</strong></div></div></section></div><div class="col-lg-8"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Recent performance</h2><p>Latest entered marks</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Exam</th><th>Score</th><th>Grade</th></tr></thead><tbody>@foreach(var m in Model.Marks.Take(15)){<tr><td><a asp-controller="Students" asp-action="Details" asp-route-id="@m.StudentId" asp-fragment="marks" class="record-link">@m.Student.FullName</a></td><td>@m.Exam.Name</td><td>@m.Score/@m.Exam.MaximumMarks</td><td>@m.Grade</td></tr>}</tbody></table></div></section></div></div>
<div class="row g-3 mt-0"><div class="col-lg-6"><section class="card section-card"><div class="section-title-row"><div><h2>Assignments</h2><p>@Model.Assignments.Count records</p></div></div>@foreach(var a in Model.Assignments){<a asp-controller="Assignment" asp-action="Details" asp-route-id="@a.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-list-check"></i></span><span class="activity-copy"><strong>@a.Title</strong><small>Due @a.DueUtc.ToLocalTime().ToString("dd MMM yyyy")</small></span></a>}</section></div><div class="col-lg-6"><section class="card section-card"><div class="section-title-row"><div><h2>Study materials</h2><p>@Model.Materials.Count files</p></div></div>@foreach(var m in Model.Materials){<a asp-controller="StudyMaterials" asp-action="Download" asp-route-id="@m.Id" class="activity-item"><span class="activity-icon"><i class="fa-regular fa-file-lines"></i></span><span class="activity-copy"><strong>@m.Title</strong><small>@m.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</small></span></a>}</section></div></div>
@if(Model.Exams.Count>0){<section class="card section-card mt-3"><div class="section-title-row"><div><h2>Exams</h2><p>Assessments with recorded marks for this subject</p></div></div>@foreach(var exam in Model.Exams){<a asp-controller="Exam" asp-action="Details" asp-route-id="@exam.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-file-pen"></i></span><span class="activity-copy"><strong>@exam.Name</strong><small>@exam.ExamDate.ToString("dd MMM yyyy") · @exam.ExamType</small></span></a>}</section>}
