@model SubjectViewModel
@{ ViewData["Title"] = "Edit subject"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Curriculum</span><h1>Edit subject</h1><p>Update the curriculum placement or primary Teacher.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></div></div>
<div class="card section-card form-card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><div class="row g-3">
<div class="col-12"><label asp-for="Name" class="form-label required">Subject name</label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name"></span></div>
<div class="col-md-6"><label asp-for="DepartmentId" class="form-label">Department</label><select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"><option value="">Select department</option></select><span asp-validation-for="DepartmentId"></span></div>
<div class="col-md-6"><label asp-for="SemesterId" class="form-label">Semester</label><select asp-for="SemesterId" asp-items="Model.Semesters" class="form-select" data-dependent-parent="#DepartmentId" data-dependent-url="/api/lookups/semesters?departmentId={value}" data-placeholder="Select semester"><option value="">Select semester</option></select><span asp-validation-for="SemesterId"></span></div>
<div class="col-md-6"><label asp-for="ClassId" class="form-label required">Class</label><select asp-for="ClassId" asp-items="Model.Classes" class="form-select" required data-dependent-parent="#DepartmentId" data-dependent-url="/api/lookups/classes?departmentId={value}" data-placeholder="Select class"></select><span asp-validation-for="ClassId"></span></div>
<div class="col-md-6"><label asp-for="TeacherId" class="form-label">Primary Teacher</label><select asp-for="TeacherId" asp-items="Model.Teachers" class="form-select"><option value="">Assign later</option></select><span asp-validation-for="TeacherId"></span></div>
</div><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button class="btn btn-primary" type="submit">Save changes</button></div></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
