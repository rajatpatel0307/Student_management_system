@model Section
@{ ViewData["Title"] = $"Edit section {Model.Name}"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Sections / #@Model.Id / Edit</span><h1>Edit section @Model.Name</h1><p>A section with enrolled students cannot be moved to another class.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label required">Section name</label><input asp-for="Name" class="form-control" maxlength="20" required /><span asp-validation-for="Name"></span></div>
<div class="col-md-6"><label asp-for="ClassId" class="form-label required">Class</label><select asp-for="ClassId" asp-items="ViewBag.Classes" class="form-select" required></select><span asp-validation-for="ClassId"></span></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
