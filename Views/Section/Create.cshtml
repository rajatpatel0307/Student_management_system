@model Section
@{ ViewData["Title"] = "Add section"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Academic structure</span><h1>Add section</h1><p>Create a named Student group within an existing class.</p></div><div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></div>
<div class="card section-card form-card"><form asp-action="Create" method="post" novalidate><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="ClassId" class="form-label required">Class</label><select asp-for="ClassId" asp-items="ViewBag.Classes" class="form-select" required><option value="">Select class</option></select><span asp-validation-for="ClassId"></span></div><div class="col-md-6"><label asp-for="Name" class="form-label required">Section name</label><input asp-for="Name" class="form-control" maxlength="20" placeholder="e.g. A" required /><span asp-validation-for="Name"></span></div></div><div class="form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">Create section</button></div></form></div>
