@model Student_Management_System.Models.PagedResult<Section>
@using Student_Management_System.Models
@{ViewData["Title"]="Sections";}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Academic structure",Title="Sections",Description="Manage teaching groups and review their live student enrollment.",PrimaryAction="Create",PrimaryLabel="Add section",PrimaryController="Section"})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-section-index-search-582">Search</label><input id="field-section-index-search-582" name="search" value="@Model.Search" class="form-control" placeholder="Section or class"/></div><div><label class="form-label" for="field-section-index-classid-729">Class</label><select id="field-section-index-classid-729" name="classId" asp-items="ViewBag.Classes" class="form-select"><option value="">All classes</option></select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Items.Count==0){<partial name="_EmptyRecords" model="@(("No sections found","Adjust filters or create a section.","Create","Add section"))"/>}else{<div class="table-responsive"><table class="table" data-enhanced="true"><thead><tr><th>Section</th><th>Class</th><th>Students</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var s in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@s.Id" class="record-link">Section @s.Name</a></td><td><a asp-controller="Classes" asp-action="Details" asp-route-id="@s.ClassId" class="record-link">@s.Class.Name</a></td><td>@s.Class.Students.Count(x=>x.SectionId==s.Id)</td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary"><i class="fa-regular fa-eye"></i> View</a><a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-pen-to-square"></i> Edit</a></div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/>}</section>
