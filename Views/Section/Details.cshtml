@model Student_Management_System.Models.SectionDetailsViewModel
@{ViewData["Title"]=$"Section {Model.Section.Name}";}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Academic structure / Sections</span><h1>Section @Model.Section.Name</h1><p>@Model.Section.Class.Name student group, subjects, timetable and performance.</p></div><div class="page-actions">@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-action="Edit" asp-route-id="@Model.Section.Id" class="btn btn-primary">Edit section</a><a asp-action="Index" asp-route-classId="@Model.Section.ClassId" class="btn btn-outline-secondary">Back</a>}else{<a href="#" data-history-back class="btn btn-outline-secondary">Back</a>}</div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Students</span><strong class="metric-value">@Model.Students.Count</strong></article><article class="metric-card info"><span class="metric-label">Subjects</span><strong class="metric-value">@Model.Subjects.Count</strong></article><article class="metric-card success"><span class="metric-label">Attendance</span><strong class="metric-value">@Model.AttendancePercentage.ToString("0.0")%</strong></article><article class="metric-card warning"><span class="metric-label">Average score</span><strong class="metric-value">@Model.AverageScore.ToString("0.0")%</strong></article></div>
<div class="row g-3"><div class="col-lg-7"><section class="card section-card"><div class="section-title-row"><div><h2>Students</h2></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th></tr></thead><tbody>@foreach(var s in Model.Students){<tr><td><a asp-controller="Students" asp-action="Details" asp-route-id="@s.Id" class="record-link">@s.FullName</a></td><td>@s.Email</td></tr>}</tbody></table></div></section></div><div class="col-lg-5"><section class="card section-card"><div class="section-title-row"><div><h2>Subjects</h2></div></div>@foreach(var s in Model.Subjects){<a asp-controller="Subject" asp-action="Details" asp-route-id="@s.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-book"></i></span><span class="activity-copy"><strong>@s.Name</strong><small>@(s.Teacher?.FullName??"Unassigned")</small></span></a>}</section></div></div>
