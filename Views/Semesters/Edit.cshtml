@model Semester
@{ ViewData["Title"] = $"Edit {Model.Name}"; var departments=ViewBag.Departments as IEnumerable<Department>??Enumerable.Empty<Department>(); var years=ViewBag.Years as IEnumerable<AcademicYear>??Enumerable.Empty<AcademicYear>(); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Semesters / #@Model.Id / Edit</span><h1>Edit @Model.Name</h1><p>Maintain the department and academic-year relationship.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label required"></label><input asp-for="Name" class="form-control" maxlength="50" required /><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="Number" class="form-label required"></label><input asp-for="Number" type="number" min="1" max="12" class="form-control" required /><span asp-validation-for="Number"></span></div>
<div class="col-md-6"><label asp-for="DepartmentId" class="form-label required">Department</label><select asp-for="DepartmentId" class="form-select" required>@foreach(var d in departments){<option value="@d.Id" selected="@(d.Id==Model.DepartmentId?"selected":null)">@d.Name</option>}</select><span asp-validation-for="DepartmentId"></span></div>
<div class="col-md-6"><label asp-for="AcademicYearId" class="form-label required">Academic year</label><select asp-for="AcademicYearId" class="form-select" required>@foreach(var y in years){<option value="@y.Id" selected="@(y.Id==Model.AcademicYearId?"selected":null)">@y.Name</option>}</select><span asp-validation-for="AcademicYearId"></span></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
