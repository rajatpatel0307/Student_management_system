@model Student_Management_System.Models.SemesterDetailsViewModel
@{ViewData["Title"]=Model.Semester.Name;}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Academic calendar / Semesters</span><h1>@Model.Semester.Name</h1><p>@Model.Semester.Department.Name · @Model.Semester.AcademicYear.Name</p></div><div class="page-actions"><a asp-action="Edit" asp-route-id="@Model.Semester.Id" class="btn btn-primary">Edit semester</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Classes</span><strong class="metric-value">@Model.Classes.Count</strong></article><article class="metric-card info"><span class="metric-label">Students</span><strong class="metric-value">@Model.Students.Count</strong></article><article class="metric-card success"><span class="metric-label">Subjects</span><strong class="metric-value">@Model.Subjects.Count</strong></article></div>
<div class="row g-3"><div class="col-lg-6"><section class="card section-card"><h2>Classes</h2>@foreach(var c in Model.Classes){<a asp-controller="Classes" asp-action="Details" asp-route-id="@c.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-school"></i></span><span class="activity-copy"><strong>@c.Name</strong><small>@(c.Teacher?.FullName??"Teacher unassigned")</small></span></a>}</section></div><div class="col-lg-6"><section class="card section-card"><h2>Subjects</h2>@foreach(var s in Model.Subjects){<a asp-controller="Subject" asp-action="Details" asp-route-id="@s.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-book"></i></span><span class="activity-copy"><strong>@s.Name</strong><small>@(s.Teacher?.FullName??"Professor unassigned")</small></span></a>}</section></div></div>
