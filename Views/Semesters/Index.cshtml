@model Student_Management_System.Models.PagedResult<Semester>
@using Student_Management_System.Models
@{ViewData["Title"]="Semesters";var query=ViewContext.HttpContext.Request.Query;}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Academic calendar",Title="Semesters",Description="Review semesters by department and academic year with live related records.",PrimaryAction="Create",PrimaryLabel="Add semester",PrimaryController="Semesters"})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-semesters-index-search-646">Search</label><input id="field-semesters-index-search-646" name="search" value="@Model.Search" class="form-control" placeholder="Semester or department"/></div><div><label class="form-label" for="field-semesters-index-departmentid-799">Department</label><select id="field-semesters-index-departmentid-799" name="departmentId" class="form-select"><option value="">All</option>@foreach(var d in (IEnumerable<Department>)ViewBag.Departments){<option value="@d.Id" selected="@(query["departmentId"]==d.Id.ToString())">@d.Name</option>}</select></div><div><label class="form-label" for="field-semesters-index-academicyearid-1096">Academic year</label><select id="field-semesters-index-academicyearid-1096" name="academicYearId" class="form-select"><option value="">All</option>@foreach(var y in (IEnumerable<AcademicYear>)ViewBag.Years){<option value="@y.Id" selected="@(query["academicYearId"]==y.Id.ToString())">@y.Name</option>}</select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card"><div class="table-responsive"><table class="table" data-enhanced="true"><thead><tr><th>Semester</th><th>Department</th><th>Academic year</th><th>Number</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var s in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@s.Id" class="record-link">@s.Name</a></td><td>@s.Department.Name</td><td>@s.AcademicYear.Name</td><td>@s.Number</td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">View</a><a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a></div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/></section>
