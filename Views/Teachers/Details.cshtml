@model Student_Management_System.Models.TeacherDetailsViewModel
@{ ViewData["Title"] = $"{Model.Teacher.FullName} · Faculty"; var teacher = Model.Teacher; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">People / Faculty / #@teacher.Id</span><h1>Faculty details</h1><p>Profile, academic assignments, timetable and recorded teaching activity.</p></div><div class="page-actions"><button data-print-page class="btn btn-outline-secondary"><i class="fa-solid fa-print"></i> Print</button>@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-action="Edit" asp-route-id="@teacher.Id" class="btn btn-primary">Edit profile</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a>}else{<a href="#" data-history-back class="btn btn-outline-secondary">Back</a>}</div></div>
<section class="card profile-hero mb-3"><span class="avatar avatar-lg">@string.Concat(teacher.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])))</span><div class="profile-copy"><h2>@teacher.FullName</h2><p>@teacher.TeacherType · @(teacher.Department?.Name ?? "Department unassigned")</p><div class="profile-meta"><span><i class="fa-regular fa-envelope"></i> @teacher.Email</span><span><i class="fa-solid fa-phone"></i> @teacher.Phone</span><span><i class="fa-solid fa-award"></i> @teacher.Qualification</span><span><i class="fa-solid fa-right-to-bracket"></i> @(Model.LoginHistory.FirstOrDefault(x=>x.Succeeded)?.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")??"No successful login")</span></div></div><span class="badge @(teacher.User.LockoutEnd>DateTimeOffset.UtcNow?"bg-danger":"bg-success")">@(teacher.User.LockoutEnd>DateTimeOffset.UtcNow?"Inactive account":"Active account")</span></section>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Assigned classes</span><strong class="metric-value">@Model.Classes.Count</strong></article><article class="metric-card info"><span class="metric-label">Assigned subjects</span><strong class="metric-value">@Model.Subjects.Count</strong></article><article class="metric-card success"><span class="metric-label">Students taught</span><strong class="metric-value">@Model.StudentsTaught</strong></article><article class="metric-card warning"><span class="metric-label">Records submitted</span><strong class="metric-value">@(Model.AttendanceEntries + Model.MarksEntered)</strong><span class="metric-note">@Model.AttendanceEntries attendance · @Model.MarksEntered marks</span></article></div>
<div class="row g-3"><div class="col-lg-6"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Teaching assignments</h2><p>Classes and subjects</p></div></div><div class="list-group list-group-flush">@foreach (var item in Model.Classes) { <a asp-controller="Classes" asp-action="Details" asp-route-id="@item.Id" class="list-group-item list-group-item-action"><strong>@item.Name</strong><small class="d-block text-muted">@(item.Department?.Name ?? "No department") · @(item.Semester?.Name ?? "No semester")</small></a> }@foreach (var item in Model.Subjects) { <a asp-controller="Subject" asp-action="Details" asp-route-id="@item.Id" class="list-group-item list-group-item-action"><strong>@item.Name</strong><small class="d-block text-muted">@item.Class.Name</small></a> }</div></section></div><div class="col-lg-6"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Weekly timetable</h2><p>Scheduled periods</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Day</th><th>Time</th><th>Subject</th><th>Class</th></tr></thead><tbody>@foreach (var item in Model.Timetable) { <tr><td>@((DayOfWeek)item.DayOfWeek)</td><td>@item.StartsAt.ToString(@"hh\:mm")</td><td>@item.Subject?.Name</td><td>@item.Class?.Name</td></tr> }</tbody></table></div></section></div></div>
<div class="row g-3 mt-0"><div class="col-lg-6"><section class="card section-card"><div class="section-title-row"><div><h2>Study materials</h2><p>@Model.Materials.Count uploaded files</p></div></div>@foreach (var item in Model.Materials.Take(8)) { <a asp-controller="StudyMaterials" asp-action="Download" asp-route-id="@item.Id" class="activity-item"><span class="activity-icon"><i class="fa-regular fa-file-lines"></i></span><span class="activity-copy"><strong>@item.Title</strong><small>@item.Subject.Name · @item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</small></span></a> }</section></div><div class="col-lg-6"><section class="card section-card"><div class="section-title-row"><div><h2>Assignments created</h2><p>@Model.Assignments.Count total assignments</p></div></div>@foreach (var item in Model.Assignments.Take(8)) { <a asp-controller="Assignment" asp-action="Details" asp-route-id="@item.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-list-check"></i></span><span class="activity-copy"><strong>@item.Title</strong><small>@item.Subject?.Name · due @item.DueUtc.ToLocalTime().ToString("dd MMM")</small></span></a> }</section></div></div>
