@model Student_Management_System.Models.PagedResult<Teacher>
@using Student_Management_System.Models
@{ ViewData["Title"] = "Faculty"; var query = ViewContext.HttpContext.Request.Query; }
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel { Eyebrow="People", Title="Faculty", Description="Manage HOD and Professor accounts, departments and academic assignments using current database records.", PrimaryAction="Create", PrimaryLabel="Add faculty", PrimaryController="Teachers", ExportAction="Export", ExportController="Teachers" })" />
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)" />
<form method="get" class="card filter-panel"><div class="filter-panel-grid">
    <div><label class="form-label" for="field-teachers-index-search-730">Search faculty</label><input id="field-teachers-index-search-730" name="search" value="@Model.Search" class="form-control" placeholder="Name, email or phone" /></div>
    <div><label class="form-label" for="field-teachers-index-departmentid-895">Department</label><select id="field-teachers-index-departmentid-895" name="departmentId" class="form-select"><option value="">All departments</option>@foreach (var d in (IEnumerable<Department>)ViewBag.Departments) { <option value="@d.Id" selected="@(query["departmentId"] == d.Id.ToString())">@d.Name</option> }</select></div>
    <div><label class="form-label" for="field-teachers-index-status-1215">Teacher type</label><select id="field-teachers-index-status-1215" name="status" class="form-select"><option value="">All faculty</option><option value="hod" selected="@(query["status"] == "hod")">HOD</option><option value="professor" selected="@(query["status"] == "professor")">Professor</option><option value="unassigned" selected="@(query["status"] == "unassigned")">Unassigned</option></select></div>
    <div><label class="form-label" for="field-teachers-index-pagesize-1617">Rows</label><select id="field-teachers-index-pagesize-1617" name="pageSize" class="form-select"><option value="10">10</option><option value="20" selected="@(Model.PageSize == 20)">20</option><option value="50" selected="@(Model.PageSize == 50)">50</option></select></div>
    <div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div>
</div></form>
<section class="card table-card">
@if (Model.Items.Count == 0) { <partial name="_EmptyRecords" model="@(("No faculty found", "Adjust the filters or create a faculty account.", "Create", "Add faculty"))" /> }
else { <div class="table-responsive"><table class="table table-hover" data-enhanced="true"><thead><tr><th>Faculty member</th><th>Role</th><th>Department</th><th>Assignments</th><th>Qualification</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var item in Model.Items) {
<tr><td><div class="attendance-person"><span class="avatar avatar-sm">@string.Concat(item.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])))</span><span class="activity-copy"><a asp-action="Details" asp-route-id="@item.Id" class="record-link">@item.FullName</a><small>@item.Email · @item.Phone</small></span></div></td><td><span class="badge @(item.TeacherType == TeacherType.HOD ? "bg-info" : "bg-primary")">@item.TeacherType</span></td><td><a asp-controller="Departments" asp-action="Details" asp-route-id="@item.DepartmentId" class="record-link">@(item.Department?.Name ?? "Unassigned")</a></td><td>@item.ClassAssignments.Count classes<small class="d-block text-muted">@item.SubjectAssignments.Count subjects</small></td><td>@(string.IsNullOrWhiteSpace(item.Qualification) ? "Not provided" : item.Qualification)</td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View"><i class="fa-regular fa-eye"></i></a><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a><form asp-action="Delete" asp-route-id="@item.Id" method="post"><input type="hidden" name="reason" value="Archived from faculty management" /><button class="btn btn-sm btn-danger" data-confirm="Archive @item.FullName and revoke login access?" title="Archive"><i class="fa-solid fa-box-archive"></i></button></form></div></td></tr> }
</tbody></table></div><partial name="_ServerPagination" model="Model" /> }
</section>
