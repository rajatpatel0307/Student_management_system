@model Student_Management_System.Models.PagedResult<Student_Management_System.Models.CommunicationMessage>
@{
    ViewData["Title"] = "Communication center";
    var canSend = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
    var query = ViewContext.HttpContext.Request.Query;
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Campus engagement</span><h1>Communication center</h1><p>Scheduled, targeted, and auditable in-app, email, and SMS delivery.</p></div>@if(canSend){<div class="page-actions"><a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> Compose</a></div>}</div>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-communications-index-search-730">Search</label><input id="field-communications-index-search-730" name="search" value="@Model.Search" class="form-control" placeholder="Title or message" /></div><div><label class="form-label" for="field-communications-index-status-878">Status</label><select id="field-communications-index-status-878" name="status" class="form-select"><option value="">All</option>@foreach(var status in Enum.GetValues<CommunicationStatus>()){<option selected="@(query["status"] == status.ToString())">@status</option>}</select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">
@if(Model.Items.Count == 0){<div class="empty-state"><span class="empty-state-icon"><i class="fa-regular fa-message"></i></span><h2>No communications</h2><p>Messages available to your account appear here.</p></div>}
else{<div class="table-responsive"><table class="table"><thead><tr><th>Message</th><th>Priority</th><th>Status</th><th>Delivery</th><th>Scheduled</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@item.Id" class="record-link">@item.Title</a><small class="d-block text-muted">@item.Body[..Math.Min(item.Body.Length, 100)]</small></td><td>@item.Priority</td><td><span class="badge bg-info">@item.Status</span></td><td>@item.Deliveries.Count(d => d.Status == DeliveryStatus.Delivered) / @item.Deliveries.Count</td><td>@(item.ScheduledUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "Immediate")</td></tr>}</tbody></table></div><partial name="_Pagination" model="Model" />}
</section>
