@model IReadOnlyList<Student_Management_System.Models.ApprovalRequest>
@using Student_Management_System.Models
@{ ViewData["Title"] = "Approvals"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Workflows</span><h1>Approval requests</h1><p>Review requests assigned to your account or role.</p></div><div class="page-actions"><a asp-action="Create" class="btn btn-primary">New request</a></div></div>
<section class="card table-card"><div class="table-responsive"><table class="table"><thead><tr><th>Workflow</th><th>Entity</th><th>Status</th><th>Created</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.WorkflowType</td><td>@item.EntityType · @item.EntityId</td><td><span class="badge bg-info">@item.Status</span></td><td>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@if(item.Status==ApprovalStatus.Pending){<form asp-action="Act" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@item.Id" /><input name="comment" aria-label="Approval review comment" class="form-control form-control-sm" placeholder="Comment" /><button name="decision" value="@ApprovalStatus.Approved" class="btn btn-sm btn-success">Approve</button><button name="decision" value="@ApprovalStatus.Rejected" class="btn btn-sm btn-danger">Reject</button></form>}</td></tr>}</tbody></table></div></section>
