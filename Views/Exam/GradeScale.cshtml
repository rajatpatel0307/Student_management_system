@model IReadOnlyList<Student_Management_System.Models.GradeBoundary>
@using Student_Management_System.Models
@{
    ViewData["Title"] = "Grade scale";
    var departments = ViewBag.Departments as IEnumerable<Department> ?? [];
    int? selectedDepartment = ViewBag.DepartmentId as int?;
}
<div class="page-header">
    <div class="page-header-copy">
        <span class="eyebrow">Exams / Configuration</span>
        <h1>Grade boundaries</h1>
        <p>Configure a global scale or a department-specific override. Overlapping active ranges are rejected.</p>
    </div>
    <div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Back to exams</a></div>
</div>
<section class="card section-card mb-3">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="departmentId">Scale</label>
            <select id="departmentId" name="departmentId" class="form-select">
                <option value="">Global default</option>
                @foreach (var department in departments)
                {
                    <option value="@department.Id" selected="@(selectedDepartment == department.Id)">
                        @department.Name
                    </option>
                }
            </select>
        </div>
        <div class="col-md-4"><button class="btn btn-outline-primary w-100">Load scale</button></div>
    </form>
</section>
<section class="card section-card mb-3">
    <div class="section-title-row"><div><h2>Add boundary</h2><p>Percentages are inclusive.</p></div></div>
    <form asp-action="SaveGradeBoundary" method="post" class="row g-3 align-items-end">
        <input type="hidden" name="DepartmentId" value="@selectedDepartment" />
        <div class="col-md-4"><label class="form-label" for="grade">Grade</label><input id="grade" name="Grade" class="form-control" maxlength="20" required /></div>
        <div class="col-md-3"><label class="form-label" for="minimum">Minimum %</label><input id="minimum" name="MinimumPercent" type="number" min="0" max="100" step="0.01" class="form-control" required /></div>
        <div class="col-md-3"><label class="form-label" for="maximum">Maximum %</label><input id="maximum" name="MaximumPercent" type="number" min="0" max="100" step="0.01" class="form-control" required /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Add</button></div>
    </form>
</section>
<section class="card table-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>No custom boundaries</h2><p>The built-in scale remains active until boundaries are added.</p></div>
    }
    else
    {
        <div class="table-responsive"><table class="table"><thead><tr><th>Grade</th><th>Range</th><th>Status</th><th class="text-end">Action</th></tr></thead><tbody>
        @foreach (var boundary in Model)
        {
            <tr><td><strong>@boundary.Grade</strong></td><td>@boundary.MinimumPercent.ToString("0.##")%–@boundary.MaximumPercent.ToString("0.##")%</td><td><span class="badge @(boundary.IsActive ? "bg-success" : "bg-secondary")">@(boundary.IsActive ? "Active" : "Inactive")</span></td><td class="text-end">@if(boundary.IsActive){<form asp-action="DeactivateGradeBoundary" method="post"><input type="hidden" name="id" value="@boundary.Id"/><button class="btn btn-sm btn-outline-danger" data-confirm="Deactivate this grade boundary?">Deactivate</button></form>}</td></tr>
        }
        </tbody></table></div>
    }
</section>
