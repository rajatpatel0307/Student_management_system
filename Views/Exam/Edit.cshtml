@model ExamEditInputModel
@{ ViewData["Title"] = $"Edit {Model.Name}"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Exams / #@Model.Id / Edit</span><h1>Edit @Model.Name</h1><p>Update scheduling and publication controls. Published marks remain protected by backend rules.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label required"></label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="ExamType" class="form-label required">Exam type</label><input asp-for="ExamType" class="form-control" maxlength="50" required /><span asp-validation-for="ExamType"></span></div>
<div class="col-md-6"><label asp-for="ExamDate" class="form-label required">Exam date</label><input asp-for="ExamDate" type="date" class="form-control" required /><span asp-validation-for="ExamDate"></span></div>
<div class="col-md-3"><label asp-for="MaximumMarks" class="form-label">Maximum marks</label><input asp-for="MaximumMarks" class="form-control" min="0.01" step="0.01"/><span asp-validation-for="MaximumMarks"></span></div><div class="col-md-3"><label asp-for="PassMarks" class="form-label">Pass marks</label><input asp-for="PassMarks" class="form-control" min="0" step="0.01"/><span asp-validation-for="PassMarks"></span></div><div class="col-md-3"><label asp-for="WeightPercent" class="form-label">Weight %</label><input asp-for="WeightPercent" class="form-control" min="0" max="100" step="0.01"/><span asp-validation-for="WeightPercent"></span></div><div class="col-md-3"><label class="form-label" for="examLifecycle">Lifecycle</label><input id="examLifecycle" value="@Model.CurrentStatus" class="form-control" readonly aria-readonly="true" /></div>
<div class="col-md-4"><label asp-for="EntryOpensUtc" class="form-label">Entry opens</label><input asp-for="EntryOpensUtc" type="datetime-local" class="form-control" /></div><div class="col-md-4"><label asp-for="EntryClosesUtc" class="form-label">Entry closes</label><input asp-for="EntryClosesUtc" type="datetime-local" class="form-control" /><span asp-validation-for="EntryClosesUtc"></span></div><div class="col-md-4"><label asp-for="PublicationScheduledUtc" class="form-label">Publication scheduled</label><input asp-for="PublicationScheduledUtc" type="datetime-local" class="form-control" /><span asp-validation-for="PublicationScheduledUtc"></span></div><div class="col-12 form-check ms-2"><input asp-for="IsSupplementary" class="form-check-input" /><label asp-for="IsSupplementary" class="form-check-label">Supplementary exam</label></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary" data-confirm="Save exam schedule and publication changes?">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
