@{
    ViewData["Title"] = "Academic structure";
    var institutions = ViewBag.Institutions as IReadOnlyList<Institution> ?? [];
    var campuses = ViewBag.Campuses as IReadOnlyList<Campus> ?? [];
    var programTypes = ViewBag.ProgramTypes as IReadOnlyList<ProgramType> ?? [];
    var subjectTypes = ViewBag.SubjectTypes as IReadOnlyList<AcademicSubjectType> ?? [];
    var sessions = ViewBag.Sessions as IReadOnlyList<AcademicSession> ?? [];
    var curricula = ViewBag.Curricula as IReadOnlyList<Curriculum> ?? [];
    var events = ViewBag.Events as IReadOnlyList<AcademicCalendarEvent> ?? [];
    var rooms = ViewBag.Rooms as IReadOnlyList<Room> ?? [];
    var years = ViewBag.Years as IReadOnlyList<AcademicYear> ?? [];
    var programs = ViewBag.Programs as IReadOnlyList<AcademicProgram> ?? [];
    var subjects = ViewBag.Subjects as IReadOnlyList<Subject> ?? [];
    var departments = ViewBag.Departments as IReadOnlyList<Department> ?? [];
    var memberships = ViewBag.CampusMemberships as IReadOnlyList<UserCampusMembership> ?? [];
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Institution configuration</span><h1>Academic structure</h1><p>Normalized institution, campus, session, curriculum, calendar, and room records.</p></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Institutions</span><strong class="metric-value">@institutions.Count</strong></article><article class="metric-card info"><span class="metric-label">Campuses</span><strong class="metric-value">@campuses.Count</strong></article><article class="metric-card success"><span class="metric-label">Academic sessions</span><strong class="metric-value">@sessions.Count</strong></article><article class="metric-card warning"><span class="metric-label">Curricula</span><strong class="metric-value">@curricula.Count</strong></article></div>
<nav class="details-tabs mb-3" aria-label="Academic structure sections"><a href="#institutions">Institutions</a><a href="#campuses">Campuses</a><a href="#sessions">Sessions</a><a href="#lookups">Types</a><a href="#curricula">Curricula</a><a href="#calendar">Calendar</a><a href="#rooms">Rooms</a></nav>
<div class="row g-3">
@if (User.IsInRole("SuperAdmin"))
{
<div class="col-12" id="campus-access"><section class="card section-card"><div class="section-title-row"><div><h2>Campus access</h2><p>Explicit institution isolation for privileged and operational accounts.</p></div></div><form asp-action="AssignCampus" method="post"><div class="row g-2"><div class="col-md-5"><label class="form-label" for="field-academicstructure-index-userid-2567">Account</label><select id="field-academicstructure-index-userid-2567" name="userId" class="form-select" required><option value="">Select account</option>@foreach(dynamic user in ViewBag.CampusUsers ?? Array.Empty<object>()){<option value="@user.Id">@user.FullName · @user.Email</option>}</select></div><div class="col-md-5"><label class="form-label" for="field-academicstructure-index-campusid-2870">Campus</label><select id="field-academicstructure-index-campusid-2870" name="campusId" class="form-select" required><option value="">Select campus</option>@foreach(var campus in campuses.Where(c=>c.IsActive)){<option value="@campus.Id">@(campus.Institution?.Name ?? "Unassigned institution") · @campus.Name</option>}</select></div><div class="col-md-2 d-flex align-items-end"><label class="form-check"><input name="isDefault" value="true" type="checkbox" class="form-check-input"/><span class="form-check-label">Default</span></label></div></div><div class="form-actions"><button class="btn btn-primary">Assign campus</button></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Account</th><th>Campus</th><th>Default</th></tr></thead><tbody>@foreach(var membership in memberships){<tr><td>@(membership.User?.FullName ?? "Unknown account")</td><td>@(membership.Campus?.Name ?? "Unknown campus")</td><td>@(membership.IsDefault ? "Yes" : "No")</td></tr>}</tbody></table></div></section></div>
}
<div class="col-xl-6" id="institutions"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Institutions</h2><p>Root education organizations and display time zone.</p></div></div><form asp-action="SaveInstitution" method="post"><div class="row g-2"><div class="col-md-8"><label class="form-label" for="field-academicstructure-index-name-4166">Name</label><input id="field-academicstructure-index-name-4166" name="Name" class="form-control" required maxlength="180" /></div><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-code-4299">Code</label><input id="field-academicstructure-index-code-4299" name="Code" class="form-control" required maxlength="30" /></div><div class="col-12"><label class="form-label" for="field-academicstructure-index-address-4429">Address</label><input id="field-academicstructure-index-address-4429" name="Address" class="form-control" maxlength="500" /></div><div class="col-md-6"><label class="form-label" for="field-academicstructure-index-email-4559">Email</label><input id="field-academicstructure-index-email-4559" name="Email" type="email" class="form-control" /></div><div class="col-md-6"><label class="form-label" for="field-academicstructure-index-phone-4682">Phone</label><input id="field-academicstructure-index-phone-4682" name="Phone" class="form-control" /></div><div class="col-12"><label class="form-label" for="field-academicstructure-index-timezoneid-4790">Time zone</label><input id="field-academicstructure-index-timezoneid-4790" name="TimeZoneId" class="form-control" value="Asia/Kolkata" required /></div></div><div class="form-actions"><button class="btn btn-primary">Create institution</button></div></form><div class="activity-list">@foreach(var item in institutions){<div class="activity-item"><span class="activity-icon"><i class="fa-solid fa-building-columns"></i></span><span class="activity-copy"><strong>@item.Name</strong><small>@item.Code · @item.TimeZoneId</small></span></div>}</div></section></div>
<div class="col-xl-6" id="campuses"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Campuses</h2><p>Physical or administrative campuses.</p></div></div><form asp-action="SaveCampus" method="post"><div class="row g-2"><div class="col-12"><label class="form-label" for="field-academicstructure-index-institutionid-5595">Institution</label><select id="field-academicstructure-index-institutionid-5595" name="InstitutionId" class="form-select" required><option value="">Select institution</option>@foreach(var item in institutions.Where(i=>i.IsActive)){<option value="@item.Id">@item.Name</option>}</select></div><div class="col-md-8"><label class="form-label" for="field-academicstructure-index-name-5880">Name</label><input id="field-academicstructure-index-name-5880" name="Name" class="form-control" required /></div><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-code-5997">Code</label><input id="field-academicstructure-index-code-5997" name="Code" class="form-control" required /></div><div class="col-12"><label class="form-label" for="field-academicstructure-index-address-6112">Address</label><input id="field-academicstructure-index-address-6112" name="Address" class="form-control" /></div></div><div class="form-actions"><button class="btn btn-primary">Create campus</button></div></form><div class="activity-list">@foreach(var item in campuses){<div class="activity-item"><span class="activity-icon"><i class="fa-solid fa-location-dot"></i></span><span class="activity-copy"><strong>@item.Name</strong><small>@(item.Institution?.Name ?? "Unassigned institution") · @item.Code</small></span></div>}</div></section></div>
<div class="col-xl-7" id="sessions"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Academic sessions</h2><p>Non-overlapping operational academic periods.</p></div></div><form asp-action="SaveSession" method="post"><div class="row g-2"><div class="col-md-6"><label class="form-label" for="field-academicstructure-index-name-6927">Name</label><input id="field-academicstructure-index-name-6927" name="Name" class="form-control" required /></div><div class="col-md-6"><label class="form-label" for="field-academicstructure-index-academicyearid-7044">Legacy academic year link</label><select id="field-academicstructure-index-academicyearid-7044" name="AcademicYearId" class="form-select"><option value="">None</option>@foreach(var year in years){<option value="@year.Id">@year.Name</option>}</select></div><div class="col-md-5"><label class="form-label" for="field-academicstructure-index-startson-7293">Starts</label><input id="field-academicstructure-index-startson-7293" name="StartsOn" type="date" class="form-control" required /></div><div class="col-md-5"><label class="form-label" for="field-academicstructure-index-endson-7428">Ends</label><input id="field-academicstructure-index-endson-7428" name="EndsOn" type="date" class="form-control" required /></div><div class="col-md-2 d-flex align-items-end"><label class="form-check"><input name="IsCurrent" value="true" type="checkbox" class="form-check-input" /><span class="form-check-label">Current</span></label></div></div><div class="form-actions"><button class="btn btn-primary">Create session</button></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Session</th><th>Period</th><th>Status</th></tr></thead><tbody>@foreach(var item in sessions){<tr><td>@item.Name</td><td>@item.StartsOn.ToString("dd MMM yyyy") – @item.EndsOn.ToString("dd MMM yyyy")</td><td><span class="badge @(item.IsCurrent?"bg-success":"bg-info")">@(item.IsCurrent?"Current":item.IsClosed?"Closed":"Open")</span></td></tr>}</tbody></table></div></section></div>
<div class="col-xl-5" id="lookups"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Academic types</h2><p>School and college terminology without hardcoding.</p></div></div><form asp-action="CreateLookup" method="post" class="mb-3"><input type="hidden" name="lookupType" value="ProgramType" /><label class="form-label">Program type</label><div class="input-group"><input name="name" aria-label="Program type name" class="form-control" placeholder="Undergraduate, School level…" required /><button class="btn btn-primary">Add</button></div><label class="form-check mt-2"><input name="option" value="true" type="checkbox" class="form-check-input" /><span class="form-check-label">Uses credits</span></label></form><div class="d-flex flex-wrap gap-2 mb-3">@foreach(var item in programTypes){<span class="badge bg-info">@item.Name</span>}</div><form asp-action="CreateLookup" method="post"><input type="hidden" name="lookupType" value="SubjectType" /><label class="form-label">Subject type</label><div class="input-group"><input name="name" aria-label="Subject type name" class="form-control" placeholder="Theory, practical, elective…" required /><button class="btn btn-primary">Add</button></div><label class="form-check mt-2"><input name="option" value="true" type="checkbox" class="form-check-input" /><span class="form-check-label">Practical type</span></label></form><div class="d-flex flex-wrap gap-2 mt-3">@foreach(var item in subjectTypes){<span class="badge bg-info">@item.Name</span>}</div></section></div>
<div class="col-12" id="curricula"><section class="card section-card"><div class="section-title-row"><div><h2>Curriculum versions</h2><p>Versioned subject definitions tied to a program and effective session.</p></div></div><form asp-action="CreateCurriculum" method="post"><div class="row g-2"><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-academicprogramid-10092">Program</label><select id="field-academicstructure-index-academicprogramid-10092" name="AcademicProgramId" class="form-select" required><option value="">Select program</option>@foreach(var item in programs){<option value="@item.Id">@item.Name</option>}</select></div><div class="col-md-3"><label class="form-label" for="field-academicstructure-index-name-10348">Curriculum name</label><input id="field-academicstructure-index-name-10348" name="Name" class="form-control" required /></div><div class="col-md-2"><label class="form-label" for="field-academicstructure-index-version-10476">Version</label><input id="field-academicstructure-index-version-10476" name="Version" class="form-control" placeholder="2026.1" required /></div><div class="col-md-3"><label class="form-label" for="field-academicstructure-index-effectiveacademicsessionid-10620">Effective session</label><select id="field-academicstructure-index-effectiveacademicsessionid-10620" name="EffectiveAcademicSessionId" class="form-select" required><option value="">Select session</option>@foreach(var item in sessions.Where(s=>!s.IsClosed)){<option value="@item.Id">@item.Name</option>}</select></div><div class="col-12"><label class="form-label" for="field-academicstructure-index-subjectids-10915">Subjects</label><select id="field-academicstructure-index-subjectids-10915" name="SubjectIds" class="form-select" multiple size="7" required>@foreach(var item in subjects){<option value="@item.Id">@item.Name · @(item.Class?.Name ?? "Unassigned class")</option>}</select><div class="form-text">Hold Ctrl or Command to select multiple subjects.</div></div></div><div class="form-actions"><button class="btn btn-primary">Create curriculum version</button></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Curriculum</th><th>Program</th><th>Versions</th></tr></thead><tbody>@foreach(var item in curricula){<tr><td>@item.Name</td><td>@(item.AcademicProgram?.Name ?? "Unassigned program")</td><td>@string.Join(", ", (item.Versions ?? []).OrderByDescending(v=>v.Id).Select(v=>v.Version))</td></tr>}</tbody></table></div></section></div>
<div class="col-xl-7" id="calendar"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Academic calendar</h2><p>Published events, holidays, examinations, and activities.</p></div></div><form asp-action="CreateEvent" method="post"><div class="row g-2"><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-academicsessionid-12051">Session</label><select id="field-academicstructure-index-academicsessionid-12051" name="AcademicSessionId" class="form-select" required>@foreach(var item in sessions){<option value="@item.Id">@item.Name</option>}</select></div><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-title-12267">Title</label><input id="field-academicstructure-index-title-12267" name="Title" class="form-control" required /></div><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-kind-12386">Type</label><select id="field-academicstructure-index-kind-12386" name="Kind" class="form-select">@foreach(var kind in Enum.GetValues<AcademicEventKind>()){<option>@kind</option>}</select></div><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-startslocal-12582">Starts</label><input id="field-academicstructure-index-startslocal-12582" name="StartsLocal" type="datetime-local" class="form-control" required /></div><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-endslocal-12730">Ends</label><input id="field-academicstructure-index-endslocal-12730" name="EndsLocal" type="datetime-local" class="form-control" required /></div><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-departmentid-12874">Department</label><select id="field-academicstructure-index-departmentid-12874" name="DepartmentId" class="form-select"><option value="">Institution-wide</option>@foreach(var d in departments){<option value="@d.Id">@d.Name</option>}</select></div><div class="col-12"><label class="form-label" for="field-academicstructure-index-description-13113">Description</label><textarea id="field-academicstructure-index-description-13113" name="Description" class="form-control" maxlength="1000"></textarea></div><div class="col-12"><label class="form-check"><input name="IsPublished" value="true" type="checkbox" class="form-check-input" /><span class="form-check-label">Publish immediately</span></label></div></div><div class="form-actions"><button class="btn btn-primary">Create event</button></div></form><div class="activity-list">@foreach(var item in events.Take(10)){<div class="activity-item"><span class="activity-icon"><i class="fa-regular fa-calendar"></i></span><span class="activity-copy"><strong>@item.Title</strong><small>@(item.AcademicSession?.Name ?? "Unassigned session") · @item.StartsUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small></span><span class="badge bg-info">@item.Kind</span></div>}</div></section></div>
<div class="col-xl-5" id="rooms"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Rooms</h2><p>Conflict-checked timetable locations.</p></div></div><form asp-action="CreateRoom" method="post"><div class="row g-2"><div class="col-12"><label class="form-label" for="field-academicstructure-index-campusid-14237">Campus</label><select id="field-academicstructure-index-campusid-14237" name="campusId" class="form-select"><option value="">Unassigned</option>@foreach(var item in campuses){<option value="@item.Id">@item.Name</option>}</select></div><div class="col-md-4"><label class="form-label" for="field-academicstructure-index-code-14470">Code</label><input id="field-academicstructure-index-code-14470" name="code" class="form-control" required /></div><div class="col-md-5"><label class="form-label" for="field-academicstructure-index-name-14587">Name</label><input id="field-academicstructure-index-name-14587" name="name" class="form-control" required /></div><div class="col-md-3"><label class="form-label" for="field-academicstructure-index-capacity-14704">Capacity</label><input id="field-academicstructure-index-capacity-14704" name="capacity" type="number" min="1" class="form-control" required /></div></div><div class="form-actions"><button class="btn btn-primary">Create room</button></div></form><div class="activity-list">@foreach(var item in rooms){<div class="activity-item"><span class="activity-icon"><i class="fa-solid fa-door-open"></i></span><span class="activity-copy"><strong>@item.Name</strong><small>@item.Code · @item.Capacity seats · @(item.Campus?.Name??"No campus")</small></span></div>}</div></section></div>
</div>
