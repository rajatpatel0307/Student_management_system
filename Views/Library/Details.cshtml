@model Student_Management_System.Models.LibraryBook
@{ ViewData["Title"]=Model.Title;var canManage=User.IsInRole("SuperAdmin")||User.IsInRole("Admin")||User.IsInRole("Librarian"); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Library / Catalog</span><h1>@Model.Title</h1><p>@Model.Author · @(Model.Category??"Uncategorized")</p></div><div class="page-actions">@if(Model.Copies.All(c=>!c.IsAvailable)&&!canManage){<form asp-action="Reserve" method="post"><input type="hidden" name="bookId" value="@Model.Id"/><button class="btn btn-primary">Reserve title</button></form>}<a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Copies</span><strong class="metric-value">@Model.Copies.Count</strong></article><article class="metric-card success"><span class="metric-label">Available</span><strong class="metric-value">@Model.Copies.Count(c=>c.IsAvailable)</strong></article><article class="metric-card warning"><span class="metric-label">Issued</span><strong class="metric-value">@Model.Copies.Count(c=>!c.IsAvailable)</strong></article></div>
<section class="card table-card"><div class="table-responsive"><table class="table"><thead><tr><th>Barcode</th><th>Shelf</th><th>Status</th>@if(canManage){<th class="text-end">Circulation</th>}</tr></thead><tbody>@foreach(var copy in Model.Copies){var active=copy.Loans.FirstOrDefault(l=>!l.ReturnedUtc.HasValue);<tr><td>@copy.Barcode</td><td>@(copy.ShelfLocation??"—")</td><td><span class="badge @(copy.IsAvailable?"bg-success":"bg-warning")">@(copy.IsAvailable?"Available":"Issued")</span></td>@if(canManage){<td class="text-end">@if(copy.IsAvailable){<form asp-action="Issue" method="post" class="d-flex gap-2 justify-content-end flex-wrap"><input type="hidden" name="copyId" value="@copy.Id" /><input name="borrowerEmail" aria-label="Borrower email" type="email" class="form-control form-control-sm" placeholder="Borrower email" required style="max-width:220px" /><input name="dueDate" aria-label="Loan due date" type="date" class="form-control form-control-sm" required value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" style="max-width:150px" /><button class="btn btn-sm btn-primary">Issue</button></form>}else if(active!=null){<form asp-action="Return" method="post"><input type="hidden" name="loanId" value="@active.Id" /><button class="btn btn-sm btn-success" data-confirm="Return this copy and calculate any overdue fine?">Return</button></form>}</td>}</tr>}</tbody></table></div></section>
