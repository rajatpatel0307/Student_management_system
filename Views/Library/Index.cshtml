@model IReadOnlyList<Student_Management_System.Models.LibraryBook>
@{ ViewData["Title"]="Library catalog"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Campus library</span><h1>Library catalog</h1><p>Search titles, inspect live availability, and manage circulation.</p></div><div class="page-actions">@if(User.IsInRole("SuperAdmin")||User.IsInRole("Admin")||User.IsInRole("Librarian")){<a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-book-medical"></i> Add title</a>}<a asp-action="MyLoans" class="btn btn-outline-secondary">My loans</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Titles</span><strong class="metric-value">@Model.Count</strong></article><article class="metric-card success"><span class="metric-label">Available copies</span><strong class="metric-value">@ViewBag.Available</strong></article><article class="metric-card warning"><span class="metric-label">Issued copies</span><strong class="metric-value">@ViewBag.Issued</strong></article></div>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-library-index-search-1152">Search catalog</label><input id="field-library-index-search-1152" class="form-control" name="search" value="@ViewBag.Search" placeholder="Title, author, or ISBN" /></div><div><label class="form-label">Availability</label><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" name="availableOnly" value="true" checked="@(ViewBag.AvailableOnly==true)" /><label class="form-check-label">Available only</label></div></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Count==0){<partial name="_EmptyRecords" model="@(("No books found","Adjust the filters or add a catalog title.","Create","Add title"))" />}else{<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Title</th><th>Author</th><th>Category</th><th>ISBN</th><th>Copies</th><th>Available</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a asp-action="Details" asp-route-id="@item.Id" class="record-link">@item.Title</a></td><td>@item.Author</td><td>@(item.Category??"—")</td><td>@(item.Isbn??"—")</td><td>@item.Copies.Count</td><td><span class="badge @(item.Copies.Any(c=>c.IsAvailable)?"bg-success":"bg-warning")">@item.Copies.Count(c=>c.IsAvailable)</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a></td></tr>}</tbody></table></div>}</section>
