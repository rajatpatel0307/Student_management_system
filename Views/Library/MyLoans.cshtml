@model IReadOnlyList<Student_Management_System.Models.LibraryLoan>
@{ ViewData["Title"]="My library loans"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Library</span><h1>My loans</h1><p>Your current and historical borrowing activity.</p></div><div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Catalog</a></div></div>
<section class="card table-card">@if(Model.Count==0){<div class="empty-state"><span class="empty-state-icon"><i class="fa-solid fa-book"></i></span><h3>No loan history</h3><p>Issued books will appear here.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Book</th><th>Barcode</th><th>Issued</th><th>Due</th><th>Status</th><th>Fine</th><th class="text-end">Action</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a asp-action="Details" asp-route-id="@item.LibraryBookCopy.LibraryBookId" class="record-link">@item.LibraryBookCopy.LibraryBook.Title</a></td><td>@item.LibraryBookCopy.Barcode</td><td>@item.IssuedUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@item.DueUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge @(item.ReturnedUtc.HasValue?"bg-secondary":item.DueUtc<DateTime.UtcNow?"bg-danger":"bg-success")">@(item.ReturnedUtc.HasValue?"Returned":item.DueUtc<DateTime.UtcNow?"Overdue":"Active")</span></td><td>@item.FineAmount.ToString("C")</td><td class="text-end">@if(!item.ReturnedUtc.HasValue&&item.DueUtc>=DateTime.UtcNow&&item.RenewalCount<2){<form asp-action="RenewMyLoan" method="post"><input type="hidden" name="loanId" value="@item.Id"/><button class="btn btn-sm btn-outline-primary" data-confirm="Renew this loan for 14 days?">Renew</button></form>}</td></tr>}</tbody></table></div>}</section>
