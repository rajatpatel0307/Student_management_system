@model Fee
@{ ViewData["Title"]=$"{Model.Term} fee"; var payments=ViewBag.Payments as IEnumerable<FinancialTransaction>??Enumerable.Empty<FinancialTransaction>(); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Fees / #@Model.Id</span><h1>@Model.Term fee</h1><p>@Model.Class?.Name · Due @Model.DueDate.ToString("dd MMMM yyyy")</p></div><div class="page-actions">@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")||User.IsInRole("Accountant")){<a asp-controller="Finance" asp-action="Collect" class="btn btn-outline-secondary"><i class="fa-solid fa-cash-register"></i> Collect payment</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit fee</a>}<a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Scheduled</span><strong class="metric-value">@Model.Amount.ToString("C")</strong></article><article class="metric-card success"><span class="metric-label">Net paid</span><strong class="metric-value">@payments.Sum(p=>p.Amount).ToString("C")</strong></article><article class="metric-card info"><span class="metric-label">Ledger entries</span><strong class="metric-value">@payments.Count()</strong></article></div>
@if(!User.IsInRole("Student")){<section class="card table-card"><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Type</th><th>Amount</th><th>Receipt</th><th>Date</th></tr></thead><tbody>@foreach(var p in payments){<tr><td><a asp-controller="Students" asp-action="Details" asp-route-id="@p.StudentId">@p.Student?.FullName</a></td><td>@p.Type</td><td>@p.Amount.ToString("C")</td><td>@p.ReceiptNumber</td><td>@p.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div></section>}
