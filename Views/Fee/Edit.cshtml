@model Fee
@{ ViewData["Title"]=$"Edit {Model.Term} fee"; var classes=ViewBag.Classes as IEnumerable<Class>??Enumerable.Empty<Class>(); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Fees / #@Model.Id / Edit</span><h1>Edit fee schedule</h1><p>Existing payment history is preserved.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-md-6"><label asp-for="ClassId" class="form-label required">Class</label><select asp-for="ClassId" class="form-select" required>@foreach(var c in classes){<option value="@c.Id" selected="@(c.Id==Model.ClassId?"selected":null)">@c.Name</option>}</select></div><div class="col-md-6"><label asp-for="Term" class="form-label required"></label><input asp-for="Term" class="form-control" maxlength="80" required /><span asp-validation-for="Term"></span></div><div class="col-md-6"><label asp-for="Amount" class="form-label required"></label><input asp-for="Amount" type="number" min=".01" step=".01" class="form-control" required /><span asp-validation-for="Amount"></span></div><div class="col-md-6"><label asp-for="DueDate" class="form-label required">Due date</label><input asp-for="DueDate" type="date" class="form-control" required /><span asp-validation-for="DueDate"></span></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
