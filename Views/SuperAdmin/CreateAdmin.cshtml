@{ ViewData["Title"] = "Add administrator"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Super Admin only</span><h1>Add administrator</h1><p>Create a secure Admin login. Permissions can be configured after creation.</p></div><div class="page-actions"><a asp-action="Admins" class="btn btn-outline-secondary">Cancel</a></div></div>
<div class="card section-card form-card"><form method="post" novalidate><div asp-validation-summary="All"></div><div class="form-section"><div class="form-section-title"><h2>Administrator identity</h2><p>Use official institutional information.</p></div><div class="row g-3"><div class="col-md-6"><label class="form-label required" for="fullName">Full name</label><input id="fullName" name="fullName" class="form-control" placeholder="Administrator name" required /></div><div class="col-md-6"><label class="form-label required" for="email">Email address</label><input id="email" name="email" type="email" class="form-control" placeholder="admin@school.edu" required /></div></div></div><div class="form-section"><div class="form-section-title"><h2>Initial security</h2><p>A one-time activation link will be emailed. The administrator chooses a private password that is never shown to the SuperAdmin.</p></div></div><div class="form-actions"><a asp-action="Admins" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit" data-confirm="Create this Administrator account?"><i class="fa-solid fa-user-shield me-1"></i> Create administrator</button></div></form></div>
