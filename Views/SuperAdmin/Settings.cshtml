@model IEnumerable<SystemSetting>
@{ ViewData["Title"] = "System settings"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Super Admin only</span><h1>System settings</h1><p>Maintain global configuration values used by the application.</p></div></div>
<div class="row g-3"><div class="col-xl-5"><section class="card section-card"><div class="section-title-row"><div><h2>Add or update setting</h2><p>An existing key is updated in place.</p></div><span class="metric-icon"><i class="fa-solid fa-sliders"></i></span></div><form asp-action="SaveSetting" method="post" novalidate><div class="mb-3"><label class="form-label required" for="settingKey">Setting key</label><input id="settingKey" name="key" class="form-control" maxlength="100" placeholder="e.g. Attendance.EditHours" required /></div><div class="mb-3"><label class="form-label" for="settingValue">Value</label><textarea id="settingValue" name="value" class="form-control" maxlength="2000" rows="5" placeholder="Configuration value"></textarea></div><div class="form-actions"><button class="btn btn-primary" type="submit" data-confirm="Save this global system setting?">Save setting</button></div></form></section></div><div class="col-xl-7"><section class="card"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Setting key</th><th>Current value</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><code>@item.Key</code></td><td class="text-break">@item.Value</td></tr> }</tbody></table></div></section></div></div>
