@model Student_Management_System.Models.AdminDetailsViewModel
@{ViewData["Title"]=$"{Model.Admin.FullName} · Administrator";var inactive=Model.Admin.LockoutEnd>DateTimeOffset.UtcNow;}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Super Admin / Administrators</span><h1>Administrator details</h1><p>Permissions, activity and authentication history for this Admin account.</p></div><div class="page-actions"><a asp-action="EditAdmin" asp-route-id="@Model.Admin.Id" class="btn btn-outline-primary"><i class="fa-regular fa-pen-to-square"></i> Edit</a><a asp-action="Permissions" asp-route-id="@Model.Admin.Id" class="btn btn-primary"><i class="fa-solid fa-key"></i> Permissions</a><a asp-action="Admins" class="btn btn-outline-secondary">Back</a></div></div>
<section class="card profile-hero mb-3"><span class="avatar avatar-lg">@string.Concat(Model.Admin.FullName.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0])))</span><div class="profile-copy"><h1>@Model.Admin.FullName</h1><p>Administrator</p><div class="profile-meta"><span><i class="fa-regular fa-envelope"></i> @Model.Admin.Email</span><span><i class="fa-solid fa-phone"></i> @(Model.Admin.PhoneNumber??"No phone")</span></div></div><span class="badge @(inactive?"bg-danger":"bg-success")">@(inactive?"Inactive":"Active")</span></section>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Permissions</span><strong class="metric-value">@Model.Permissions.Count</strong></article><article class="metric-card info"><span class="metric-label">Activities</span><strong class="metric-value">@Model.Activities.Count</strong></article><article class="metric-card success"><span class="metric-label">Successful logins</span><strong class="metric-value">@Model.LoginHistory.Count(x=>x.Succeeded)</strong></article><article class="metric-card danger"><span class="metric-label">Failed logins</span><strong class="metric-value">@Model.LoginHistory.Count(x=>!x.Succeeded)</strong></article></div>
<div class="row g-3"><div class="col-lg-5"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Granted permissions</h2></div></div>@foreach(var p in Model.Permissions){<div class="activity-item"><span class="activity-icon"><i class="fa-solid fa-key"></i></span><span class="activity-copy"><strong>@p.Key</strong><small>@p.Description</small></span></div>}@if(Model.Permissions.Count==0){<div class="empty-state compact"><p>No explicit permissions granted.</p></div>}</section></div><div class="col-lg-7"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Recent activity</h2></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Time</th><th>Action</th><th>Entity</th></tr></thead><tbody>@foreach(var a in Model.Activities){<tr><td>@a.CreatedUtc.ToLocalTime().ToString("dd MMM HH:mm")</td><td>@a.Action</td><td>@a.EntityName #@a.EntityId</td></tr>}</tbody></table></div></section></div></div>
