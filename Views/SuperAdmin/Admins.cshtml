@model Student_Management_System.Models.PagedResult<ApplicationUser>
@using Student_Management_System.Models
@{ViewData["Title"]="Administrators";var query=ViewContext.HttpContext.Request.Query;}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Super Admin only",Title="Administrators",Description="Create, review, activate and configure Admin accounts without exposing Super Admin records.",PrimaryAction="CreateAdmin",PrimaryLabel="Add administrator",PrimaryController="SuperAdmin"})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-superadmin-admins-search-689">Search administrators</label><input id="field-superadmin-admins-search-689" name="search" value="@Model.Search" class="form-control" placeholder="Name or email"/></div><div><label class="form-label" for="field-superadmin-admins-status-848">Status</label><select id="field-superadmin-admins-status-848" name="status" class="form-select"><option value="">All</option><option value="active" selected="@(query["status"]=="active")">Active</option><option value="inactive" selected="@(query["status"]=="inactive")">Inactive</option></select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Admins" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card"><div class="table-responsive"><table class="table" data-enhanced="true"><thead><tr><th>Administrator</th><th>Status</th><th>Permissions</th><th>Password</th><th class="text-end">Account action</th></tr></thead><tbody>@foreach(var item in Model.Items){var inactive=item.LockoutEnd>DateTimeOffset.UtcNow;<tr><td><div class="attendance-person"><span class="avatar avatar-sm">@string.Concat(item.FullName.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0])))</span><span class="activity-copy"><a asp-action="AdminDetails" asp-route-id="@item.Id" class="record-link">@item.FullName</a><small>@item.Email</small></span></div></td><td><span class="badge @(inactive?"bg-danger":"bg-success")">@(inactive?"Inactive":"Active")</span></td><td><a asp-action="Permissions" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-key"></i> Configure</a></td><td><details><summary class="btn btn-sm btn-outline-secondary">Reset</summary><form asp-action="ResetPassword" method="post" class="d-flex gap-2 mt-2"><input type="hidden" name="id" value="@item.Id"/><input name="newPassword" aria-label="New password for @item.FullName" type="password" class="form-control" minlength="10" required/><button class="btn btn-sm btn-primary" data-confirm="Reset this Administrator’s password?">Save</button></form></details></td><td><form asp-action="SetAdminActive" method="post" class="d-flex justify-content-end"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="active" value="@(inactive?"true":"false")"/><button class="btn btn-sm @(inactive?"btn-success":"btn-danger")" data-confirm="Change this Administrator account status?">@(inactive?"Activate":"Deactivate")</button></form></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/></section>
