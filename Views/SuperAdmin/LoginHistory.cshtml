@model Student_Management_System.Models.PagedResult<LoginHistory>
@using Student_Management_System.Models
@{ViewData["Title"]="Login history";var query=ViewContext.HttpContext.Request.Query;}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Security monitoring",Title="Login history",Description="Search successful and failed authentication attempts across the system."})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-superadmin-loginhistory-search-575">Search</label><input id="field-superadmin-loginhistory-search-575" name="search" value="@Model.Search" class="form-control" placeholder="Email or IP address"/></div><div><label class="form-label" for="field-superadmin-loginhistory-status-725">Outcome</label><select id="field-superadmin-loginhistory-status-725" name="status" class="form-select"><option value="">All</option><option value="success" selected="@(query["status"]=="success")">Successful</option><option value="failed" selected="@(query["status"]=="failed")">Failed</option></select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="LoginHistory" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card"><div class="table-responsive"><table class="table" data-enhanced="true"><thead><tr><th>Date</th><th>Email</th><th>Status</th><th>User reference</th><th>IP</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@item.Email</td><td><span class="badge @(item.Succeeded?"bg-success":"bg-danger")">@(item.Succeeded?"Successful":"Failed")</span></td><td><code>@(item.UserId??"Unknown")</code></td><td>@(item.IpAddress??"—")</td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/></section>
