@model AdminEditInputModel
@{ ViewData["Title"]=$"Edit {Model.FullName}"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Super Admin / Administrators / Edit</span><h1>Edit @Model.FullName</h1><p>Only Super Admin can update Administrator identity information.</p></div><div class="page-actions"><a asp-action="AdminDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="EditAdmin" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="ConcurrencyStamp" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-md-6"><label asp-for="FullName" class="form-label required">Full name</label><input asp-for="FullName" class="form-control" required /><span asp-validation-for="FullName"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label required"></label><input asp-for="Email" type="email" class="form-control" required /><span asp-validation-for="Email"></span></div><div class="col-md-6"><label asp-for="PhoneNumber" class="form-label">Phone</label><input asp-for="PhoneNumber" type="tel" class="form-control" /></div><div class="col-md-6"><label class="form-label" for="administratorRole">Role</label><input id="administratorRole" value="Administrator" class="form-control" disabled /></div>
</div></section><div class="sticky-form-actions"><a asp-action="AdminDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
