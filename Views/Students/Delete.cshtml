@model Student
@{
    ViewData["Title"] = "Archive student";
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Sensitive action</span><h1>Archive student</h1><p>Disable access while preserving academic, attendance, finance, admission, and audit history.</p></div></div>
<div class="error-state card">
    <span class="error-state-icon"><i class="fa-solid fa-box-archive"></i></span>
    <span class="eyebrow">Recoverable archive</span>
    <h2>Archive @Model.FullName?</h2>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <p>The linked login will be revoked. Authorized administrators can restore the profile later.</p>
    <div class="card section-card mb-3 text-start" style="width:min(28rem,100%)"><div class="detail-grid"><div class="detail-item"><small>Email</small><strong>@Model.Email</strong></div><div class="detail-item"><small>Date of birth</small><strong>@Model.DOB.ToString("dd MMM yyyy")</strong></div></div></div>
    <form asp-action="Delete" method="post" class="w-100"><input asp-for="Id" type="hidden" /><div class="mb-3 text-start"><label class="form-label required" for="archiveReason">Archive reason</label><textarea id="archiveReason" name="reason" class="form-control" maxlength="500" required></textarea></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-danger" type="submit" data-confirm="Archive this Student and revoke login access?"><i class="fa-solid fa-box-archive me-1"></i> Archive student</button></div></form>
</div>
