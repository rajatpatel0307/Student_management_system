@model Student_Management_System.Models.TranscriptViewModel
@{ ViewData["Title"] = "Academic transcript"; }
<div class="page-header print-hide"><div class="page-header-copy"><span class="eyebrow">Official academic record</span><h1>@Model.Student.FullName</h1><p>Published results only.</p></div><div class="page-actions"><button class="btn btn-primary" type="button" data-print-page><i class="fa-solid fa-print"></i> Print transcript</button></div></div>
<section class="card section-card transcript"><header class="text-center mb-4"><h1>EduFlow Academic Transcript</h1><p>@Model.Student.FullName · @Model.Student.Class?.Name · @Model.Student.Department?.Name</p></header><div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Published assessments</span><strong class="metric-value">@Model.Marks.Count</strong></article><article class="metric-card success"><span class="metric-label">Weighted average</span><strong class="metric-value">@Model.WeightedAveragePercent%</strong></article><article class="metric-card info"><span class="metric-label">Generated</span><strong class="metric-value fs-5">@Model.GeneratedUtc.ToLocalTime().ToString("dd MMM yyyy")</strong></article></div><div class="table-responsive"><table class="table"><thead><tr><th>Exam</th><th>Subject</th><th>Score</th><th>Grade</th><th>Result</th></tr></thead><tbody>@foreach(var mark in Model.Marks){<tr><td>@mark.Exam.Name</td><td>@mark.Subject.Name</td><td>@mark.Score / @mark.Exam.MaximumMarks</td><td>@mark.Grade</td><td>@(mark.Score>=mark.Exam.PassMarks?"Pass":"Fail")</td></tr>}</tbody></table></div></section>
