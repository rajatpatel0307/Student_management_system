@model Student_Management_System.Models.StudentDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Student.FullName} · Student";
    var student = Model.Student;
    var initials = string.Concat(student.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    var present = Model.Attendance.Count(x => x.Status == "Present");
    var absent = Model.Attendance.Count(x => x.Status == "Absent");
    var late = Model.Attendance.Count(x => x.Status == "Late");
    var excused = Model.Attendance.Count(x => x.Status == "Excused");
    var inactive = student.User?.LockoutEnd > DateTimeOffset.UtcNow;
    var lastLogin = Model.LoginHistory.FirstOrDefault(x => x.Succeeded);
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">People / Students / #@student.Id</span><h1>Student details</h1><p>Complete academic, attendance, performance and enrollment record from the live database.</p></div><div class="page-actions"><button class="btn btn-outline-secondary" data-print-page><i class="fa-solid fa-print"></i> Print</button>@if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) { <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-primary"><i class="fa-regular fa-pen-to-square"></i> Edit student</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a> } else { <a href="#" data-history-back class="btn btn-outline-secondary">Back</a> }</div></div>
<section class="card profile-hero mb-3">
    @if (!string.IsNullOrWhiteSpace(student.PhotoPath)) { <span class="avatar avatar-lg"><img src="@Url.Action("Photo", "Students", new { id = student.Id })" alt="@student.FullName" /></span> } else { <span class="avatar avatar-lg">@initials</span> }
    <div class="profile-copy"><h2>@student.FullName</h2><p>@(student.Class?.Name ?? "Class unassigned") · Section @(student.Section?.Name ?? "—")</p><div class="profile-meta">@if(Model.CanViewPersonal){<span><i class="fa-regular fa-envelope"></i> @student.Email</span><span><i class="fa-solid fa-phone"></i> @(student.Phone ?? "No phone")</span>}<span><i class="fa-solid fa-building-columns"></i> @(student.Department?.Name ?? "No department")</span></div></div>
    <span class="badge @(inactive ? "bg-danger" : "bg-success")"><span class="status-dot"></span>@(inactive ? "Inactive account" : "Active account")</span>
</section>
<nav class="details-tabs" aria-label="Student detail sections"><a href="#overview" class="active">Overview</a>@if(Model.CanViewPersonal){<a href="#guardians">Guardians</a>}<a href="#journey">Academic history</a><a href="#attendance">Attendance</a><a href="#marks">Results</a><a href="#subjects">Subjects</a><a href="#assignments">Assignments</a><a href="#timetable">Timetable</a>@if(Model.CanViewFinance){<a href="#finance">Fees</a>}<a href="#library">Library</a><a href="#leave">Leave</a>@if(Model.CanViewPersonal){<a href="#documents">Documents</a>}@if(Model.CanViewSecurity){<a href="#notifications">Notifications</a><a href="#security">Security</a><a href="#activity">Activity</a>}</nav>

<section id="overview" class="details-section">
    <div class="metric-grid mb-3">
        <article class="metric-card success"><span class="metric-icon"><i class="fa-solid fa-calendar-check"></i></span><span class="metric-label">Overall attendance</span><strong class="metric-value">@Model.AttendancePercentage.ToString("0.0")%</strong><span class="metric-note">@Model.Attendance.Count recorded sessions</span></article>
        <article class="metric-card info"><span class="metric-icon"><i class="fa-solid fa-chart-line"></i></span><span class="metric-label">Average score</span><strong class="metric-value">@Model.AverageScore.ToString("0.0")%</strong><span class="metric-note">@Model.Marks.Count evaluated records</span></article>
        <article class="metric-card"><span class="metric-icon"><i class="fa-solid fa-book-open"></i></span><span class="metric-label">Enrolled subjects</span><strong class="metric-value">@Model.Subjects.Count</strong><span class="metric-note">Current subject enrollments</span></article>
        <article class="metric-card warning"><span class="metric-icon"><i class="fa-solid fa-list-check"></i></span><span class="metric-label">Pending assignments</span><strong class="metric-value">@Model.Assignments.Count(a => !Model.Submissions.Any(s => s.AssignmentId == a.Id))</strong><span class="metric-note">Not yet submitted</span></article>
    </div>
    <div class="row g-3 mb-3"><div class="col-lg-6"><div class="card section-card h-100"><div class="section-title-row"><div><h2>@(Model.CanViewPersonal ? "Personal information" : "Student identity")</h2><p>@(Model.CanViewPersonal ? "Identity and contact data" : "Teaching-scope information")</p></div></div><div class="detail-grid"><div class="detail-item"><small>Full name</small><strong>@student.FullName</strong></div>@if(Model.CanViewPersonal){<div class="detail-item"><small>Date of birth</small><strong>@student.DOB.ToString("dd MMMM yyyy")</strong></div><div class="detail-item"><small>Email</small><strong>@student.Email</strong></div><div class="detail-item"><small>Phone</small><strong>@(student.Phone ?? "Not provided")</strong></div><div class="detail-item"><small>Admission number</small><strong>@(student.AdmissionNumber ?? "Not assigned")</strong></div><div class="detail-item"><small>Roll number</small><strong>@(student.RollNumber ?? "Not assigned")</strong></div><div class="detail-item"><small>Status</small><strong>@student.StudentStatus</strong></div><div class="detail-item"><small>Admission date</small><strong>@(student.AdmissionDate?.ToString("dd MMM yyyy") ?? "Not recorded")</strong></div><div class="detail-item"><small>Emergency contact</small><strong>@(student.EmergencyContactName ?? "Not provided") · @(student.EmergencyContactPhone ?? "—")</strong></div><div class="detail-item"><small>Blood group</small><strong>@(student.BloodGroup ?? "Not recorded")</strong></div><div class="detail-item" style="grid-column:1/-1"><small>Address</small><strong>@(student.Address ?? "Not provided")</strong></div>}</div></div></div><div class="col-lg-6"><div class="card section-card h-100"><div class="section-title-row"><div><h2>Current enrollment</h2><p>Academic placement</p></div></div><div class="detail-grid"><div class="detail-item"><small>Program</small><strong>@(student.AcademicProgram?.Name ?? "Unassigned")</strong></div><div class="detail-item"><small>Department</small><strong>@(student.Department?.Name ?? "Unassigned")</strong></div><div class="detail-item"><small>Semester</small><strong>@(student.Semester?.Name ?? "Unassigned")</strong></div><div class="detail-item"><small>Class</small><strong>@(student.Class?.Name ?? "Unassigned")</strong></div><div class="detail-item"><small>Section</small><strong>@(student.Section?.Name ?? "Unassigned")</strong></div><div class="detail-item"><small>Academic year</small><strong>@(student.Semester?.AcademicYear?.Name ?? "Unassigned")</strong></div>@if(Model.CanViewPersonal){<div class="detail-item"><small>Expected graduation</small><strong>@(student.ExpectedGraduationDate?.ToString("dd MMM yyyy") ?? "Not recorded")</strong></div><div class="detail-item"><small>Account link</small><strong>@(string.IsNullOrWhiteSpace(student.UserId) ? "Not linked" : "Linked")</strong></div>}</div></div></div></div>
</section>

@if(Model.CanViewPersonal)
{
<section id="guardians" class="card section-card details-section mb-3"><div class="section-title-row"><div><h2>Guardian information</h2><p>Active authorized family links and visibility settings.</p></div></div>@if(Model.Guardians.Count==0){<div class="empty-state compact"><p>No active Guardian links.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Guardian</th><th>Relationship</th><th>Primary</th><th>Academic access</th><th>Finance access</th><th>Contact</th></tr></thead><tbody>@foreach(var link in Model.Guardians){<tr><td>@link.GuardianProfile.FullName</td><td>@link.Relationship</td><td>@(link.IsPrimary?"Yes":"No")</td><td>@(link.CanViewAcademics?"Allowed":"Restricted")</td><td>@(link.CanViewFinance?"Allowed":"Restricted")</td><td>@link.GuardianProfile.Email · @(link.GuardianProfile.Phone??"—")</td></tr>}</tbody></table></div>}</section>
}

<section id="journey" class="card section-card details-section mb-3"><div class="section-title-row"><div><h2>Academic journey</h2><p>Recorded class and section enrollment history</p></div></div>@if (Model.Enrollments.Count == 0) { <div class="empty-state compact"><p>No enrollment history has been recorded.</p></div> } else { <div class="timeline">@foreach (var item in Model.Enrollments) { <div class="timeline-item"><strong>@item.Class.Name · Section @item.Section.Name</strong><small>@item.AcademicYear.Name · @(item.IsActive ? "Active enrollment" : "Completed enrollment")</small></div> }</div> }</section>

<section id="attendance" class="card section-card details-section mb-3"><div class="section-title-row"><div><h2>Attendance history</h2><p>Present @present · Absent @absent · Late @late · Excused @excused</p></div><span class="badge @(Model.AttendancePercentage >= 75 ? "bg-success" : "bg-danger")">@Model.AttendancePercentage.ToString("0.0")%</span></div>@if (Model.Attendance.Count == 0) { <div class="empty-state compact"><p>No attendance records are available.</p></div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Subject</th><th>Lecture</th><th>Professor</th><th>Status</th></tr></thead><tbody>@foreach (var item in Model.Attendance.Take(50)) { <tr><td>@item.Date.ToString("dd MMM yyyy")</td><td>@(item.Subject?.Name ?? "General")</td><td>@(item.Lecture ?? "—")</td><td>@(item.Teacher?.FullName ?? "—")</td><td><span class="badge @(item.Status == "Present" ? "bg-success" : item.Status == "Absent" ? "bg-danger" : "bg-warning")">@item.Status</span></td></tr> }</tbody></table></div> }</section>

<section id="marks" class="card section-card details-section mb-3"><div class="section-title-row"><div><h2>Marks and results</h2><p>Only results authorized for your account are shown.</p></div></div>@if (Model.Marks.Count == 0) { <div class="empty-state compact"><p>No published results are available.</p></div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Exam</th><th>Subject</th><th>Score</th><th>Grade</th><th>Result</th><th>Remarks</th></tr></thead><tbody>@foreach (var item in Model.Marks) { <tr><td>@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")||User.IsInRole("HOD")){<a asp-controller="Exam" asp-action="Details" asp-route-id="@item.ExamId" class="record-link">@item.Exam.Name</a>}else{<span>@item.Exam.Name</span>}</td><td><a asp-controller="Subject" asp-action="Details" asp-route-id="@item.SubjectId" class="record-link">@item.Subject.Name</a></td><td><strong>@item.Score / @item.Exam.MaximumMarks</strong></td><td>@item.Grade</td><td><span class="badge @(item.Score >= item.Exam.PassMarks ? "bg-success" : "bg-danger")">@(item.Score >= item.Exam.PassMarks ? "Passed" : "Failed")</span></td><td>@(item.Remarks ?? "—")</td></tr> }</tbody></table></div> }</section>

<section id="subjects" class="card section-card details-section mb-3"><div class="section-title-row"><div><h2>Subjects</h2><p>Current subject enrollment and Professor responsibility</p></div></div><div class="row g-3">@foreach (var enrollment in Model.Subjects) { <div class="col-md-6 col-xl-4"><a asp-controller="Subject" asp-action="Details" asp-route-id="@enrollment.SubjectId" class="card clickable p-3 h-100"><strong>@enrollment.Subject.Name</strong><small class="text-muted">@(enrollment.Subject.Teacher?.FullName ?? "Professor unassigned")</small></a></div> }@if (Model.Subjects.Count == 0) { <div class="empty-state compact"><p>No subject enrollments are available.</p></div> }</div></section>

<section id="assignments" class="card section-card details-section mb-3"><div class="section-title-row"><div><h2>Assignments</h2><p>Assigned work and submission status</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Assignment</th><th>Subject</th><th>Due</th><th>Status</th><th>Score</th></tr></thead><tbody>@foreach (var item in Model.Assignments) { var submission = Model.Submissions.FirstOrDefault(s => s.AssignmentId == item.Id); <tr><td><a asp-controller="Assignment" asp-action="Details" asp-route-id="@item.Id" class="record-link">@item.Title</a></td><td>@item.Subject?.Name</td><td>@item.DueUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge @(submission != null ? "bg-success" : item.DueUtc < DateTime.UtcNow ? "bg-danger" : "bg-warning")">@(submission != null ? "Submitted" : item.DueUtc < DateTime.UtcNow ? "Overdue" : "Pending")</span></td><td>@(submission?.Score?.ToString() ?? "—")</td></tr> }</tbody></table></div></section>

<section id="timetable" class="card section-card details-section"><div class="section-title-row"><div><h2>Current timetable</h2><p>Class periods and teaching staff</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Day</th><th>Time</th><th>Subject</th><th>Professor</th><th>Room</th></tr></thead><tbody>@foreach (var item in Model.Timetable) { <tr><td>@((DayOfWeek)item.DayOfWeek)</td><td>@item.StartsAt.ToString(@"hh\:mm")–@item.EndsAt.ToString(@"hh\:mm")</td><td>@item.Subject?.Name</td><td>@item.Teacher?.FullName</td><td>@item.Room</td></tr> }</tbody></table></div></section>
@if(Model.CanViewFinance)
{
<section id="finance" class="card section-card details-section mt-3"><div class="section-title-row"><div><h2>Fees and transactions</h2><p>Invoice balances and immutable ledger entries.</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Invoice</th><th>Total</th><th>Aid</th><th>Paid</th><th>Outstanding</th><th>Status</th></tr></thead><tbody>@foreach(var invoice in Model.Invoices){<tr><td>@invoice.InvoiceNumber</td><td>@invoice.TotalAmount.ToString("C")</td><td>@invoice.AidAmount.ToString("C")</td><td>@invoice.PaidAmount.ToString("C")</td><td>@Math.Max(0,invoice.TotalAmount-invoice.AidAmount-invoice.PaidAmount).ToString("C")</td><td><span class="badge bg-info">@invoice.Status</span></td></tr>}</tbody></table></div><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Receipt</th><th>Fee</th><th>Type</th><th>Amount</th><th>Date</th></tr></thead><tbody>@foreach(var item in Model.FinanceTransactions.Take(100)){<tr><td>@item.ReceiptNumber</td><td>@item.Fee.Term</td><td>@item.Type</td><td>@item.Amount.ToString("C")</td><td>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div></section>
}
<section id="library" class="card section-card details-section mt-3"><div class="section-title-row"><div><h2>Library loans</h2><p>Current and historical circulation records.</p></div></div>@if(Model.LibraryLoans.Count==0){<div class="empty-state compact"><p>No library loans recorded.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Book</th><th>Issued</th><th>Due</th><th>Returned</th><th>Fine</th></tr></thead><tbody>@foreach(var loan in Model.LibraryLoans){<tr><td>@loan.LibraryBookCopy.LibraryBook.Title</td><td>@loan.IssuedUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@loan.DueUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@(loan.ReturnedUtc?.ToLocalTime().ToString("dd MMM yyyy")??"On loan")</td><td>@loan.FineAmount.ToString("C")</td></tr>}</tbody></table></div>}</section>
<section id="leave" class="card section-card details-section mt-3"><div class="section-title-row"><div><h2>Leave history</h2><p>Submitted and reviewed leave requests.</p></div></div>@if(Model.LeaveRequests.Count==0){<div class="empty-state compact"><p>No leave requests.</p></div>}else{<div class="timeline">@foreach(var leave in Model.LeaveRequests){<div class="timeline-item"><strong>@leave.LeaveType · @leave.Status</strong><small>@leave.StartsOn.ToString("dd MMM") – @leave.EndsOn.ToString("dd MMM yyyy") · @leave.Reason</small></div>}</div>}</section>
@if(Model.CanViewPersonal)
{
<section id="documents" class="card section-card details-section mt-3"><div class="section-title-row"><div><h2>Documents and certificates</h2><p>Private admission documents; downloads remain controller-authorized.</p></div></div>@if(Model.Documents.Count==0){<div class="empty-state compact"><p>No linked documents.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Document</th><th>Status</th><th>Uploaded</th></tr></thead><tbody>@foreach(var document in Model.Documents){<tr><td>@document.DocumentType</td><td><span class="badge bg-info">@document.Status</span></td><td>@document.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>}</section>
}
@if(Model.CanViewSecurity)
{
<section id="notifications" class="card section-card details-section mt-3"><div class="section-title-row"><div><h2>Notifications</h2><p>Personal account notifications.</p></div></div><div class="activity-list">@foreach(var item in Model.Notifications.Take(50)){<div class="activity-item"><span class="activity-icon"><i class="fa-regular fa-bell"></i></span><span class="activity-copy"><strong>@item.Title</strong><small>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @(item.IsRead?"Read":"Unread")</small></span></div>}</div></section>
<section id="security" class="card section-card details-section mt-3"><div class="section-title-row"><div><h2>Account security</h2><p>Restricted login information is never loaded for unauthorized roles.</p></div></div><div class="detail-grid"><div class="detail-item"><small>Last successful login</small><strong>@(lastLogin?.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")??"Never")</strong></div><div class="detail-item"><small>Recent attempts</small><strong>@Model.LoginHistory.Count</strong></div><div class="detail-item"><small>Account state</small><strong>@(inactive?"Inactive":"Active")</strong></div></div></section>
<section id="activity" class="card section-card details-section mt-3"><div class="section-title-row"><div><h2>Activity history</h2><p>Restricted audit events related to this record or account.</p></div></div><div class="timeline">@foreach(var item in Model.ActivityHistory){<div class="timeline-item"><strong>@item.Action</strong><small>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @item.EntityName</small></div>}</div></section>
}
