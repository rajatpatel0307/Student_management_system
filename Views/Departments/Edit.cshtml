@model Department
@{ ViewData["Title"] = $"Edit {Model.Name}"; var hods = ViewBag.Hods as IEnumerable<Teacher> ?? Enumerable.Empty<Teacher>(); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Departments / @Model.Code / Edit</span><h1>Edit @Model.Name</h1><p>Update the department identity and assigned HOD.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div>
<section class="edit-section"><div class="edit-section-header"><span class="edit-section-icon"><i class="fa-solid fa-building-columns"></i></span><div><h2>Department information</h2><p>Codes must be unique. The selected HOD is linked to this department.</p></div></div><div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label required"></label><input asp-for="Name" class="form-control" maxlength="120" required /><span asp-validation-for="Name"></span></div>
<div class="col-md-6"><label asp-for="Code" class="form-label required"></label><input asp-for="Code" class="form-control text-uppercase" maxlength="20" required /><span asp-validation-for="Code"></span></div>
<div class="col-12"><label asp-for="HodTeacherId" class="form-label">Department HOD</label><select asp-for="HodTeacherId" class="form-select"><option value="">Assign later</option>@foreach(var hod in hods){<option value="@hod.Id" selected="@(hod.Id==Model.HodTeacherId?"selected":null)">@hod.FullName · @hod.Email</option>}</select><span asp-validation-for="HodTeacherId"></span></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
