@model Student_Management_System.Models.DepartmentDetailsViewModel
@{ViewData["Title"]=$"{Model.Department.Name} · Department";}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Organization / Departments / @Model.Department.Code</span><h1>@Model.Department.Name</h1><p>Department leadership, people, academic structure and live performance overview.</p></div><div class="page-actions"><button data-print-page class="btn btn-outline-secondary"><i class="fa-solid fa-print"></i> Print</button>@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-action="Edit" asp-route-id="@Model.Department.Id" class="btn btn-primary"><i class="fa-regular fa-pen-to-square"></i> Edit</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a>}else{<a asp-controller="HodDashboard" asp-action="Index" class="btn btn-outline-secondary">Back</a>}</div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Professors</span><strong class="metric-value">@Model.Teachers.Count(t=>t.TeacherType==TeacherType.Professor)</strong></article><article class="metric-card info"><span class="metric-label">Students</span><strong class="metric-value">@Model.Students.Count</strong></article><article class="metric-card success"><span class="metric-label">Attendance</span><strong class="metric-value">@Model.AttendancePercentage.ToString("0.0")%</strong></article><article class="metric-card warning"><span class="metric-label">Average score</span><strong class="metric-value">@Model.AverageScore.ToString("0.0")%</strong></article></div>
<div class="row g-3"><div class="col-lg-4"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Department profile</h2><p>Leadership and structure</p></div></div><div class="detail-grid"><div class="detail-item"><small>Code</small><strong>@Model.Department.Code</strong></div><div class="detail-item"><small>HOD</small><strong>@(Model.Department.HodTeacher?.FullName??"Unassigned")</strong></div><div class="detail-item"><small>Classes</small><strong>@Model.Classes.Count</strong></div><div class="detail-item"><small>Sections</small><strong>@Model.SectionCount</strong></div><div class="detail-item"><small>Subjects</small><strong>@Model.Subjects.Count</strong></div></div></section></div><div class="col-lg-8"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Faculty</h2><p>Department HOD and Professors</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Type</th><th>Email</th></tr></thead><tbody>@foreach(var t in Model.Teachers){<tr><td><a asp-controller="Teachers" asp-action="Details" asp-route-id="@t.Id" class="record-link">@t.FullName</a></td><td>@t.TeacherType</td><td>@t.Email</td></tr>}</tbody></table></div></section></div></div>
<div class="row g-3 mt-0"><div class="col-lg-6"><section class="card section-card"><div class="section-title-row"><div><h2>Classes and subjects</h2></div></div>@foreach(var c in Model.Classes){<a asp-controller="Classes" asp-action="Details" asp-route-id="@c.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-school"></i></span><span class="activity-copy"><strong>@c.Name</strong><small>@(c.Semester?.Name??"No semester")</small></span></a>}@foreach(var s in Model.Subjects.Take(8)){<a asp-controller="Subject" asp-action="Details" asp-route-id="@s.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-book"></i></span><span class="activity-copy"><strong>@s.Name</strong><small>@(s.Teacher?.FullName??"Professor unassigned")</small></span></a>}</section></div><div class="col-lg-6"><section class="card section-card"><div class="section-title-row"><div><h2>Recent announcements</h2></div></div>@foreach(var n in Model.Announcements){<div class="activity-item"><span class="activity-icon"><i class="fa-solid fa-bullhorn"></i></span><span class="activity-copy"><strong>@n.Title</strong><small>@n.CreatedDate.ToString("dd MMM yyyy")</small></span></div>}</section></div></div>
<section class="card section-card mt-3"><div class="section-title-row"><div><h2>Activity history</h2><p>Audited updates for this department</p></div></div>@foreach(var a in Model.Activities){<div class="activity-item"><span class="activity-icon"><i class="fa-solid fa-clock-rotate-left"></i></span><span class="activity-copy"><strong>@a.Action</strong><small>@a.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small></span></div>}@if(Model.Activities.Count==0){<div class="empty-state compact"><p>No department activity has been recorded.</p></div>}</section>
