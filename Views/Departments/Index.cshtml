@model Student_Management_System.Models.PagedResult<Department>
@using Student_Management_System.Models
@{ ViewData["Title"]="Departments"; var query=ViewContext.HttpContext.Request.Query; }
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel { Eyebrow="Organization",Title="Departments",Description="Review department leadership, faculty, students and classes from live academic records.",PrimaryAction="Create",PrimaryLabel="Add department",PrimaryController="Departments",ExportAction="Export",ExportController="Departments" })" />
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)" />
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-departments-index-search-724">Search departments</label><input id="field-departments-index-search-724" class="form-control" name="search" value="@Model.Search" placeholder="Name or code" /></div><div><label class="form-label" for="field-departments-index-status-880">HOD assignment</label><select id="field-departments-index-status-880" name="status" class="form-select"><option value="">All</option><option value="assigned" selected="@(query["status"]=="assigned")">Assigned</option><option value="unassigned" selected="@(query["status"]=="unassigned")">Unassigned</option></select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Items.Count==0){<partial name="_EmptyRecords" model="@(("No departments found","Adjust the filters or create a department.","Create","Add department"))" />}else{<div class="table-responsive"><table class="table table-hover" data-enhanced="true"><thead><tr><th>Department</th><th>HOD</th><th>Faculty</th><th>Students</th><th>Classes</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var d in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@d.Id" class="record-link">@d.Name</a><small class="d-block text-muted">@d.Code</small></td><td>@if(d.HodTeacher!=null){<a asp-controller="Teachers" asp-action="Details" asp-route-id="@d.HodTeacherId" class="record-link">@d.HodTeacher.FullName</a>}else{<span class="badge bg-warning">Unassigned</span>}</td><td>@d.Teachers.Count</td><td>@d.Students.Count</td><td>@d.Classes.Count</td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary"><i class="fa-regular fa-eye"></i> View</a><a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-pen-to-square"></i> Edit</a></div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model" />}</section>
