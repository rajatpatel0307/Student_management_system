@model Mark
@{ ViewData["Title"]="Edit marks"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Marks / #@Model.Id / Edit</span><h1>Edit marks</h1><p>@Model.Student.FullName · @Model.Subject.Name · @Model.Exam.Name</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-track-changes class="edit-shell"><input type="hidden" name="expectedUpdatedUtc" value="@Model.UpdatedUtc.ToString("O")" /><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div><section class="edit-section"><div class="row g-3"><div class="col-md-4"><label for="score" class="form-label required">Score</label><div class="input-group"><input id="score" name="score" value="@Model.Score.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="@Model.Exam.MaximumMarks.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control" required /><span class="input-group-text">/ @Model.Exam.MaximumMarks</span></div></div><div class="col-md-8"><label for="remarks" class="form-label">Teacher remarks</label><textarea id="remarks" name="remarks" class="form-control" maxlength="500" rows="3">@Model.Remarks</textarea></div></div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
