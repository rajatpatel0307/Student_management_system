@model Mark
@{
    ViewData["Title"]=$"{Model.Student.FullName} · {Model.Subject.Name}";
    var corrections = ViewBag.Corrections as IEnumerable<ResultCorrectionRequest> ?? [];
    var published = Model.IsApproved && Model.Exam.Status == ExamLifecycle.Published;
    var canRequestCorrection = (User.IsInRole("HOD") || User.IsInRole("Professor")) && published;
    var canReviewCorrection = User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("ExaminationOfficer");
    var canSeeCorrectionHistory = canRequestCorrection || canReviewCorrection;
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Marks / Record #@Model.Id</span><h1>Marks details</h1><p>@Model.Student.FullName · @Model.Subject.Name · @Model.Exam.Name</p></div><div class="page-actions">@if((User.IsInRole("HOD")||User.IsInRole("Professor"))&&Model.Exam.Status==ExamLifecycle.OpenForEntry&&!Model.IsApproved){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit marks</a>}<a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card info"><span class="metric-label">Score</span><strong class="metric-value">@Model.Score/@Model.Exam.MaximumMarks</strong></article><article class="metric-card"><span class="metric-label">Grade</span><strong class="metric-value">@Model.Grade</strong></article><article class="metric-card @(Model.Score>=Model.Exam.PassMarks?"success":"danger")"><span class="metric-label">Result</span><strong class="metric-value">@(Model.Score>=Model.Exam.PassMarks?"Pass":"Fail")</strong></article></div>
<section class="card section-card mb-3"><div class="detail-grid"><div class="detail-item"><small>Student</small><strong><a asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentId" asp-route-tab="marks">@Model.Student.FullName</a></strong></div><div class="detail-item"><small>Subject</small><strong><a asp-controller="Subject" asp-action="Details" asp-route-id="@Model.SubjectId">@Model.Subject.Name</a></strong></div><div class="detail-item"><small>Exam</small><strong>@Model.Exam.Name</strong></div><div class="detail-item"><small>Professor</small><strong>@(Model.EnteredByTeacher?.FullName??"Not recorded")</strong></div><div class="detail-item"><small>Lifecycle</small><strong>@Model.Exam.Status · @(Model.IsApproved ? "Approved" : "Pending approval")</strong></div><div class="detail-item"><small>Updated</small><strong>@Model.UpdatedUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</strong></div><div class="detail-item" style="grid-column:1/-1"><small>Remarks</small><strong>@(Model.Remarks??"No remarks")</strong></div></div></section>
@if (canRequestCorrection)
{
    <section class="card section-card mb-3">
        <div class="section-title-row"><div><h2>Published-result correction</h2><p>Published marks cannot be edited directly. Submit a reasoned request for authorized review.</p></div></div>
        <form asp-action="RequestCorrection" method="post" class="row g-3">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-md-3"><label class="form-label" for="correctedScore">Corrected score</label><input id="correctedScore" name="score" type="number" min="0" max="@Model.Exam.MaximumMarks" step="0.01" value="@Model.Score" class="form-control" required /></div>
            <div class="col-md-7"><label class="form-label" for="correctionReason">Reason</label><input id="correctionReason" name="reason" maxlength="1000" class="form-control" required /></div>
            <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Request</button></div>
        </form>
    </section>
}
@if (canSeeCorrectionHistory && corrections.Any())
{
    <section class="card table-card">
        <div class="section-title-row p-3"><div><h2>Correction history</h2><p>Review and publication trail for this result.</p></div></div>
        <div class="table-responsive"><table class="table"><thead><tr><th>Requested</th><th>Score change</th><th>Reason</th><th>Status</th><th class="text-end">Review</th></tr></thead><tbody>
        @foreach (var item in corrections)
        {
            <tr>
                <td>@item.RequestedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td>@item.PreviousScore.ToString("0.##") → @item.RequestedScore.ToString("0.##")</td>
                <td>@item.Reason</td>
                <td><span class="badge @(item.Status == ApprovalStatus.Approved ? "bg-success" : item.Status == ApprovalStatus.Rejected ? "bg-danger" : "bg-warning")">@item.Status</span></td>
                <td class="text-end">
                    @if (canReviewCorrection && item.Status == ApprovalStatus.Pending)
                    {
                        <form asp-action="ReviewCorrection" method="post" class="d-inline-flex gap-2">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button name="approve" value="true" class="btn btn-sm btn-success" data-confirm="Apply this corrected score to the published result?">Approve</button>
                            <button name="approve" value="false" class="btn btn-sm btn-danger">Reject</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody></table></div>
    </section>
}
