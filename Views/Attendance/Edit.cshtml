@model Attendance
@{ ViewData["Title"]="Edit attendance"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Attendance / #@Model.Id / Edit</span><h1>Edit attendance</h1><p>@Model.Student.FullName · @Model.Date.ToString("dd MMMM yyyy") · @(Model.Subject?.Name??"General")</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-track-changes class="edit-shell"><input type="hidden" name="expectedUpdatedUtc" value="@Model.UpdatedUtc?.ToString("O")" /><input type="hidden" name="checkRevision" value="true" /><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div><section class="edit-section"><div class="row g-3"><div class="col-md-6"><label for="status" class="form-label required">Attendance status</label><select id="status" name="status" class="form-select" required>@foreach(var value in new[]{"Present","Absent","Late","Excused"}){<option value="@value" selected="@(value==Model.Status?"selected":null)">@value</option>}</select></div><div class="col-md-6"><label for="lecture" class="form-label">Lecture</label><input id="lecture" name="lecture" value="@Model.Lecture" class="form-control" maxlength="100" /></div></div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
