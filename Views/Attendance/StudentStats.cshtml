@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Student attendance statistics";
}
<div class="page-header">
    <div class="page-header-copy"><span class="eyebrow">Attendance analytics</span><h1>Student attendance</h1><p>Identify attendance risk early and support students below the 75% target.</p></div>
</div>
<div class="card"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Student</th><th>Attendance</th><th>Progress</th><th>Status</th></tr></thead><tbody>
@foreach (var item in Model)
{
    var percentage = (int)item.Percentage;
    <tr>
        <td><strong>@item.Name</strong></td>
        <td><strong>@percentage%</strong></td>
        <td style="min-width:14rem"><div class="progress"><div class="progress-bar @(percentage < 75 ? "bg-danger" : "bg-success")" style="width:@percentage%"></div></div></td>
        <td><span class="badge @(percentage < 75 ? "bg-danger" : "bg-success")"><i class="fa-solid @(percentage < 75 ? "fa-triangle-exclamation" : "fa-circle-check")"></i>@(percentage < 75 ? "Needs attention" : "On track")</span></td>
    </tr>
}
</tbody></table></div></div>
