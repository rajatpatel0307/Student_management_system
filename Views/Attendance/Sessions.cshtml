@model IReadOnlyList<Student_Management_System.Models.AttendanceSession>
@using Student_Management_System.Models
@{ ViewData["Title"] = "Attendance sessions"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Attendance / Review</span><h1>Attendance sessions</h1><p>Lecture-level submissions, roster totals, and approval state.</p></div><div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Attendance records</a></div></div>
<section class="card table-card">
@if(Model.Count==0){<div class="empty-state"><h2>No attendance sessions</h2><p>Sessions appear after a Professor or HOD submits attendance.</p></div>}else{
<div class="table-responsive"><table class="table"><thead><tr><th>Date / period</th><th>Class</th><th>Subject</th><th>Professor</th><th>Roster</th><th>Status</th><th class="text-end">Action</th></tr></thead><tbody>
@foreach(var session in Model){<tr><td><strong>@session.SessionDate.ToString("dd MMM yyyy")</strong><small class="d-block text-muted">@session.Period</small></td><td>@session.Class.Name</td><td>@session.Subject.Name</td><td>@session.Teacher.FullName</td><td>@session.Records.Count records</td><td><span class="badge @(session.Status==AttendanceSessionStatus.Approved?"bg-success":session.Status==AttendanceSessionStatus.Submitted?"bg-warning":"bg-info")">@session.Status</span></td><td class="text-end">@if(User.IsInRole("HOD")&&session.Status==AttendanceSessionStatus.Submitted){<form asp-action="ApproveSession" method="post"><input type="hidden" name="id" value="@session.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(session.RowVersion)"/><button class="btn btn-sm btn-success" data-confirm="Approve this attendance session?">Approve</button></form>}</td></tr>}
</tbody></table></div>}
</section>
