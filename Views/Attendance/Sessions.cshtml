@model PagedResult<Student_Management_System.Models.AttendanceSession>
@using Student_Management_System.Models
@{ ViewData["Title"] = "Attendance sessions"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Attendance / Review</span><h1>Attendance sessions</h1><p>Lecture-level submissions, roster totals, and approval state.</p></div><div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Attendance records</a></div></div>
<section class="card table-card">
<div class="table-toolbar"><strong>@Model.TotalCount.ToString("N0") sessions</strong><partial name="_PageSizeSelector" model="Model.PageSize" /></div>
@if(Model.Items.Count==0){<div class="empty-state"><h2>No attendance sessions</h2><p>Sessions appear after an authorized Professor or HOD submits attendance in your scope.</p></div>}else{
<div class="table-responsive"><table class="table"><caption class="visually-hidden">Authorized attendance sessions and roster approval states</caption><thead><tr><th scope="col">Date / period</th><th scope="col">Class</th><th scope="col">Subject</th><th scope="col">Professor</th><th scope="col">Roster</th><th scope="col">Status</th><th scope="col" class="text-end">Action</th></tr></thead><tbody>
@foreach(var session in Model.Items){<tr><td><strong>@session.SessionDate.ToString("dd MMM yyyy")</strong><small class="d-block text-muted">@session.Period</small></td><td>@session.Class.Name</td><td>@session.Subject.Name</td><td>@session.Teacher.FullName</td><td>@session.Records.Count records</td><td><span class="badge @(session.Status==AttendanceSessionStatus.Approved?"bg-success":session.Status==AttendanceSessionStatus.Submitted?"bg-warning":"bg-info")">@session.Status</span></td><td class="text-end">@if(User.IsInRole("HOD")&&session.Status==AttendanceSessionStatus.Submitted){<form asp-action="ApproveSession" method="post"><input type="hidden" name="id" value="@session.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(session.RowVersion)"/><button class="btn btn-sm btn-success" data-confirm="Approve this attendance session?" aria-label="Approve @session.Subject.Name attendance for @session.SessionDate.ToString("dd MMM yyyy") @session.Period">Approve</button></form>}</td></tr>}
</tbody></table></div>}
<partial name="_ServerPagination" model="Model" />
</section>
