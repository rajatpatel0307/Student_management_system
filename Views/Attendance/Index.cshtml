@model Student_Management_System.Models.PagedResult<Attendance>
@using Student_Management_System.Models
@{ViewData["Title"]="Attendance records";var query=ViewContext.HttpContext.Request.Query;}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Academic records",Title="Attendance records",Description="Search and review permission-aware attendance from the complete database dataset.",PrimaryAction=User.IsInRole("HOD")||User.IsInRole("Professor")?"SelectClass":null,PrimaryLabel="Take attendance",PrimaryController="Attendance"})"/>
<div class="d-flex flex-wrap gap-2 justify-content-end mb-3"><a asp-action="Sessions" class="btn btn-outline-primary">Review sessions</a><a asp-action="Export" asp-all-route-data="@(query.ToDictionary(x=>x.Key,x=>x.Value.ToString()))" class="btn btn-outline-secondary">Export all filtered results</a></div>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-attendance-index-search-1041">Search</label><input id="field-attendance-index-search-1041" name="search" value="@Model.Search" class="form-control" placeholder="Student or subject"/></div><div><label class="form-label" for="field-attendance-index-departmentid-1190">Department</label><select id="field-attendance-index-departmentid-1190" name="departmentId" class="form-select"><option value="">All</option>@foreach(var d in (IEnumerable<Department>)ViewBag.Departments){<option value="@d.Id" selected="@(query["departmentId"]==d.Id.ToString())">@d.Name</option>}</select></div><div><label class="form-label" for="field-attendance-index-classid-1487">Class</label><select id="field-attendance-index-classid-1487" name="classId" class="form-select"><option value="">All</option>@foreach(var c in (IEnumerable<Class>)ViewBag.Classes){<option value="@c.Id" selected="@(query["classId"]==c.Id.ToString())">@c.Name</option>}</select></div><div><label class="form-label" for="field-attendance-index-subjectid-1760">Subject</label><select id="field-attendance-index-subjectid-1760" name="subjectId" class="form-select"><option value="">All</option>@foreach(var s in (IEnumerable<Subject>)ViewBag.Subjects){<option value="@s.Id" selected="@(query["subjectId"]==s.Id.ToString())">@s.Name</option>}</select></div><div><label class="form-label" for="field-attendance-index-status-2042">Status</label><select id="field-attendance-index-status-2042" name="status" class="form-select"><option value="">All</option>@foreach(var status in new[]{"Present","Absent","Late","Excused"}){<option value="@status" selected="@(query["status"]==status)">@status</option>}</select></div><div><label class="form-label" for="field-attendance-index-from-2319">From</label><input id="field-attendance-index-from-2319" type="date" name="from" value="@query["from"]" class="form-control"/></div><div><label class="form-label" for="field-attendance-index-to-2444">To</label><input id="field-attendance-index-to-2444" type="date" name="to" value="@query["to"]" class="form-control"/></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Items.Count==0){<partial name="_EmptyRecords" model="@((""+"No attendance records","No records match the selected filters.","",""))"/>}else{<div class="table-responsive"><table class="table" data-enhanced="true"><thead><tr><th>Student</th><th>Class &amp; section</th><th>Subject</th><th>Date</th><th>Professor</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var a in Model.Items){<tr><td><a asp-controller="Students" asp-action="Details" asp-route-id="@a.StudentId" asp-route-tab="attendance" class="record-link">@a.Student.FullName</a></td><td>@a.Student.Class?.Name · @a.Student.Section?.Name</td><td>@if(a.Subject!=null){<a asp-controller="Subject" asp-action="Details" asp-route-id="@a.SubjectId" class="record-link">@a.Subject.Name</a>}else{<span>General</span>}</td><td>@a.Date.ToString("dd MMM yyyy")<small class="d-block text-muted">@(a.Lecture??"—")</small></td><td>@(a.Teacher?.FullName??"—")</td><td><span class="badge @(a.Status=="Present"?"bg-success":a.Status=="Absent"?"bg-danger":"bg-warning")">@a.Status</span></td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">View</a>@if(User.IsInRole("HOD")||User.IsInRole("Professor")){<a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Edit</a>}</div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/>}</section>
