@{
    ViewData["Title"] = "Attendance";
    var classes = ViewBag.Classes as IEnumerable<Class> ?? Enumerable.Empty<Class>();
}
<div class="page-header">
    <div class="page-header-copy"><span class="eyebrow">Daily records</span><h1>Attendance</h1><p>Select one of your authorized classes to take attendance or review its history.</p></div>
</div>
@if (classes.Any())
{
    <div class="row g-3">
        @foreach (var item in classes)
        {
            <div class="col-sm-6 col-xl-4">
                <article class="card section-card h-100 clickable">
                    <div class="metric-top"><span class="metric-icon"><i class="fa-solid fa-school"></i></span><span class="badge bg-primary">Class #@item.Id</span></div>
                    <h2 class="h5 mt-3 mb-1">@item.Name</h2>
                    <p class="text-muted small">Take today’s attendance or inspect previous attendance records.</p>
                    <div class="page-actions justify-content-start mt-auto">
                        <a asp-action="Mark" asp-route-classId="@item.Id" class="btn btn-primary"><i class="fa-solid fa-calendar-check me-1"></i> Take attendance</a>
                        <a asp-action="History" asp-route-classId="@item.Id" class="btn btn-outline-secondary">History</a>
                    </div>
                </article>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state card"><span class="empty-state-icon"><i class="fa-solid fa-school-lock"></i></span><h2>No classes assigned</h2><p>Attendance becomes available after an authorized class is assigned to your profile.</p><a asp-controller="Profile" asp-action="Index" class="btn btn-primary">View profile</a></div>
}
