@model Student_Management_System.Models.PagedResult<Class>
@using Student_Management_System.Models
@{ViewData["Title"]="Classes";var query=ViewContext.HttpContext.Request.Query;}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Academic structure",Title="Classes",Description="Manage class groups, enrollment, sections, faculty and live academic performance.",PrimaryAction="Create",PrimaryLabel="Add class",PrimaryController="Classes",ExportAction="Export",ExportController="Classes"})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-classes-index-search-690">Search classes</label><input id="field-classes-index-search-690" name="search" value="@Model.Search" class="form-control" placeholder="Class name"/></div><div><label class="form-label" for="field-classes-index-departmentid-839">Department</label><select id="field-classes-index-departmentid-839" name="departmentId" class="form-select"><option value="">All departments</option>@foreach(var d in (IEnumerable<Department>)ViewBag.Departments){<option value="@d.Id" selected="@(query["departmentId"]==d.Id.ToString())">@d.Name</option>}</select></div><div><label class="form-label" for="field-classes-index-semesterid-1148">Semester</label><select id="field-classes-index-semesterid-1148" name="semesterId" class="form-select"><option value="">All semesters</option>@foreach(var s in (IEnumerable<Semester>)ViewBag.Semesters){<option value="@s.Id" selected="@(query["semesterId"]==s.Id.ToString())">@s.Name</option>}</select></div><div><label class="form-label" for="field-classes-index-status-1445">Assignment</label><select id="field-classes-index-status-1445" name="status" class="form-select"><option value="">All</option><option value="unassigned" selected="@(query["status"]=="unassigned")">Without Professor assignment</option></select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Items.Count==0){<partial name="_EmptyRecords" model="@(("No classes found","Adjust the filters or create a class.","Create","Add class"))"/>}else{<div class="table-responsive"><table class="table table-hover" data-enhanced="true"><thead><tr><th>Class</th><th>Department</th><th>Semester</th><th>Class teacher</th><th>Students</th><th>Sections</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@item.Id" class="record-link">@item.Name</a><small class="d-block text-muted">Class #@item.Id</small></td><td>@(item.Department?.Name??"Unassigned")</td><td>@(item.Semester?.Name??"Unassigned")</td><td>@if(item.Teacher!=null){<a asp-controller="Teachers" asp-action="Details" asp-route-id="@item.TeacherId" class="record-link">@item.Teacher.FullName</a>}else{<span class="badge bg-warning">Unassigned</span>}</td><td>@item.Students.Count</td><td>@item.Sections.Count</td><td><div class="table-actions"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fa-regular fa-eye"></i></a><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-pen-to-square"></i></a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"><i class="fa-regular fa-trash-can"></i></a></div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/>}</section>
