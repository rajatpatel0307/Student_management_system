@model Class
@{ ViewData["Title"] = "Archive class"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Sensitive action</span><h1>Archive class</h1><p>Retire this class without deleting its historical relationships.</p></div></div>
<div class="error-state card"><span class="error-state-icon"><i class="fa-solid fa-box-archive"></i></span><h2>Archive @Model.Name?</h2><p>Current relationships remain available to authorized reports: @Model.Students.Count Students and @Model.Sections.Count sections.</p><form method="post" class="w-100"><input asp-for="Id" type="hidden" /><div class="mb-3 text-start"><label class="form-label required" for="archiveReason">Archive reason</label><textarea id="archiveReason" name="reason" class="form-control" maxlength="500" required></textarea></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-danger" type="submit" data-confirm="Archive this class?">Archive class</button></div></form></div>
