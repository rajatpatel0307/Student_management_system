@model Student_Management_System.Models.ClassDetailsViewModel
@{ViewData["Title"]=$"{Model.Class.Name} · Class";var item=Model.Class;}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Academic structure / Classes / #@item.Id</span><h1>@item.Name</h1><p>Enrollment, sections, subjects, faculty, timetable and live academic outcomes.</p></div><div class="page-actions"><button data-print-page class="btn btn-outline-secondary"><i class="fa-solid fa-print"></i> Print</button>@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit class</a>}<a href="#" data-history-back class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card info"><span class="metric-label">Students</span><strong class="metric-value">@Model.Students.Count</strong></article><article class="metric-card"><span class="metric-label">Subjects</span><strong class="metric-value">@Model.Subjects.Count</strong></article><article class="metric-card success"><span class="metric-label">Attendance</span><strong class="metric-value">@Model.AttendancePercentage.ToString("0.0")%</strong></article><article class="metric-card warning"><span class="metric-label">Average score</span><strong class="metric-value">@Model.AverageScore.ToString("0.0")%</strong></article></div>
<div class="row g-3"><div class="col-lg-4"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Class information</h2></div></div><div class="detail-grid"><div class="detail-item"><small>Department</small><strong>@(item.Department?.Name??"Unassigned")</strong></div><div class="detail-item"><small>Semester</small><strong>@(item.Semester?.Name??"Unassigned")</strong></div><div class="detail-item"><small>Academic year</small><strong>@(item.Semester?.AcademicYear?.Name??"Unassigned")</strong></div><div class="detail-item"><small>Class teacher</small><strong>@(item.Teacher?.FullName??"Unassigned")</strong></div><div class="detail-item"><small>Sections</small><strong>@Model.Sections.Count</strong></div></div>@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-controller="Section" asp-action="Index" asp-route-classId="@item.Id" class="btn btn-outline-primary mt-3">Manage sections</a>}</section></div><div class="col-lg-8"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Students</h2><p>@Model.Students.Count enrolled records</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Section</th><th>Email</th></tr></thead><tbody>@foreach(var s in Model.Students.Take(20)){<tr><td><a asp-controller="Students" asp-action="Details" asp-route-id="@s.Id" class="record-link">@s.FullName</a></td><td>@(s.Section?.Name??"—")</td><td>@s.Email</td></tr>}</tbody></table></div></section></div></div>
<div class="row g-3 mt-0"><div class="col-lg-6"><section class="card section-card"><div class="section-title-row"><div><h2>Subjects and faculty</h2></div></div>@foreach(var s in Model.Subjects){<a asp-controller="Subject" asp-action="Details" asp-route-id="@s.Id" class="activity-item"><span class="activity-icon"><i class="fa-solid fa-book"></i></span><span class="activity-copy"><strong>@s.Name</strong><small>@(s.Teacher?.FullName??"Professor unassigned")</small></span></a>}</section></div><div class="col-lg-6"><section class="card section-card"><div class="section-title-row"><div><h2>Timetable</h2></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Day</th><th>Time</th><th>Subject</th><th>Professor</th></tr></thead><tbody>@foreach(var t in Model.Timetable){<tr><td>@((DayOfWeek)t.DayOfWeek)</td><td>@t.StartsAt.ToString(@"hh\:mm")</td><td>@t.Subject?.Name</td><td>@t.Teacher?.FullName</td></tr>}</tbody></table></div></section></div></div>
@if(Model.Activities.Count>0){<section class="card section-card mt-3"><div class="section-title-row"><div><h2>Recent activity</h2></div></div>@foreach(var a in Model.Activities){<div class="activity-item"><span class="activity-icon"><i class="fa-solid fa-clock-rotate-left"></i></span><span class="activity-copy"><strong>@a.Action</strong><small>@a.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small></span></div>}</section>}
