@model Notice
@{ ViewData["Title"] = $"Edit {Model.Title}"; var departments=ViewBag.Departments as IEnumerable<Department>??Enumerable.Empty<Department>(); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Announcements / #@Model.Id / Edit</span><h1>Edit announcement</h1><p>HOD announcements remain restricted to their assigned department.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="CreatedDate" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-12"><label asp-for="Title" class="form-label required"></label><input asp-for="Title" class="form-control" required /><span asp-validation-for="Title"></span></div>
@if(User.IsInRole("HOD")){<input asp-for="TargetRole" type="hidden" /><input asp-for="DepartmentId" type="hidden" /><div class="col-12"><div class="alert alert-info">This announcement is limited to your assigned department.</div></div>}
else{<div class="col-md-6"><label asp-for="TargetRole" class="form-label required">Audience</label><select asp-for="TargetRole" class="form-select" required><option>All</option><option>Admin</option><option>HOD</option><option>Professor</option><option>Student</option><option>Guardian</option><option>Accountant</option><option>Librarian</option><option>AdmissionOfficer</option><option>ExaminationOfficer</option><option>Employee</option><option>Department</option></select></div><div class="col-md-6"><label asp-for="DepartmentId" class="form-label">Department</label><select asp-for="DepartmentId" class="form-select"><option value="">Not department-specific</option>@foreach(var d in departments){<option value="@d.Id" selected="@(d.Id==Model.DepartmentId?"selected":null)">@d.Name</option>}</select><span asp-validation-for="DepartmentId"></span></div>}
<div class="col-12"><label asp-for="Message" class="form-label required"></label><textarea asp-for="Message" class="form-control" rows="8" maxlength="4000" required></textarea><span asp-validation-for="Message"></span></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
