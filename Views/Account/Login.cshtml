@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-page">
    <section class="auth-visual" aria-label="EduFlow introduction">
        <a class="auth-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
            <span class="brand-copy"><strong>EduFlow</strong><small>Campus management</small></span>
        </a>
        <div class="auth-message">
            <span>One connected campus</span>
            <h1>Learn, teach and manage—beautifully.</h1>
            <p>A secure workspace for administrators, educators and students to keep every academic day moving.</p>
        </div>
        <img class="auth-campus" src="~/icons/campus.svg" width="540" height="260" alt="" aria-hidden="true" />
        <div class="auth-features" aria-label="Platform features">
            <span class="auth-feature"><i class="fa-solid fa-shield-halved"></i> Role-secured</span>
            <span class="auth-feature"><i class="fa-solid fa-chart-simple"></i> Insightful reports</span>
            <span class="auth-feature"><i class="fa-solid fa-mobile-screen"></i> Mobile ready</span>
        </div>
    </section>
    <section class="auth-form-side">
        <div class="auth-card">
            <div class="auth-card-header">
                <span class="eyebrow">Welcome back</span>
                <h2>Sign in to your account</h2>
                <p>Use the email or username and password provided by your institution.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
            }

            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.Query["returnUrl"]" />
                <div class="mb-3">
                    <label class="form-label required" for="email">Email or username</label>
                    <input id="email" name="email" type="text" class="form-control" placeholder="Email address or username" autocomplete="username" required autofocus />
                </div>
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label required" for="password">Password</label>
                        <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot password?</a>
                    </div>
                    <input id="password" name="password" type="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-3">
                    <i class="fa-solid fa-arrow-right-to-bracket me-1" aria-hidden="true"></i> Sign in
                </button>
            </form>
            <p class="auth-footer auth-security"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Need access? Contact your school administrator.<br />Keep your account secure. Never share your password.</span></p>
        </div>
    </section>
</div>
