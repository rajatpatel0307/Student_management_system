@{
    ViewData["Title"] = "Access denied";
}
<div class="container py-5">
    <div class="error-state card">
        <span class="error-state-icon"><i class="fa-solid fa-lock"></i></span>
        <span class="eyebrow">403 · Permission denied</span>
        <h1>That area isn’t available to your role</h1>
        <p>Your account is signed in, but it does not have permission to open this page. If you believe this is incorrect, contact an administrator.</p>
        <div class="page-actions">
            <button class="btn btn-outline-secondary" type="button" data-history-back><i class="fa-solid fa-arrow-left me-1"></i> Go back</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="fa-solid fa-house me-1"></i> Return home</a>
        </div>
    </div>
</div>
