@{
    ViewData["Title"] = "Forgot password";
}
<div class="auth-page">
    <section class="auth-visual" aria-label="Account recovery">
        <a class="auth-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="fa-solid fa-graduation-cap"></i></span>
            <span class="brand-copy"><strong>EduFlow</strong><small>Campus management</small></span>
        </a>
        <div class="auth-message">
            <span>Secure account recovery</span>
            <h1>We’ll help you get back in.</h1>
            <p>Enter your institutional email and we’ll send a time-limited reset link when the account exists.</p>
        </div>
        <div class="auth-features">
            <span class="auth-feature"><i class="fa-solid fa-lock"></i> Private by design</span>
            <span class="auth-feature"><i class="fa-regular fa-clock"></i> Time-limited links</span>
        </div>
    </section>
    <section class="auth-form-side">
        <div class="auth-card">
            <div class="auth-card-header">
                <span class="eyebrow">Account recovery</span>
                <h2>Forgot your password?</h2>
                <p>Enter the email connected to your EduFlow account.</p>
            </div>
            <form method="post" novalidate>
                <div asp-validation-summary="All"></div>
                <div class="mb-3">
                    <label class="form-label required" for="email">Email address</label>
                    <input id="email" name="email" type="email" class="form-control" placeholder="you@school.edu" autocomplete="email" required autofocus />
                </div>
                <button class="btn btn-primary w-100" type="submit"><i class="fa-regular fa-paper-plane me-1"></i> Send reset link</button>
                <a asp-action="Login" class="btn btn-link w-100 mt-2"><i class="fa-solid fa-arrow-left me-1"></i> Back to sign in</a>
</form>
<hr />
<form asp-action="ResendActivation" method="post">
    <label class="form-label" for="activationEmail">Never activated your account?</label>
    <div class="input-group">
        <input id="activationEmail" name="email" type="email" class="form-control"
               autocomplete="email" placeholder="name@example.com" required />
        <button class="btn btn-outline-primary" type="submit">Resend activation</button>
    </div>
</form>
        </div>
    </section>
</div>
