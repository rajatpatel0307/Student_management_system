@{
    ViewData["Title"] = ViewData["ConfirmationTitle"] ?? "Request complete";
}
<div class="auth-form-side">
    <div class="auth-card card section-card text-center">
        <span class="empty-state-icon mx-auto"><i class="fa-solid fa-circle-check"></i></span>
        <h1 class="h3">@ViewData["ConfirmationTitle"]</h1>
        <p class="text-muted">@ViewData["ConfirmationMessage"]</p>
        <a asp-action="Login" class="btn btn-primary mt-2">Return to sign in</a>
    </div>
</div>
