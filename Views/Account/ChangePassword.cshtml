@{
    ViewData["Title"] = "Change password";
}
<div class="page-header">
    <div class="page-header-copy">
        <span class="eyebrow">Account security</span>
        <h1>Change password</h1>
        <p>Use a strong password that you do not reuse on other services.</p>
    </div>
</div>

<div class="card section-card form-card">
    <form method="post" novalidate>
        <div asp-validation-summary="All"></div>
        <div class="form-section">
            <div class="form-section-title">
                <h2>Verify your identity</h2>
                <p>Your current password is required before making this security change.</p>
            </div>
            <div class="mb-3">
                <label class="form-label required" for="currentPassword">Current password</label>
                <input id="currentPassword" name="currentPassword" type="password" class="form-control" autocomplete="current-password" required />
            </div>
        </div>
        <div class="form-section">
            <div class="form-section-title">
                <h2>Create a new password</h2>
                <p>Use at least 10 characters with uppercase, lowercase, a number and a symbol.</p>
            </div>
            <div class="mb-3">
                <label class="form-label required" for="newPassword">New password</label>
                <input id="newPassword" name="newPassword" type="password" class="form-control" minlength="10" autocomplete="new-password" required />
            </div>
        </div>
        <div class="form-actions">
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-shield-halved me-1"></i> Update password</button>
        </div>
    </form>
</div>
