@model StaffMember
@using Student_Management_System.Services
@{ ViewData["Title"] = "Staff profile"; var employee = Model.EmployeeProfile; var user = employee.User; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Staff Management · @employee.EmployeeNumber</span><h1>@user.FullName</h1><p>@StaffWorkspaceCatalog.All.First(w => w.Role == Model.PrimaryRole).Title · @(employee.Department?.Name ?? "No department")</p></div><div class="page-actions"><a class="btn btn-outline-secondary" href="/Staff">Staff directory</a><a class="btn btn-primary" href="/Staff/Edit/@Model.Id">Edit staff</a></div></div>
<div data-staff-native data-staff-id="@Model.Id">@Html.AntiForgeryToken()<div class="alert alert-danger d-none" data-staff-error role="alert"></div><div class="alert alert-success d-none" data-staff-success role="status"></div>
<section class="card section-card mb-4"><h2 class="h5">Staff information</h2><dl class="row mb-0">
@foreach (var item in new[] { ("Employee ID", employee.EmployeeNumber), ("Email", user.Email), ("Phone", user.PhoneNumber), ("Username", user.UserName), ("Joining date", employee.JoinedOn.ToString("dd MMM yyyy")), ("Status", user.IsActive ? "Active" : "Inactive"), ("Gender", Model.Gender), ("Date of birth", Model.DateOfBirth?.ToString("dd MMM yyyy")), ("Emergency contact", Model.EmergencyContact), ("Address", Model.Address), ("Notes", Model.Notes) }) { <div class="col-md-6 mb-3"><dt class="text-muted small">@item.Item1</dt><dd>@(item.Item2 ?? "—")</dd></div> }</dl></section>
<div class="row g-4"><div class="col-lg-6"><section class="card section-card h-100"><h2 class="h5">Account access</h2><p class="text-muted">Activation, deactivation and deletion revoke account sessions. Deletion retains audit history.</p><form data-json-api="/api/staff/@Model.Id/status" data-json-kind="status" data-reload="true" data-staff-confirm="@(user.IsActive ? "Deactivate this staff account?" : "Activate this staff account?")">@Html.AntiForgeryToken()<input type="hidden" name="active" value="@(!user.IsActive ? "true" : "false")" /><input type="hidden" name="delete" value="false" /><button class="btn btn-outline-primary" type="submit">@(user.IsActive ? "Deactivate account" : "Activate account")</button></form><hr/><form data-json-api="/api/staff/@Model.Id/status" data-json-kind="status" data-return="/Staff" data-staff-confirm="Remove this staff member from the directory and revoke access? Audit history will be retained.">@Html.AntiForgeryToken()<input type="hidden" name="active" value="false" /><input type="hidden" name="delete" value="true" /><button class="btn btn-outline-danger" type="submit">Delete staff</button></form></section></div>
<div class="col-lg-6"><section class="card section-card h-100"><h2 class="h5">Reset password</h2><p class="text-muted">The staff member must change the temporary password after signing in.</p><form data-json-api="/api/staff/@Model.Id/password">@Html.AntiForgeryToken()<div class="mb-3"><label for="reset-password" class="form-label">Temporary password</label><input id="reset-password" class="form-control" name="password" type="password" required minlength="10" maxlength="128" autocomplete="new-password" /></div><div class="mb-3"><label for="reset-confirm" class="form-label">Confirm password</label><input id="reset-confirm" class="form-control" name="confirmPassword" type="password" required minlength="10" maxlength="128" autocomplete="new-password" /></div><button class="btn btn-primary" type="submit">Reset password</button></form></section></div>
<div class="col-lg-6"><section class="card section-card h-100"><h2 class="h5">Workspace permissions</h2><p class="text-muted">The primary role is included. Grant additional workspace access below.</p><form data-json-api="/api/staff/@Model.Id/permissions" data-json-kind="permissions"><div data-permission-list>Loading permissions…</div><button class="btn btn-primary mt-3" type="submit" disabled data-permission-submit>Save permissions</button></form></section></div>
<div class="col-lg-6"><section class="card section-card h-100"><h2 class="h5">Login and activity history</h2><div data-staff-activity>Loading activity…</div></section></div></div></div>
@section Scripts { <script src="~/js/staff-native.js" asp-append-version="true" defer></script> }
