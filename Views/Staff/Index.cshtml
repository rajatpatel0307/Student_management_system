@model StaffDirectoryModel
@using Student_Management_System.Services
@{ ViewData["Title"] = "Staff Management"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">People and access</span><h1>Staff Management</h1><p>Manage your operational team and their dedicated workspaces.</p></div><div class="page-actions"><a class="btn btn-outline-secondary" href="/api/staff?export=true&amp;search=@Uri.EscapeDataString(Model.Search ?? "")&amp;role=@Model.Role&amp;status=@Model.Status"><i class="fa-solid fa-download me-1"></i> Export staff</a><a class="btn btn-primary" href="/Staff/Create"><i class="fa-solid fa-plus me-1"></i> Add Staff</a></div></div>
<nav class="d-flex gap-3 mb-3" aria-label="Personal staff tools"><a href="/Staff/Personal/messages">Messages</a><a href="/Staff/Personal/activity">My activity</a><a href="/Staff/Personal/help">Help and support</a></nav><div class="metric-grid mb-4"><article class="metric-card"><span class="metric-label">Total staff</span><strong class="metric-value">@Model.TotalStaff</strong></article><article class="metric-card success"><span class="metric-label">Active staff</span><strong class="metric-value">@Model.ActiveStaff</strong></article><article class="metric-card warning"><span class="metric-label">Inactive staff</span><strong class="metric-value">@(Model.TotalStaff - Model.ActiveStaff)</strong></article><article class="metric-card"><span class="metric-label">Dedicated roles</span><strong class="metric-value">5</strong></article></div>
<section class="mb-4"><h2 class="h5 mb-3">Staff workspaces</h2><div class="row g-3">@foreach (var workspace in StaffWorkspaceCatalog.All) { <div class="col-sm-6 col-xl"><a class="card h-100 p-3 text-decoration-none" href="/Staff/Workspace/@workspace.Key"><h3 class="h6">@workspace.Title</h3><span class="text-muted small">Open workspace <i class="fa-solid fa-arrow-right ms-1"></i></span></a></div> }</div></section>
<form method="get" action="/Staff" class="card filter-panel"><div class="row g-3 align-items-end"><div class="col-lg-5"><label for="staff-search" class="form-label">Search staff</label><input id="staff-search" class="form-control" name="search" value="@Model.Search" placeholder="Name, email or employee ID" /></div><div class="col-lg-3"><label for="staff-role" class="form-label">Role</label><select id="staff-role" name="role" class="form-select"><option value="">All roles</option>@foreach (var workspace in StaffWorkspaceCatalog.All) { <option value="@workspace.Role" selected="@(Model.Role == workspace.Role)">@workspace.Title</option> }</select></div><div class="col-lg-2"><label for="staff-status" class="form-label">Status</label><select id="staff-status" name="status" class="form-select"><option value="">All statuses</option><option value="active" selected="@(Model.Status == "active")">Active</option><option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option></select></div><div class="col-lg-2"><button class="btn btn-primary" type="submit">Search</button><a href="/Staff" class="btn btn-link">Reset</a></div></div></form>
<section class="card table-card">@if (Model.Items.Count == 0) { <div class="empty-state"><span class="empty-state-icon"><i class="fa-solid fa-users"></i></span><h3>No staff found</h3><p>Add a staff member or adjust your search filters.</p><a class="btn btn-primary" href="/Staff/Create">Add Staff</a></div> } else { <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Employee ID</th><th>Profile</th><th>Name / Email</th><th>Phone</th><th>Role</th><th>Department</th><th>Joining date</th><th>Status</th><th>Last login</th><th>Actions</th></tr></thead><tbody>@foreach (var staff in Model.Items) { var employee = staff.EmployeeProfile; var user = employee.User; <tr><td>@employee.EmployeeNumber</td><td>@if (user.ProfileImageStorageKey != null) { <img class="avatar avatar-sm" src="/api/staff/@staff.Id/photo" alt="Profile of @user.FullName" /> } else { <span class="avatar avatar-sm" aria-hidden="true">@user.FullName.FirstOrDefault()</span> }</td><td><a href="/Staff/Details/@staff.Id" class="record-link">@user.FullName</a><small class="d-block text-muted">@user.Email</small></td><td>@(user.PhoneNumber ?? "—")</td><td>@StaffWorkspaceCatalog.All.First(w => w.Role == staff.PrimaryRole).Title</td><td>@(employee.Department?.Name ?? "—")</td><td>@employee.JoinedOn.ToString("dd MMM yyyy")</td><td><span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td><td>@(user.LastLoginUtc?.ToString("dd MMM yyyy HH:mm") ?? "Never")<small class="d-block text-muted">UTC</small></td><td><a class="btn btn-sm btn-outline-primary" href="/Staff/Edit/@staff.Id">Edit</a><a class="btn btn-sm btn-outline-secondary" href="/Staff/Details/@staff.Id">Manage</a></td></tr> }</tbody></table></div> }
<div class="d-flex justify-content-between align-items-center gap-3 p-3 border-top"><span class="text-muted small">@Model.Total records · Page @Model.Page of @Model.Pages</span><div class="btn-group">@if (Model.Page > 1) { <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Staff", new { search = Model.Search, role = Model.Role, status = Model.Status, page = Model.Page - 1 })">Previous</a> }@if (Model.Page < Model.Pages) { <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Staff", new { search = Model.Search, role = Model.Role, status = Model.Status, page = Model.Page + 1 })">Next</a> }</div></div></section>
