@model Student_Management_System.Models.RegistrarCertificate
@{ Layout = null; }
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@Model.CertificateNumber · @Model.CertificateType</title><link rel="stylesheet" href="/css/staff-certificate.css"/></head>
<body><nav class="print-toolbar"><a href="/Staff/Workspace/registrar/certificates">← Certificate register</a><span>Use your browser’s Print command to print or save this issued record.</span></nav><main class="certificate"><header><p>OFFICIAL INSTITUTIONAL RECORD</p><h1>@Model.Campus.Institution.Name</h1><p>@Model.Campus.Name</p></header><div class="certificate-meta"><span>Certificate no. <strong>@Model.CertificateNumber</strong></span><span>Issued @Model.IssuedUtc?.ToString("dd MMM yyyy") (UTC)</span></div><h2>@Model.CertificateType Certificate</h2><p class="certificate-text">This is to certify that <strong>@Model.Student.FullName</strong>, admission number <strong>@(Model.Student.AdmissionNumber ?? Model.Student.Id.ToString())</strong>, is recorded in the official student register of @Model.Campus.Institution.Name.</p><dl><dt>Certificate type</dt><dd>@Model.CertificateType</dd><dt>Purpose / official statement</dt><dd>@Model.Purpose</dd><dt>Verification reference</dt><dd>@Model.EvidenceReference</dd><dt>Approval record</dt><dd>@Model.ReviewComment</dd></dl><footer><div><strong>Authorized institutional signature</strong><span>Signature & official seal</span></div><p>This document corresponds to an issued record in the institutional certificate register. Verify its certificate number with the registrar. A printed copy requires the institution’s authorized signature and seal.</p></footer></main></body></html>
