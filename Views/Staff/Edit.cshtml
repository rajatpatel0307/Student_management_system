@model StaffEditorModel
@using Student_Management_System.Services
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit Staff" : "Add Staff"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Staff Management</span><h1>@ViewData["Title"]</h1><p>Employment details and secure access for one primary staff role.</p></div><div class="page-actions"><a class="btn btn-outline-secondary" href="/Staff">Back to staff</a></div></div>
<section class="card section-card form-card"><form action="/Staff/Save" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@Model.Id" /><input asp-for="Input.RowVersion" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div>
<div class="form-section"><div class="form-section-title"><h2>Personal information</h2><p>Use the staff member's official contact information.</p></div><div class="row g-3">
<div class="col-md-6"><label asp-for="Input.FullName" class="form-label required">Full name</label><input asp-for="Input.FullName" class="form-control" required maxlength="160" /><span asp-validation-for="Input.FullName" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Email" class="form-label required">Email</label><input asp-for="Input.Email" class="form-control" type="email" required /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Phone" class="form-label">Phone number</label><input asp-for="Input.Phone" class="form-control" type="tel" required="@(!Model.Id.HasValue)" /><small class="text-muted">Required for new staff. Use a 10-digit mobile number or include the country code.</small></div>
<div class="col-md-6"><label for="staff-photo" class="form-label">Profile photo</label><input id="staff-photo" name="photo" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" /><small class="text-muted">JPEG, PNG or WebP; maximum 5 MB.</small></div>
<div class="col-md-6"><label asp-for="Input.Gender" class="form-label">Gender</label><select asp-for="Input.Gender" class="form-select"><option value="">Select gender</option><option>Female</option><option>Male</option><option>Non-binary</option><option>Prefer not to say</option></select></div>
<div class="col-md-6"><label asp-for="Input.DateOfBirth" class="form-label">Date of birth</label><input asp-for="Input.DateOfBirth" type="date" class="form-control" /></div>
<div class="col-md-6"><label asp-for="Input.EmergencyContact" class="form-label">Emergency contact</label><input asp-for="Input.EmergencyContact" class="form-control" maxlength="200" /></div>
<div class="col-md-6"><label asp-for="Input.Address" class="form-label">Address</label><textarea asp-for="Input.Address" class="form-control" maxlength="1000" rows="2"></textarea></div>
</div></div>
<div class="form-section"><div class="form-section-title"><h2>Employment and access</h2><p>Changing a role revokes sessions and clears previous permission overrides.</p></div><div class="row g-3">
<div class="col-md-6"><label for="staff-employee-id" class="form-label">Employee ID</label><input id="staff-employee-id" class="form-control" value="@(Model.Id.HasValue ? Model.Input.EmployeeId : "")" placeholder="Generated automatically when saved" readonly aria-describedby="staff-employee-id-help" /><small id="staff-employee-id-help" class="text-muted">Assigned automatically and kept for this employee.</small></div>
<div class="col-md-6"><label asp-for="Input.JoiningDate" class="form-label required">Joining date</label><input asp-for="Input.JoiningDate" type="date" class="form-control" required max="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
<div class="col-md-6"><label asp-for="Input.Role" class="form-label required">Primary role</label><select asp-for="Input.Role" class="form-select" required><option value="">Select a role</option>@foreach (var role in StaffWorkspaceCatalog.All) { <option value="@role.Role">@role.Title</option> }</select></div>
<div class="col-md-6"><label asp-for="Input.DepartmentId" class="form-label">Department</label><select asp-for="Input.DepartmentId" class="form-select"><option value="">No department</option>@foreach (var department in Model.Departments) { <option value="@department.Id">@department.Name</option> }</select></div>
<div class="col-md-6"><label for="staff-username" class="form-label">Username</label><input id="staff-username" class="form-control" value="@(Model.Id.HasValue ? Model.Input.Username : "")" placeholder="Generated automatically when saved" readonly aria-describedby="staff-username-help" /><small id="staff-username-help" class="text-muted">The generated login username appears on the saved staff profile.</small></div>
<div class="col-md-6"><label asp-for="Input.IsActive" class="form-label">Status</label><select asp-for="Input.IsActive" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select></div>
@if (!Model.Id.HasValue) { <div class="col-md-6"><label asp-for="Input.Password" class="form-label required">Password</label><input asp-for="Input.Password" class="form-control" type="password" required minlength="10" maxlength="128" autocomplete="new-password" /><small class="text-muted">At least 10 characters, with uppercase, lowercase, a number and a symbol.</small></div><div class="col-md-6"><label asp-for="Input.ConfirmPassword" class="form-label required">Confirm password</label><input asp-for="Input.ConfirmPassword" class="form-control" type="password" required minlength="10" maxlength="128" autocomplete="new-password" /></div> }
<div class="col-12"><label asp-for="Input.Notes" class="form-label">Additional notes</label><textarea asp-for="Input.Notes" class="form-control" rows="3" maxlength="2000"></textarea></div>
</div></div><div class="form-actions"><a href="/Staff" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">@(Model.Id.HasValue ? "Save changes" : "Create staff account")</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
