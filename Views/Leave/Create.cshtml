@model Student_Management_System.Models.LeaveRequest
@{ ViewData["Title"]="Request leave"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Leave management</span><h1>Request leave</h1><p>Provide complete dates and a clear reason for the assigned reviewer.</p></div></div>
<form asp-action="Create" method="post" data-track-changes><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><section class="card section-card"><div class="row g-3"><div class="col-md-4"><label asp-for="LeaveType" class="form-label">Leave type</label><select asp-for="LeaveType" class="form-select"><option value="">Select type</option><option>Medical</option><option>Casual</option><option>Academic</option><option>Emergency</option><option>Official duty</option><option>Unpaid</option></select><span asp-validation-for="LeaveType" class="text-danger"></span></div><div class="col-md-4"><label asp-for="StartsOn" class="form-label">Starts on</label><input asp-for="StartsOn" type="date" class="form-control" /></div><div class="col-md-4"><label asp-for="EndsOn" class="form-label">Ends on</label><input asp-for="EndsOn" type="date" class="form-control" /><span asp-validation-for="EndsOn" class="text-danger"></span></div><div class="col-12"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" class="form-control" rows="5" maxlength="2000"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div></div></section><div class="sticky-form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">Submit request</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
