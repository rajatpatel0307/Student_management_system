@model IReadOnlyList<Student_Management_System.Models.LeaveRequest>
@using Student_Management_System.Models
@{ ViewData["Title"]="Leave requests"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">People operations</span><h1>Leave requests</h1><p>Submit and review leave through a recorded approval workflow.</p></div><div class="page-actions"><a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-calendar-plus"></i> Request leave</a></div></div>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-leave-index-status-573">Status</label><select id="field-leave-index-status-573" class="form-select" name="status"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<LeaveRequestStatus>()){<option value="@status" selected="@(ViewBag.Status?.ToString()==status.ToString())">@status</option>}</select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Count==0){<partial name="_EmptyRecords" model="@(("No leave requests","Create a request or adjust the status filter.","Create","Request leave"))" />}else{<div class="table-responsive"><table class="table"><thead><tr><th>Type</th><th>Dates</th><th>Reason</th><th>Status</th><th>Submitted</th>@if(ViewBag.CanReview==true){<th class="text-end">Review</th>}</tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.LeaveType</td><td>@item.StartsOn.ToString("dd MMM") – @item.EndsOn.ToString("dd MMM yyyy")</td><td>@item.Reason</td><td><span class="badge @(item.Status==LeaveRequestStatus.Approved?"bg-success":item.Status==LeaveRequestStatus.Rejected?"bg-danger":"bg-warning")">@item.Status</span>@if(!string.IsNullOrWhiteSpace(item.ReviewComment)){<small class="d-block text-muted">@item.ReviewComment</small>}</td><td>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</td>@if(ViewBag.CanReview==true){<td class="text-end">@if(item.Status==LeaveRequestStatus.Pending){<div class="table-actions"><form asp-action="Review" method="post"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="decision" value="Approved" /><button class="btn btn-sm btn-success" data-confirm="Approve this leave request?">Approve</button></form><form asp-action="Review" method="post"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="decision" value="Rejected" /><input type="hidden" name="comment" value="Rejected by reviewer" /><button class="btn btn-sm btn-outline-danger" data-confirm="Reject this leave request?">Reject</button></form></div>}</td>}</tr>}</tbody></table></div>}</section>
