@model Student_Management_System.Models.AdmissionApplication
@using Student_Management_System.Models
@inject Student_Management_System.Services.PermissionService Permissions
@{
    ViewData["Title"] = Model.ApplicantName;
    var sections = ViewBag.Sections as IEnumerable<Section> ?? [];
    var allowedStages = ViewBag.AllowedStages as IEnumerable<AdmissionStage> ?? [];
    var appointments = ViewBag.Appointments as IEnumerable<AdmissionAppointment> ?? [];
    var canReview = await Permissions.HasAsync(User, "admission.review");
    var canApprove = await Permissions.HasAsync(User, "admission.approve");
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Admissions / @Model.ReferenceNumber</span><h1>@Model.ApplicantName</h1><p>@Model.ProgramName · @Model.AcademicYear.Name</p></div><div class="page-actions">@if(canReview && Model.Stage!=AdmissionStage.Enrolled){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit application</a>}<a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card info"><span class="metric-label">Current stage</span><strong class="metric-value fs-4">@Model.Stage</strong></article><article class="metric-card"><span class="metric-label">Department</span><strong class="metric-value fs-4">@Model.Department.Name</strong></article><article class="metric-card"><span class="metric-label">Class</span><strong class="metric-value fs-4">@(Model.Class?.Name??"Pending")</strong></article><article class="metric-card"><span class="metric-label">Created</span><strong class="metric-value fs-4">@Model.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</strong></article></div>
<div class="row g-3">
<div class="col-xl-7"><section class="card section-card h-100"><div class="section-title-row"><div><h2>Application overview</h2><p>Verified database information for this applicant.</p></div></div><dl class="detail-grid"><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Phone</dt><dd>@(Model.Phone??"—")</dd></div><div><dt>Date of birth</dt><dd>@Model.DateOfBirth.ToString("dd MMMM yyyy")</dd></div><div><dt>Source</dt><dd>@Model.Source</dd></div><div><dt>Address</dt><dd>@(Model.Address??"—")</dd></div><div><dt>Applicant notes</dt><dd>@(Model.ApplicantNotes??"—")</dd></div></dl></section></div>
<div class="col-xl-5">
    <section class="card section-card h-100">
        <div class="section-title-row">
            <div>
                <h2>Move workflow</h2>
                <p>Select an allowed next stage. Every change is validated and recorded.</p>
            </div>
        </div>
        @if (canReview && allowedStages.Any())
        {
            <form asp-action="TransitionTo" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <label class="form-label" for="workflowStage">Next stage</label>
                <select id="workflowStage" name="stage" class="form-select mb-3" required>
                    <option value="">Select an allowed stage</option>
                    @foreach (var stage in allowedStages) { <option value="@stage">@stage</option> }
                </select>
                <label class="form-label" for="workflowReason">Comment or required outcome reason</label>
                <textarea class="form-control mb-3" id="workflowReason" name="reason" rows="3" maxlength="1000"
                          placeholder="Explain this workflow decision"></textarea>
                <button class="btn btn-primary" type="submit" data-confirm="Apply this admission stage change?">Update stage</button>
            </form>
        }
        else if (!canReview && allowedStages.Any())
        {
            <p class="text-muted">You have read access to this application. A reviewer can update its stage.</p>
        }
        else if (Model.Stage == AdmissionStage.OfferSent)
        {
            <div class="alert alert-info mb-0">
                The offer has been sent. Complete the enrollment section below to create the Student account.
            </div>
        }
        else if (Model.Stage == AdmissionStage.Enrolled)
        {
            <div class="alert alert-success mb-0">
                Enrollment completed. Academic records are managed from the Student profile.
            </div>
        }
        else
        {
            <div class="alert alert-secondary mb-0">
                This workflow is closed at the @Model.Stage stage.
            </div>
        }
    </section>
</div>
</div>
<section class="card section-card mt-3">
    <div class="section-title-row"><div><h2>Entrance tests and interviews</h2><p>Schedule reviewer appointments and retain their workflow history.</p></div></div>
    @if(canReview){<form asp-action="ScheduleAppointment" method="post" class="row g-3 align-items-end">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="col-md-3"><label class="form-label" for="appointmentType">Type</label><select id="appointmentType" name="appointmentType" class="form-select"><option>Interview</option><option>EntranceTest</option><option>Counselling</option></select></div>
        <div class="col-md-3"><label class="form-label" for="appointmentStarts">Start</label><input id="appointmentStarts" name="startsUtc" type="datetime-local" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label" for="appointmentLocation">Location</label><input id="appointmentLocation" name="location" class="form-control" maxlength="160" /></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100">Schedule</button></div>
    </form>}
    @if (appointments.Any()) { <div class="table-responsive mt-3"><table class="table"><thead><tr><th>Type</th><th>Starts</th><th>Location</th><th>Status</th></tr></thead><tbody>@foreach(var appointment in appointments){<tr><td>@appointment.AppointmentType</td><td>@appointment.StartsUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@(appointment.Location??"—")</td><td><span class="badge bg-info">@appointment.Status</span></td></tr>}</tbody></table></div> }
</section>
<section class="card section-card mt-3">
    <div class="section-title-row"><div><h2>Admission documents</h2><p>Private documents are downloaded only after server-side authorization.</p></div></div>
    @if(canReview){<form asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="row g-3 align-items-end mb-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="col-md-4"><label class="form-label" for="documentType">Document type</label><input id="documentType" name="documentType" class="form-control" maxlength="80" required /></div>
        <div class="col-md-6"><label class="form-label" for="documentFile">PDF, DOCX, or PPTX</label><input id="documentFile" name="file" type="file" class="form-control" accept=".pdf,.docx,.pptx" required /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Upload</button></div>
    </form>}
    @if(Model.Documents.Count==0){<div class="empty-state compact"><p>No documents uploaded.</p></div>}else{
    <div class="table-responsive"><table class="table"><thead><tr><th>Type</th><th>File</th><th>Status</th><th>Uploaded</th><th></th></tr></thead><tbody>
    @foreach(var document in Model.Documents.OrderByDescending(d=>d.CreatedUtc)){<tr><td>@document.DocumentType</td><td><a asp-action="DownloadDocument" asp-route-id="@document.Id">@document.OriginalFileName</a></td><td><span class="badge bg-info">@document.Status</span></td><td>@document.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@if(canReview){<form asp-action="VerifyDocument" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@document.Id"/><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)"/><input name="comment" aria-label="Stage change comment" class="form-control form-control-sm" maxlength="1000" placeholder="Comment"/><button name="verified" value="true" class="btn btn-sm btn-success">Verify</button><button name="verified" value="false" class="btn btn-sm btn-danger">Reject</button></form>}</td></tr>}
    </tbody></table></div>}
</section>
@if(canApprove && Model.Stage is AdmissionStage.Approved or AdmissionStage.OfferSent){
<section class="card section-card mt-3"><div class="section-title-row"><div><h2>Complete enrollment</h2><p>Create the Identity account, Student profile, and historical class enrollment.</p></div></div>
@if(Model.ClassId.HasValue){<form asp-action="Enroll" method="post" class="row g-3 align-items-end"><input type="hidden" name="id" value="@Model.Id" /><div class="col-md-8"><label class="form-label" for="field-admissions-details-sectionid-8208">Section</label><select id="field-admissions-details-sectionid-8208" name="sectionId" class="form-select" required>@foreach(var availableSection in sections.Where(s=>s.ClassId==Model.ClassId.GetValueOrDefault())){<option value="@availableSection.Id">@availableSection.Name</option>}</select></div><div class="col-md-4"><button class="btn btn-success w-100" type="submit" data-confirm="Create the Student account and enrollment now?">Enroll student</button></div></form>}else{<div class="alert alert-warning mb-0">Assign a class on the Edit page before enrollment.</div>}
</section>}
<section class="card table-card mt-3"><div class="section-title-row p-3"><div><h2>Stage history</h2><p>Immutable workflow activity.</p></div></div>@if(Model.StageHistory.Count==0){<div class="empty-state"><p>No stage changes recorded yet.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>When</th><th>From</th><th>To</th><th>Comment</th></tr></thead><tbody>@foreach(var history in Model.StageHistory){<tr><td>@history.ChangedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@history.FromStage</td><td><span class="badge bg-info">@history.ToStage</span></td><td>@(history.Comment??"—")</td></tr>}</tbody></table></div>}</section>
@if(ViewBag.InvitationStatus is InvitationDeliveryStatus invitation){
    <section class="card section-card mt-3" aria-labelledby="invitationHeading"><h2 id="invitationHeading">Account invitation</h2>
        <partial name="_InvitationStatus" model="invitation" />
        @if(canApprove && invitation.CanResend){<form asp-action="ResendActivation" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id" /><button type="submit" class="btn btn-outline-primary">Request new invitation</button></form>}
    </section>
}
