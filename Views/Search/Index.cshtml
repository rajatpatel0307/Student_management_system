@model IReadOnlyList<Student_Management_System.Models.SearchResultViewModel>
@{ ViewData["Title"]="Global search"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Permission-aware search</span><h1>Global search</h1><p>Find authorized students, applicants, subjects, and library titles.</p></div></div>
<form method="get" class="card section-card mb-3"><label class="form-label" for="globalQuery">Search the ERP</label><div class="input-group input-group-lg"><span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span><input id="globalQuery" name="q" value="@ViewBag.Query" class="form-control" minlength="2" autofocus placeholder="Enter at least two characters" /><button class="btn btn-primary">Search</button></div></form>
@if(!string.IsNullOrWhiteSpace((string?)ViewBag.Query)&&Model.Count==0){<div class="card"><div class="empty-state"><span class="empty-state-icon"><i class="fa-solid fa-magnifying-glass"></i></span><h3>No authorized results</h3><p>Try a different term. Records outside your permissions are never displayed.</p></div></div>}
@foreach(var group in Model.GroupBy(r=>r.Group)){<section class="card mb-3"><div class="section-title-row p-3"><div><h2>@group.Key</h2><p>@group.Count() results</p></div></div><div class="list-group list-group-flush">@foreach(var item in group){<a asp-controller="@item.Controller" asp-action="@item.Action" asp-route-id="@item.RouteId" class="list-group-item list-group-item-action"><strong>@item.Title</strong><small class="d-block text-muted">@item.Subtitle</small></a>}</div></section>}
