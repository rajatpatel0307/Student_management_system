@model Student_Management_System.Models.GuardianStudentViewModel
@{ ViewData["Title"]=Model.Student.FullName; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Guardian portal / Student</span><h1>@Model.Student.FullName</h1><p>@Model.Student.Class?.Name · Section @Model.Student.Section?.Name · @Model.Student.Department?.Name</p></div><div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Switch student</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card success"><span class="metric-label">Attendance</span><strong class="metric-value">@Model.AttendancePercentage%</strong></article><article class="metric-card"><span class="metric-label">Published marks</span><strong class="metric-value">@Model.Marks.Count</strong></article><article class="metric-card warning"><span class="metric-label">Upcoming assignments</span><strong class="metric-value">@Model.Assignments.Count(a=>a.DueUtc>=DateTime.UtcNow)</strong></article><article class="metric-card danger"><span class="metric-label">Outstanding fees</span><strong class="metric-value">@Model.OutstandingBalance.ToString("C0")</strong></article><article class="metric-card info"><span class="metric-label">Active library loans</span><strong class="metric-value">@Model.LibraryLoans.Count</strong><small>@Model.OverdueLibraryLoans overdue</small></article><article class="metric-card"><span class="metric-label">Notices</span><strong class="metric-value">@Model.Notices.Count</strong></article></div>
<div class="row g-3">
<div class="col-xl-6"><section class="card table-card h-100"><div class="section-title-row p-3"><div><h2>Recent attendance</h2><p>Latest lecture and subject records.</p></div></div>@if(Model.Attendance.Count==0){<div class="empty-state"><p>No attendance records.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Subject</th><th>Status</th></tr></thead><tbody>@foreach(var item in Model.Attendance.Take(15)){<tr><td>@item.Date.ToString("dd MMM yyyy")</td><td>@(item.Subject?.Name??"General")</td><td><span class="badge @(item.Status=="Present"?"bg-success":"bg-warning")">@item.Status</span></td></tr>}</tbody></table></div>}</section></div>
<div class="col-xl-6"><section class="card table-card h-100"><div class="section-title-row p-3"><div><h2>Published marks</h2><p>Only approved results from published exams are displayed.</p></div></div>@if(Model.Marks.Count==0){<div class="empty-state"><p>No published marks.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Exam</th><th>Subject</th><th>Score</th><th>Grade</th></tr></thead><tbody>@foreach(var item in Model.Marks.Take(15)){<tr><td>@item.Exam.Name</td><td>@item.Subject.Name</td><td>@item.Score.ToString("0.##")/@item.Exam.MaximumMarks.ToString("0.##")</td><td><span class="badge bg-info">@item.Grade</span></td></tr>}</tbody></table></div>}</section></div>
</div>
@if(Model.Transactions.Count>0){<section class="card table-card mt-3"><div class="section-title-row p-3"><div><h2>Payment history</h2><p>Immutable receipts and adjustments.</p></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Receipt</th><th>Date</th><th>Term</th><th>Type</th><th>Amount</th></tr></thead><tbody>@foreach(var item in Model.Transactions.Take(20)){<tr><td><a asp-controller="Finance" asp-action="Details" asp-route-id="@item.Id" class="record-link">@item.ReceiptNumber</a></td><td>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@item.Fee.Term</td><td>@item.Type</td><td>@item.Amount.ToString("C")</td></tr>}</tbody></table></div></section>}
<div class="row g-3 mt-1">
    <div class="col-xl-6"><section class="card table-card h-100"><div class="section-title-row p-3"><div><h2>Issued invoices</h2><p>Current fee obligations visible to this Guardian.</p></div></div>@if(Model.Invoices.Count==0){<div class="empty-state"><p>No invoices available.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Invoice</th><th>Due</th><th>Status</th><th>Balance</th></tr></thead><tbody>@foreach(var invoice in Model.Invoices.Take(15)){<tr><td>@invoice.InvoiceNumber</td><td>@invoice.DueUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge bg-info">@invoice.Status</span></td><td>@Math.Max(0,invoice.TotalAmount-invoice.AidAmount-invoice.PaidAmount).ToString("C")</td></tr>}</tbody></table></div>}</section></div>
    <div class="col-xl-6"><section class="card table-card h-100"><div class="section-title-row p-3"><div><h2>Library loans</h2><p>Open loans and overdue alerts.</p></div></div>@if(Model.LibraryLoans.Count==0){<div class="empty-state"><p>No active loans.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Book</th><th>Due</th><th>Status</th></tr></thead><tbody>@foreach(var loan in Model.LibraryLoans){<tr><td>@loan.LibraryBookCopy.LibraryBook.Title</td><td>@loan.DueUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge @(loan.DueUtc<DateTime.UtcNow?"bg-danger":"bg-success")">@(loan.DueUtc<DateTime.UtcNow?"Overdue":"On loan")</span></td></tr>}</tbody></table></div>}</section></div>
</div>
