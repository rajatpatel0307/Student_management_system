@model IReadOnlyList<Student_Management_System.Models.GuardianProfile>
@using Student_Management_System.Models
@{
    ViewData["Title"] = "Guardians";
    var students = ViewBag.Students as IEnumerable<Student> ?? [];
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">People</span><h1>Guardians</h1><p>Create secure Guardian accounts and manage linked Students.</p></div></div>
<div class="row g-3">
<div class="col-xl-5"><section class="card section-card"><h2>Create Guardian</h2><form asp-action="Create" method="post" class="row g-3"><div class="col-12"><label class="form-label" for="field-guardians-index-fullname-586">Full name</label><input id="field-guardians-index-fullname-586" name="fullName" class="form-control" required /></div><div class="col-12"><label class="form-label" for="field-guardians-index-email-710">Email</label><input id="field-guardians-index-email-710" name="email" type="email" class="form-control" required /></div><div class="col-md-6"><label class="form-label" for="field-guardians-index-relationship-842">Relationship</label><input id="field-guardians-index-relationship-842" name="relationship" class="form-control" required /></div><div class="col-md-6"><label class="form-label" for="field-guardians-index-phone-975">Phone</label><input id="field-guardians-index-phone-975" name="phone" class="form-control" /></div><div class="col-12"><label class="form-label" for="field-guardians-index-studentid-1083">Student</label><select id="field-guardians-index-studentid-1083" name="studentId" class="form-select" required>@foreach(var s in students){<option value="@s.Id">@s.FullName</option>}</select></div><div class="col-12 form-check"><input class="form-check-input" type="checkbox" id="guardianFinanceAccess" name="canViewFinance" value="true" checked /><label class="form-check-label" for="guardianFinanceAccess">Allow finance access</label></div><div class="col-12"><button class="btn btn-primary" type="submit">Create and invite</button></div></form></section></div>
<div class="col-xl-7"><section class="card table-card"><div class="table-responsive"><table class="table"><thead><tr><th>Guardian</th><th>Relationship</th><th>Linked Students</th></tr></thead><tbody>@foreach(var g in Model){<tr><td><strong>@g.FullName</strong><small class="d-block text-muted">@g.Email</small></td><td>@g.Relationship</td><td>@string.Join(", ", g.StudentLinks.Select(l=>l.Student.FullName))</td></tr>}</tbody></table></div></section></div>
</div>
