@model Student_Management_System.Models.PagedResult<Student_Management_System.Models.StudentInvoice>
@{
    ViewData["Title"] = "Student invoices";
    var students = ViewBag.Students as IEnumerable<Student> ?? [];
    var years = ViewBag.Years as IEnumerable<AcademicYear> ?? [];
    var fees = ViewBag.Fees as IEnumerable<Fee> ?? [];
    var query = ViewContext.HttpContext.Request.Query;
}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Finance</span><h1>Student invoices</h1><p>Issued charges, approved aid, immutable payment allocations, and outstanding balances.</p></div><div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Transaction ledger</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Filtered invoices</span><strong class="metric-value">@Model.TotalCount</strong></article><article class="metric-card success"><span class="metric-label">Paid on page</span><strong class="metric-value">@Model.Items.Count(i=>i.Status==InvoiceStatus.Paid)</strong></article><article class="metric-card warning"><span class="metric-label">Overdue on page</span><strong class="metric-value">@Model.Items.Count(i=>i.Status==InvoiceStatus.Overdue)</strong></article><article class="metric-card info"><span class="metric-label">Outstanding on page</span><strong class="metric-value">@Model.Items.Sum(i=>Math.Max(0,i.TotalAmount-i.AidAmount-i.PaidAmount)).ToString("C")</strong></article></div>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-finance-invoices-search-1578">Search</label><input id="field-finance-invoices-search-1578" name="search" value="@Model.Search" class="form-control" placeholder="Invoice, student, or email" /></div><div><label class="form-label" for="field-finance-invoices-status-1736">Status</label><select id="field-finance-invoices-status-1736" name="status" class="form-select"><option value="">All</option>@foreach(var status in Enum.GetValues<InvoiceStatus>()){<option selected="@(query["status"]==status.ToString())">@status</option>}</select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Invoices" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card mb-3">@if(Model.Items.Count==0){<div class="empty-state"><span class="empty-state-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span><h2>No invoices</h2><p>Issue an invoice from active fee structures below.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Invoice</th><th>Student</th><th>Year</th><th>Issued</th><th>Due</th><th>Total</th><th>Aid</th><th>Paid</th><th>Outstanding</th><th>Status</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.InvoiceNumber</td><td><a asp-controller="Students" asp-action="Details" asp-route-id="@item.StudentId" class="record-link">@item.Student.FullName</a></td><td>@item.AcademicYear.Name</td><td>@item.IssuedUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@item.DueUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@item.TotalAmount.ToString("C")</td><td>@item.AidAmount.ToString("C")</td><td>@item.PaidAmount.ToString("C")</td><td>@Math.Max(0,item.TotalAmount-item.AidAmount-item.PaidAmount).ToString("C")</td><td><span class="badge bg-info">@item.Status</span></td></tr>}</tbody></table></div><partial name="_Pagination" model="Model" />}</section>
<section class="card section-card"><div class="section-title-row"><div><h2>Issue invoice</h2><p>Selected fee structures must apply to the Student’s current class.</p></div></div><form asp-action="IssueInvoice" method="post"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="field-finance-invoices-studentid-3607">Student</label><select id="field-finance-invoices-studentid-3607" name="studentId" class="form-select" required><option value="">Select student</option>@foreach(var item in students){<option value="@item.Id">@item.FullName · @item.Email</option>}</select></div><div class="col-md-3"><label class="form-label" for="field-finance-invoices-academicyearid-3873">Academic year</label><select id="field-finance-invoices-academicyearid-3873" name="academicYearId" class="form-select" required><option value="">Select year</option>@foreach(var item in years){<option value="@item.Id">@item.Name</option>}</select></div><div class="col-md-5"><label class="form-label" for="field-finance-invoices-feeids-4126">Fee structures</label><select id="field-finance-invoices-feeids-4126" name="feeIds" class="form-select" multiple size="5" required>@foreach(var item in fees){<option value="@item.Id">@item.Term · @item.Amount.ToString("C")</option>}</select></div></div><div class="form-actions"><button class="btn btn-primary" data-confirm="Issue this invoice using the selected fee structures and approved aid?">Issue invoice</button></div></form></section>
