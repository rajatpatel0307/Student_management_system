@{ ViewData["Title"]="Send notification"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Notification center</span><h1>Send role notification</h1><p>Deliver a permission-safe in-app notification to every account in one role.</p></div></div>
<form asp-action="Send" method="post" data-track-changes><section class="card section-card"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="field-notifications-send-role-408">Target role</label><select id="field-notifications-send-role-408" name="role" class="form-select" required><option value="">Select role</option>@foreach(var role in new[]{"Admin","HOD","Professor","Student","Guardian","Accountant","Librarian","AdmissionOfficer","ExaminationOfficer"}){<option>@role</option>}</select></div><div class="col-md-6"><label class="form-label" for="field-notifications-send-title-740">Title</label><input id="field-notifications-send-title-740" name="title" class="form-control" required maxlength="160" /></div><div class="col-12"><label class="form-label" for="field-notifications-send-message-873">Message</label><textarea id="field-notifications-send-message-873" name="message" class="form-control" rows="5" required maxlength="1000"></textarea></div><div class="col-12"><label class="form-label" for="field-notifications-send-actionurl-1032">Application link (optional)</label><input id="field-notifications-send-actionurl-1032" name="actionUrl" class="form-control" placeholder="/Assignment" maxlength="500" /></div></div></section><div class="sticky-form-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit" data-confirm="Send this notification to every user in the selected role?">Send notification</button></div></form>
