@model IReadOnlyList<Student_Management_System.Models.UserNotification>
@{ ViewData["Title"]="Notifications"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Notification center</span><h1>Notifications</h1><p>@ViewBag.UnreadCount unread updates for your account.</p></div><div class="page-actions">@if(User.IsInRole("SuperAdmin")||User.IsInRole("Admin")){<a asp-action="Send" class="btn btn-primary">Send notification</a>}<form asp-action="ReadAll" method="post"><button class="btn btn-outline-secondary" type="submit">Mark all read</button></form></div></div>
<form method="get" class="mb-3"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="unreadOnly" name="unreadOnly" value="true" checked="@(ViewBag.UnreadOnly==true)" data-submit-on-change /><label class="form-check-label" for="unreadOnly">Show unread only</label></div></form>
<section class="card"><div class="list-group list-group-flush">@if(Model.Count==0){<div class="empty-state"><span class="empty-state-icon"><i class="fa-regular fa-bell"></i></span><h3>You're all caught up</h3><p>No notifications match the current filter.</p></div>}@foreach(var item in Model){<form asp-action="Read" method="post" class="list-group-item list-group-item-action"><input type="hidden" name="id" value="@item.Id" /><button type="submit" class="border-0 bg-transparent text-start w-100"><div class="d-flex justify-content-between gap-3"><div><strong>@item.Title</strong><p class="mb-1">@item.Message</p><small class="text-muted">@item.Category · @item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small></div>@if(!item.IsRead){<span class="badge bg-primary align-self-start">New</span>}</div></button></form>}</div></section>
