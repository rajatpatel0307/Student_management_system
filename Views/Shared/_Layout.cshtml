@using Student_Management_System.Services
@inject PermissionService Permissions
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var pageTitle = ViewData["Title"]?.ToString();
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = action == "Index"
            ? System.Text.RegularExpressions.Regex.Replace(controller, "([a-z])([A-Z])", "$1 $2")
            : System.Text.RegularExpressions.Regex.Replace(action, "([a-z])([A-Z])", "$1 $2");
    }
    var role = User.IsInRole("SuperAdmin") ? "Super Admin"
        : User.IsInRole("Admin") ? "Admin"
        : User.IsInRole("HOD") ? "HOD"
        : User.IsInRole("Professor") ? "Professor"
        : User.IsInRole("Student") ? "Student"
        : User.IsInRole("Guardian") ? "Guardian"
        : User.IsInRole("Accountant") ? "Accountant"
        : User.IsInRole("Librarian") ? "Librarian"
        : User.IsInRole("AdmissionOfficer") ? "Admission Officer"
        : User.IsInRole("ExaminationOfficer") ? "Examination Officer"
        : User.IsInRole("TransportManager") ? "Transport Manager"
        : User.IsInRole("HostelManager") ? "Hostel Manager"
        : User.IsInRole("Registrar") ? "Registrar"
        : User.IsInRole("PlacementOfficer") ? "Placement Officer"
        : User.IsInRole("Employee") ? "Employee"
        : "User";
    var displayName = User.Identity?.Name ?? "User";
    var initials = string.Concat(displayName
        .Split(new[] { ' ', '.', '@', '_' }, StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
    if (string.IsNullOrWhiteSpace(initials)) initials = "U";
    var canAdmission = isAuthenticated && await Permissions.HasAsync(User, "admission.view");
    var canFinance = isAuthenticated && await Permissions.HasAsync(User, "fees.view");
    var canMarks = isAuthenticated && await Permissions.HasAsync(User, "marks.view");
    var canAttendance = isAuthenticated && await Permissions.HasAsync(User, "attendance.view");
    var canManageDepartments = isAuthenticated && await Permissions.HasAsync(User, "ManageDepartments");
    var canManageTeachers = isAuthenticated && await Permissions.HasAsync(User, "ManageTeachers");
    var canManageStudents = isAuthenticated && await Permissions.HasAsync(User, "ManageStudents");
    var canManageAcademics = isAuthenticated && await Permissions.HasAsync(User, "ManageAcademics");
    var canReports = isAuthenticated && await Permissions.HasAsync(User, "reports.view");
    var canAcademicStructure = isAuthenticated && await Permissions.HasAsync(User, "academic.structure.manage");
    var canPromote = isAuthenticated && await Permissions.HasAsync(User, "student.lifecycle.manage");
    var canCommunicate = isAuthenticated && await Permissions.HasAsync(User, "communications.manage");
    var canApprovals = isAuthenticated && await Permissions.HasAsync(User, "approvals.manage");
    var cspNonce = ViewContext.HttpContext.Items["CspNonce"]?.ToString();
    var contextualBackActions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Details", "Create", "Edit", "Delete", "AdminDetails", "CreateAdmin",
        "EditAdmin", "Permissions", "Mfa", "RecoveryCodes"
    };
    var showContextualBack = isAuthenticated && contextualBackActions.Contains(action);
    var pageKind = action.Equals("Delete", StringComparison.OrdinalIgnoreCase) ? "confirmation"
        : contextualBackActions.Contains(action) ? (action.Contains("Details", StringComparison.OrdinalIgnoreCase) ? "details" : "form")
        : "workspace";
    var splitAccountPage = controller.Equals("Account", StringComparison.OrdinalIgnoreCase)
        && new[] { "Login", "ForgotPassword", "ResetPassword" }.Contains(action);
    var backFallbackUrl = controller.Equals("Account", StringComparison.OrdinalIgnoreCase)
        ? Url.Action("Index", "Profile")
        : Url.Action("Index", controller);
    backFallbackUrl ??= Url.Action("Workspace", "Home") ?? "/";
    string IsActive(string targetController, string? targetAction = null)
        => controller.Equals(targetController, StringComparison.OrdinalIgnoreCase)
           && (targetAction == null || action.Equals(targetAction, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/icons/eduflow.svg" type="image/svg+xml" />
    <title>@pageTitle · EduFlow</title>
    <script nonce="@cspNonce">
        (() => {
            document.documentElement.dataset.theme = 'light';
            localStorage.removeItem('sms-theme');
            if (localStorage.getItem('sms-sidebar-collapsed') === 'true' &&
                matchMedia('(min-width: 992px)').matches) {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(isAuthenticated ? "app-body" : "auth-body")">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    @if (isAuthenticated)
    {
        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>
        <aside class="app-sidebar" id="appSidebar" aria-label="Primary navigation">
            <div class="sidebar-brand">
                <a class="brand-link" asp-controller="Home" asp-action="Index" aria-label="EduFlow home">
                    <span class="brand-mark"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
                    <span class="brand-copy">
                        <strong>EduFlow</strong>
                        <small>Campus management</small>
                    </span>
                </a>
                <button class="sidebar-toggle-control" type="button" data-sidebar-toggle
                        aria-controls="appSidebar" aria-expanded="true"
                        aria-label="Collapse navigation" title="Toggle navigation">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Staff administration</p>
                        <a class="nav-link @IsActive("Staff")" href="/Staff" title="Manage staff">
                            <i class="fa-solid fa-user-shield" aria-hidden="true"></i><span>Manage staff</span>
                        </a>
                    </div>
                }
                @{
                    var operationalWorkspace = ViewData["StaffWorkspace"] as StaffWorkspace
                        ?? StaffWorkspaceCatalog.All.FirstOrDefault(w => User.IsInRole(w.Role));
                }
                @if (operationalWorkspace != null)
                {
                    <div class="nav-group">
                        <p class="nav-label">Staff workspace</p>
                        <a class="nav-link" href="/Staff/Workspace/@operationalWorkspace.Key">
                            <i class="fa-solid fa-table-cells-large"></i><span>@operationalWorkspace.Title dashboard</span>
                        </a>
                        @foreach (var staffPage in operationalWorkspace.Pages)
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == staffPage.Slug ? "active" : "")" href="/Staff/Workspace/@operationalWorkspace.Key/@staffPage.Slug"><i class="fa-solid fa-list-check"></i><span>@staffPage.Title</span></a>
                        }
                        <a class="nav-link" href="/Staff/Workspace/@operationalWorkspace.Key/messages"><i class="fa-regular fa-envelope"></i><span>Messages</span></a>
                        <a class="nav-link" href="/Staff/Workspace/@operationalWorkspace.Key/activity"><i class="fa-solid fa-clock-rotate-left"></i><span>Activity history</span></a>
                        <a class="nav-link" href="/Profile"><i class="fa-regular fa-user"></i><span>Profile</span></a>
                        <a class="nav-link" href="/Account/ChangePassword"><i class="fa-solid fa-key"></i><span>Change password</span></a>
                        <a class="nav-link" href="/Notifications"><i class="fa-regular fa-bell"></i><span>Notifications</span></a>
                        <a class="nav-link" href="/Staff/Workspace/@operationalWorkspace.Key/settings"><i class="fa-solid fa-sliders"></i><span>Settings</span></a>
                        <a class="nav-link" href="/Staff/Workspace/@operationalWorkspace.Key/help"><i class="fa-regular fa-circle-question"></i><span>Help &amp; support</span></a>
                    </div>
                }

                @if (operationalWorkspace == null || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="nav-group">
                        <p class="nav-label">System</p>
                        <a class="nav-link @IsActive("SuperAdmin", "Index")" asp-controller="SuperAdmin" asp-action="Index">
                            <i class="fa-solid fa-shield-halved"></i><span>Control center</span>
                        </a>
                        <a class="nav-link @IsActive("SuperAdmin", "Admins") @IsActive("SuperAdmin", "CreateAdmin") @IsActive("SuperAdmin", "Permissions")" asp-controller="SuperAdmin" asp-action="Admins">
                            <i class="fa-solid fa-user-shield"></i><span>Administrators</span>
                        </a>
                        <a class="nav-link @IsActive("SuperAdmin", "Audit")" asp-controller="SuperAdmin" asp-action="Audit">
                            <i class="fa-solid fa-clock-rotate-left"></i><span>Activity log</span>
                        </a>
                        <a class="nav-link @IsActive("SuperAdmin", "LoginHistory")" asp-controller="SuperAdmin" asp-action="LoginHistory">
                            <i class="fa-solid fa-right-to-bracket"></i><span>Login history</span>
                        </a>
                        <a class="nav-link @IsActive("SuperAdmin", "Settings")" asp-controller="SuperAdmin" asp-action="Settings">
                            <i class="fa-solid fa-sliders"></i><span>System settings</span>
                        </a>
                    </div>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Administration</p>
                        <a class="nav-link @IsActive("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                            <i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span>
                        </a>
                        @if (canManageDepartments || canManageAcademics)
                        {
                        <details class="nav-disclosure" open="@(new[] { "Departments", "AcademicYear", "Semesters" }.Contains(controller) ? "open" : null)">
                            <summary><i class="fa-solid fa-building-columns"></i><span>Organization</span><i class="fa-solid fa-chevron-down nav-chevron"></i></summary>
                            <div class="nav-submenu">
                                @if (canAcademicStructure) { <a class="@IsActive("AcademicStructure")" asp-controller="AcademicStructure" asp-action="Index">Academic structure</a> }
                                @if (canManageDepartments) { <a class="@IsActive("Departments")" asp-controller="Departments" asp-action="Index">Departments</a> }
                                @if (canManageAcademics) { <a class="@IsActive("AcademicYear")" asp-controller="AcademicYear" asp-action="Index">Academic years</a><a class="@IsActive("Semesters")" asp-controller="Semesters" asp-action="Index">Semesters</a> }
                            </div>
                        </details>
                        }
                        @if (canManageStudents || canManageTeachers)
                        {
                        <details class="nav-disclosure" open="@(new[] { "Students", "Teachers", "HodManagement" }.Contains(controller) ? "open" : null)">
                            <summary><i class="fa-solid fa-users"></i><span>People</span><i class="fa-solid fa-chevron-down nav-chevron"></i></summary>
                            <div class="nav-submenu">
                                @if (canManageStudents) { <a class="@IsActive("Students")" asp-controller="Students" asp-action="Index">Students</a> }
                                @if (canPromote) { <a class="@IsActive("Promotions")" asp-controller="Promotions" asp-action="Index">Promotion batches</a> }
                                @if (canManageTeachers) { <a class="@IsActive("Teachers")" asp-controller="Teachers" asp-action="Index">HODs &amp; Professors</a><a class="@IsActive("HodManagement")" asp-controller="HodManagement" asp-action="Index">Assignments</a> }
                            </div>
                        </details>
                        }
                        @if (canManageAcademics || canAttendance || canMarks)
                        {
                        <details class="nav-disclosure" open="@(new[] { "Classes", "Section", "Subject", "Exam", "Attendance", "Mark" }.Contains(controller) ? "open" : null)">
                            <summary><i class="fa-solid fa-book-open-reader"></i><span>Academics</span><i class="fa-solid fa-chevron-down nav-chevron"></i></summary>
                            <div class="nav-submenu">
                                @if (canManageAcademics) { <a class="@IsActive("Classes")" asp-controller="Classes" asp-action="Index">Classes</a><a class="@IsActive("Section")" asp-controller="Section" asp-action="Index">Sections</a><a class="@IsActive("Subject")" asp-controller="Subject" asp-action="Index">Subjects</a> }
                                @if (canMarks) { <a class="@IsActive("Exam")" asp-controller="Exam" asp-action="Index">Exams</a><a class="@IsActive("Mark")" asp-controller="Mark" asp-action="Index">Marks &amp; results</a> }
                                @if (canAttendance) { <a class="@IsActive("Attendance")" asp-controller="Attendance" asp-action="Index">Attendance records</a> }
                            </div>
                        </details>
                        }
                        @if (canReports) { <a class="nav-link @IsActive("Reports")" asp-controller="Reports" asp-action="Index">
                            <i class="fa-solid fa-chart-column"></i><span>Reports</span>
                        </a> }
                        @if(canAdmission){<a class="nav-link @IsActive("Admissions")" asp-controller="Admissions" asp-action="Index">
                            <i class="fa-solid fa-user-check"></i><span>Admissions</span>
                        </a>}
                        @if(canFinance){<a class="nav-link @IsActive("Finance")" asp-controller="Finance" asp-action="Index">
                            <i class="fa-solid fa-cash-register"></i><span>Finance ledger</span>
                        </a>}
                        @if(canCommunicate){<a class="nav-link @IsActive("Communications")" asp-controller="Communications" asp-action="Index">
                            <i class="fa-solid fa-paper-plane"></i><span>Communication center</span>
                        </a>}
                        <a class="nav-link @IsActive("Archive")" asp-controller="Archive" asp-action="Index">
                            <i class="fa-solid fa-box-archive"></i><span>Archived records</span>
                        </a>
                    </div>
                }

                @if (User.IsInRole("HOD"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Department</p>
                        <a class="nav-link @IsActive("HodDashboard")" asp-controller="HodDashboard" asp-action="Index">
                            <i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span>
                        </a>
                        <a class="nav-link @IsActive("HodManagement")" asp-controller="HodManagement" asp-action="Index">
                            <i class="fa-solid fa-people-arrows"></i><span>Assignments</span>
                        </a>
                        <a class="nav-link @IsActive("Students")" asp-controller="Students" asp-action="Index">
                            <i class="fa-solid fa-user-graduate"></i><span>Students</span>
                        </a>
                        <a class="nav-link @IsActive("HodManagement")" asp-controller="HodManagement" asp-action="Professors">
                            <i class="fa-solid fa-chalkboard-user"></i><span>Professors</span>
                        </a>
                        @if (canAttendance) { <a class="nav-link @IsActive("Attendance")" asp-controller="Attendance" asp-action="Index">
                            <i class="fa-solid fa-calendar-check"></i><span>Attendance records</span>
                        </a> }
                        @if (canMarks) { <a class="nav-link @IsActive("Mark")" asp-controller="Mark" asp-action="Index">
                            <i class="fa-solid fa-pen-to-square"></i><span>Marks &amp; results</span>
                        </a> }
                    </div>
                }

                @if (User.IsInRole("Professor"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Teaching</p>
                        <a class="nav-link @IsActive("ProfessorDashboard")" asp-controller="ProfessorDashboard" asp-action="Index">
                            <i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span>
                        </a>
                        @if (canAttendance) { <a class="nav-link @IsActive("Attendance")" asp-controller="Attendance" asp-action="Index">
                            <i class="fa-solid fa-calendar-check"></i><span>Attendance records</span>
                        </a> }
                        @if (canMarks) { <a class="nav-link @IsActive("Mark")" asp-controller="Mark" asp-action="Index">
                            <i class="fa-solid fa-pen-to-square"></i><span>Marks &amp; results</span>
                        </a> }
                    </div>
                }

                @if (User.IsInRole("Student"))
                {
                    <div class="nav-group">
                        <p class="nav-label">My learning</p>
                        <a class="nav-link @IsActive("StudentDashboard")" asp-controller="StudentDashboard" asp-action="Index">
                            <i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span>
                        </a>
                        <a class="nav-link @IsActive("Students", "Details")" asp-controller="Students" asp-action="Details">
                            <i class="fa-solid fa-id-card"></i><span>Academic profile</span>
                        </a>
                    </div>
                }

                @if (User.IsInRole("Guardian"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Family portal</p>
                        <a class="nav-link @IsActive("GuardianDashboard")" asp-controller="GuardianDashboard" asp-action="Index">
                            <i class="fa-solid fa-people-roof"></i><span>Linked students</span>
                        </a>
                    </div>
                }

                @if (User.IsInRole("AdmissionOfficer"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Admissions</p>
                        <a class="nav-link @IsActive("RoleDashboard", "Admissions")" asp-controller="RoleDashboard" asp-action="Admissions">
                            <i class="fa-solid fa-chart-line"></i><span>Dashboard</span>
                        </a>
                        <a class="nav-link @IsActive("Admissions")" asp-controller="Admissions" asp-action="Index">
                            <i class="fa-solid fa-user-check"></i><span>Applications</span>
                        </a>
                    </div>
                }

                @if (User.IsInRole("Accountant"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Finance</p>
                        <a class="nav-link @IsActive("RoleDashboard", "Finance")" asp-controller="RoleDashboard" asp-action="Finance">
                            <i class="fa-solid fa-chart-line"></i><span>Dashboard</span>
                        </a>
                        <a class="nav-link @IsActive("Finance")" asp-controller="Finance" asp-action="Index">
                            <i class="fa-solid fa-cash-register"></i><span>Transaction ledger</span>
                        </a>
                        <a class="nav-link @IsActive("Fee")" asp-controller="Fee" asp-action="Index">
                            <i class="fa-solid fa-file-invoice-dollar"></i><span>Fee structures</span>
                        </a>
                    </div>
                }

                @if (User.IsInRole("ExaminationOfficer"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Examinations</p>
                        <a class="nav-link @IsActive("RoleDashboard", "Examinations")" asp-controller="RoleDashboard" asp-action="Examinations">
                            <i class="fa-solid fa-chart-line"></i><span>Dashboard</span>
                        </a>
                        <a class="nav-link @IsActive("Exam")" asp-controller="Exam" asp-action="Index">
                            <i class="fa-solid fa-file-pen"></i><span>Exam management</span>
                        </a>
                    </div>
                }

                @if (User.IsInRole("Librarian"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Library</p>
                        <a class="nav-link @IsActive("RoleDashboard", "Library")" asp-controller="RoleDashboard" asp-action="Library">
                            <i class="fa-solid fa-chart-line"></i><span>Dashboard</span>
                        </a>
                    </div>
                }

                @if (User.IsInRole("TransportManager") || User.IsInRole("HostelManager") ||
                     User.IsInRole("PlacementOfficer") || User.IsInRole("Employee"))
                {
                    <div class="nav-group">
                        <p class="nav-label">Operations</p>
                        <a class="nav-link @IsActive("RoleDashboard", "Operations")" asp-controller="RoleDashboard" asp-action="Operations">
                            <i class="fa-solid fa-chart-line"></i><span>Dashboard</span>
                        </a>
                    </div>
                }

                <div class="nav-group">
                    <p class="nav-label">Campus</p>
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("HOD") ||
                         User.IsInRole("Professor") || User.IsInRole("Student"))
                    {
                        <a class="nav-link @IsActive("Notice")" asp-controller="Notice" asp-action="Index">
                            <i class="fa-solid fa-bullhorn"></i><span>Announcements</span>
                        </a>
                        <a class="nav-link @IsActive("Timetable")" asp-controller="Timetable" asp-action="Index">
                            <i class="fa-solid fa-calendar-days"></i><span>Timetable</span>
                        </a>
                        <a class="nav-link @IsActive("Assignment")" asp-controller="Assignment" asp-action="Index">
                            <i class="fa-solid fa-list-check"></i><span>Assignments</span>
                        </a>
                        <a class="nav-link @IsActive("StudyMaterials")" asp-controller="StudyMaterials" asp-action="Index">
                            <i class="fa-solid fa-folder-open"></i><span>Study materials</span>
                        </a>
                    }
                    else
                    {
                        <a class="nav-link @IsActive("Notice")" asp-controller="Notice" asp-action="Index">
                            <i class="fa-solid fa-bullhorn"></i><span>Announcements</span>
                        </a>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Student"))
                    {
                        <a class="nav-link @IsActive("Fee")" asp-controller="Fee" asp-action="Index">
                            <i class="fa-solid fa-wallet"></i><span>Fees</span>
                        </a>
                    }
                    <a class="nav-link @IsActive("Library")" asp-controller="Library" asp-action="Index">
                        <i class="fa-solid fa-book"></i><span>Library</span>
                    </a>
                    <a class="nav-link @IsActive("Leave")" asp-controller="Leave" asp-action="Index">
                        <i class="fa-solid fa-calendar-minus"></i><span>Leave</span>
                    </a>
                    @if(User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <a class="nav-link @IsActive("Guardians")" asp-controller="Guardians" asp-action="Index">
                            <i class="fa-solid fa-people-roof"></i><span>Guardians</span>
                        </a>
                    }
                    @if (canApprovals)
                    {
                    <a class="nav-link @IsActive("Approvals")" asp-controller="Approvals" asp-action="Index">
                        <i class="fa-solid fa-list-check"></i><span>Approvals</span>
                    </a>
                    }
                    @if(User.IsInRole("SuperAdmin") || User.IsInRole("Admin") ||
                        User.IsInRole("TransportManager") || User.IsInRole("HostelManager") ||
                        User.IsInRole("PlacementOfficer") || User.IsInRole("Employee") ||
                        User.IsInRole("Student"))
                    {
                        <a class="nav-link @IsActive("Operations")" asp-controller="Operations" asp-action="Index">
                            <i class="fa-solid fa-building-circle-check"></i><span>Campus operations</span>
                        </a>
                    }
                    <a class="nav-link @IsActive("Notifications")" asp-controller="Notifications" asp-action="Index">
                        <i class="fa-regular fa-bell"></i><span>Notifications</span>
                    </a>
                    <a class="nav-link @IsActive("Search")" asp-controller="Search" asp-action="Index">
                        <i class="fa-solid fa-magnifying-glass"></i><span>Global search</span>
                    </a>
                </div>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <span class="avatar avatar-sm">@initials</span>
                    <span class="sidebar-user-copy"><strong>@displayName</strong><small>@role</small></span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="icon-btn" type="submit" title="Sign out" aria-label="Sign out">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    </button>
                </form>
            </div>
        </aside>
    }

    <div class="app-shell @(isAuthenticated ? "" : "public-shell")" id="appShell">
        @if (!isAuthenticated && !splitAccountPage)
        {
            <header class="public-header">
                <a class="brand-link" asp-controller="Home" asp-action="Index" aria-label="EduFlow home">
                    <span class="brand-mark"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
                    <span class="brand-copy"><strong>EduFlow</strong><small>Campus management</small></span>
                </a>
                <span class="public-header-note"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Secure campus workspace</span>
            </header>
        }
        @if (isAuthenticated)
        {
            <header class="topbar">
                <div class="topbar-start">
                    <div class="page-context">
                        <span class="eyebrow">@role workspace</span>
                        <strong>@pageTitle</strong>
                    </div>
                </div>

                <div class="topbar-actions">
                    <button class="topbar-search" type="button" data-command-open aria-label="Open quick navigation">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>Search</span>
                        <kbd>Ctrl K</kbd>
                    </button>
                    <div class="dropdown">
                        <button class="icon-btn position-relative" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                            <i class="fa-regular fa-bell"></i>
                            @await Component.InvokeAsync("NotificationBadge")
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notification-menu">
                            <div class="dropdown-header-block"><strong>Notifications</strong><small>Campus updates and tasks</small></div>
                            <a class="notification-item" asp-controller="Notifications" asp-action="Index">
                                <span class="notification-icon info"><i class="fa-regular fa-bell"></i></span>
                                <span><strong>Notification center</strong><small>View your personal unread updates</small></span>
                            </a>
                            <a class="notification-item" asp-controller="Assignment" asp-action="Index">
                                <span class="notification-icon warning"><i class="fa-solid fa-list-check"></i></span>
                                <span><strong>Assignments</strong><small>Review current tasks and due dates</small></span>
                            </a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="profile-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Open account menu">
                            <span class="avatar avatar-sm">@initials</span>
                            <span class="profile-trigger-copy"><strong>@displayName</strong><small>@role</small></span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end profile-menu">
                            <li class="profile-menu-header">
                                <span class="avatar">@initials</span>
                                <span><strong>@displayName</strong><small>@role</small></span>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fa-regular fa-user"></i>My profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fa-solid fa-key"></i>Change password</a></li>
                            @if(User.IsInRole("SuperAdmin") || User.IsInRole("Admin")){<li><a class="dropdown-item" asp-controller="Account" asp-action="Mfa"><i class="fa-solid fa-shield-halved"></i>Multi-factor authentication</a></li>}
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="dropdown-item text-danger" type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i>Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>
        }

        <main id="main-content" class="main-content @(isAuthenticated ? "" : "public-content")" tabindex="-1">
            @if (isAuthenticated)
            {
                <div class="content-heading">
                    <nav aria-label="Breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            @if (!action.Equals("Index", StringComparison.OrdinalIgnoreCase))
                            {
                                <li class="breadcrumb-item">@System.Text.RegularExpressions.Regex.Replace(controller, "([a-z])([A-Z])", "$1 $2")</li>
                            }
                            <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                        </ol>
                    </nav>
                    @if (showContextualBack)
                    {
                        <button class="btn btn-sm btn-outline-secondary contextual-back"
                                type="button" data-history-back data-fallback-url="@backFallbackUrl">
                            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Back
                        </button>
                    }
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="app-toast-source" data-toast-type="success" data-toast-message="@TempData["Success"]"></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="app-toast-source" data-toast-type="danger" data-toast-message="@TempData["Error"]"></div>
            }

            <div class="route-content" data-controller="@controller" data-action="@action" data-page-kind="@pageKind">
                @RenderBody()
            </div>
        </main>

        @if (isAuthenticated)
        {
            <footer class="app-footer">
                <span>© @DateTime.UtcNow.Year EduFlow</span>
                <span>Secure campus management</span>
            </footer>
        }
    </div>

    <div class="command-dialog" id="commandDialog" hidden>
        <button class="command-backdrop" type="button" data-command-close aria-label="Close quick navigation"></button>
        <section class="command-panel" role="dialog" aria-modal="true" aria-labelledby="commandTitle">
            <div class="command-input-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <label class="visually-hidden" for="commandSearch">Search navigation</label>
                <input id="commandSearch" type="search" placeholder="Search pages and actions…" autocomplete="off" />
                <button class="icon-btn" type="button" data-command-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <h2 class="visually-hidden" id="commandTitle">Quick navigation</h2>
            <div class="command-results" id="commandResults"></div>
            <div class="command-empty" hidden><i class="fa-solid fa-magnifying-glass"></i><span>No matching page found</span></div>
            <div class="command-help"><span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span><span><kbd>Enter</kbd> Open</span><span><kbd>Esc</kbd> Close</span></div>
        </section>
    </div>

    <div class="modal fade" id="confirmDialog" tabindex="-1" aria-labelledby="confirmDialogTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body confirm-dialog-body">
                    <span class="confirm-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
                    <h2 id="confirmDialogTitle">Confirm this action</h2>
                    <p id="confirmDialogMessage">This change may affect existing records.</p>
                    <div class="confirm-actions">
                        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-danger" type="button" id="confirmDialogAction">Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer" aria-live="polite" aria-atomic="true"></div>
    <div class="page-loader" id="pageLoader" aria-hidden="true"><span></span></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
