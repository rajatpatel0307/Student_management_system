@model dynamic
@{
    var current = (int)Model.Page;
    var totalPages = (int)Model.TotalPages;
    var request = ViewContext.HttpContext.Request;
    var query = request.Query.ToDictionary(x => x.Key, x => (string?)x.Value.ToString());
    var pageParameter = ViewData["PageParameter"] as string ?? "page";
    var fragment = ViewData["Fragment"] as string;
    string PageUrl(int pageNumber)
    {
        query[pageParameter] = pageNumber.ToString();
        return request.Path.ToString() + Microsoft.AspNetCore.Http.QueryString.Create(query).ToString()
            + (string.IsNullOrEmpty(fragment) ? "" : "#" + Uri.EscapeDataString(fragment));
    }
}
<nav class="server-pagination" aria-label="@(ViewData["PagerLabel"] ?? "Record pages")">
    <p>Showing <strong>@Model.FirstItem to @Model.LastItem</strong> of <strong>@Model.TotalCount</strong></p>
    <ul class="pagination">
        <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
            @if (Model.HasPrevious) { <a class="page-link" href="@PageUrl(current - 1)" aria-label="Previous page"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a> }
            else { <span class="page-link" aria-disabled="true" aria-label="Previous page"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></span> }
        </li>
        @for (var pageNumber = Math.Max(1, current - 2); pageNumber <= Math.Min(totalPages, current + 2); pageNumber++)
        {
            <li class="page-item @(pageNumber == current ? "active" : "")"><a class="page-link" href="@PageUrl(pageNumber)" aria-current="@(pageNumber == current ? "page" : null)">@(pageNumber)</a></li>
        }
        <li class="page-item @(!Model.HasNext ? "disabled" : "")">
            @if (Model.HasNext) { <a class="page-link" href="@PageUrl(current + 1)" aria-label="Next page"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a> }
            else { <span class="page-link" aria-disabled="true" aria-label="Next page"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></span> }
        </li>
    </ul>
</nav>
