@model IEnumerable<Student_Management_System.Models.StatCardViewModel>
<div class="metric-grid management-stats" aria-label="Summary statistics">
@foreach (var card in Model)
{
    var filters = ViewContext.HttpContext.Request.Query
        .ToDictionary(x => x.Key, x => (string?)x.Value.ToString());
    filters["page"] = "1";
    if (card.FilterName != null) filters[card.FilterName] = card.FilterValue;
    var href = string.IsNullOrWhiteSpace(card.FilterName)
        ? null
        : ViewContext.HttpContext.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(filters).ToString();
    if (href != null)
    {
        <a class="metric-card @card.Tone metric-card-link" href="@href" aria-label="@card.Label: @card.Value. @card.SupportingText">
            <span class="metric-top"><span class="metric-icon"><i class="@card.Icon" aria-hidden="true"></i></span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
            <span class="metric-label">@card.Label</span><strong class="metric-value">@card.Value</strong>
            <span class="metric-note">@card.SupportingText</span>
        </a>
    }
    else
    {
        <article class="metric-card @card.Tone" aria-label="@card.Label: @card.Value">
            <span class="metric-top"><span class="metric-icon"><i class="@card.Icon" aria-hidden="true"></i></span></span>
            <span class="metric-label">@card.Label</span><strong class="metric-value">@card.Value</strong>
            <span class="metric-note">@card.SupportingText</span>
        </article>
    }
}
</div>
