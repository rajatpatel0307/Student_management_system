@model StudyMaterial
@{ ViewData["Title"] = $"Edit {Model.Title}"; var subjects=ViewBag.Subjects as IEnumerable<Subject>??Enumerable.Empty<Subject>(); }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Study materials / #@Model.Id / Edit</span><h1>Edit material</h1><p>Update metadata without replacing or exposing the stored file.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-12"><label asp-for="Title" class="form-label required"></label><input asp-for="Title" class="form-control" maxlength="160" required /><span asp-validation-for="Title"></span></div><div class="col-12"><label asp-for="SubjectId" class="form-label required">Subject</label><select asp-for="SubjectId" class="form-select" required>@foreach(var s in subjects){<option value="@s.Id" selected="@(s.Id==Model.SubjectId?"selected":null)">@s.Name · @(s.Class?.Name ?? "Unassigned class")</option>}</select><span asp-validation-for="SubjectId"></span></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
