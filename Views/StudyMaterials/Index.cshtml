@model Student_Management_System.Models.PagedResult<StudyMaterial>
@using Student_Management_System.Models
@{ViewData["Title"]="Study materials";}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Learning resources",Title="Study materials",Description="Browse permission-aware learning files uploaded for real subject assignments.",PrimaryAction=User.IsInRole("HOD")||User.IsInRole("Professor")?"Create":null,PrimaryLabel="Upload material",PrimaryController="StudyMaterials"})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-studymaterials-index-search-680">Search materials</label><input id="field-studymaterials-index-search-680" name="search" value="@Model.Search" class="form-control" placeholder="Title or subject"/></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Items.Count==0){<partial name="_EmptyRecords" model="@((""+"No study materials","No accessible learning files match this search.","",""))"/>}else{<div class="table-responsive"><table class="table" data-enhanced="true"><thead><tr><th>Material</th><th>Subject</th><th>Uploaded by</th><th>Date</th><th>Type</th><th class="text-end">Action</th></tr></thead><tbody>@foreach(var m in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@m.Id" class="record-link">@m.Title</a></td><td><a asp-controller="Subject" asp-action="Details" asp-route-id="@m.SubjectId" class="record-link">@m.Subject.Name</a></td><td>@m.UploadedByTeacher.FullName</td><td>@m.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="badge bg-info">@m.ContentType.Split('/').Last().ToUpperInvariant()</span></td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">View</a>@if(User.IsInRole("HOD")||(User.IsInRole("Professor")&&m.UploadedByTeacher.UserId==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)){<a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">Edit</a>}<a asp-action="Download" asp-route-id="@m.Id" class="btn btn-sm btn-primary"><i class="fa-solid fa-download"></i> Download</a></div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/>}</section>
