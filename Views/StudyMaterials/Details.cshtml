@model StudyMaterial
@{ ViewData["Title"] = Model.Title; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Study materials / #@Model.Id</span><h1>@Model.Title</h1><p>@Model.Subject.Name · Uploaded @Model.CreatedUtc.ToLocalTime().ToString("dd MMMM yyyy") by @Model.UploadedByTeacher.FullName.</p></div><div class="page-actions">@if(User.IsInRole("HOD")||(User.IsInRole("Professor")&&Model.UploadedByTeacher.UserId==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="fa-regular fa-pen-to-square"></i> Edit</a>}<a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fa-solid fa-download"></i> Download</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="row g-3"><div class="col-lg-7"><section class="card section-card"><div class="section-title-row"><div><h2>Material information</h2><p>Database-backed file metadata</p></div><span class="metric-icon"><i class="fa-regular fa-file-lines"></i></span></div><div class="detail-grid"><div class="detail-item"><small>Subject</small><strong><a asp-controller="Subject" asp-action="Details" asp-route-id="@Model.SubjectId">@Model.Subject.Name</a></strong></div><div class="detail-item"><small>Class</small><strong>@Model.Subject.Class.Name</strong></div><div class="detail-item"><small>Content type</small><strong>@Model.ContentType</strong></div><div class="detail-item"><small>Uploader</small><strong>@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")||User.IsInRole("HOD")||User.IsInRole("Professor")){<a asp-controller="Teachers" asp-action="Details" asp-route-id="@Model.UploadedByTeacherId">@Model.UploadedByTeacher.FullName</a>}else{<span>@Model.UploadedByTeacher.FullName</span>}</strong></div></div></section></div></div>
