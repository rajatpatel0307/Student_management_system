@model Student_Management_System.Models.PagedResult<AcademicYear>
@using Student_Management_System.Models
@{ViewData["Title"]="Academic years";}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Academic calendar",Title="Academic years",Description="Manage institutional periods and navigate their semesters, enrollments and exams.",PrimaryAction="Create",PrimaryLabel="Add academic year",PrimaryController="AcademicYear"})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-academicyear-index-search-626">Search</label><input id="field-academicyear-index-search-626" name="search" value="@Model.Search" class="form-control" placeholder="Academic year"/></div><div><label class="form-label" for="field-academicyear-index-status-770">Period</label><select id="field-academicyear-index-status-770" name="status" class="form-select"><option value="">All periods</option><option value="current">Current</option><option value="past">Historical</option></select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card"><div class="table-responsive"><table class="table" data-enhanced="true"><thead><tr><th>Academic year</th><th>Start</th><th>End</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var y in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@y.Id" class="record-link">@y.Name</a></td><td>@y.StartsOn.ToString("dd MMM yyyy")</td><td>@y.EndsOn.ToString("dd MMM yyyy")</td><td><span class="badge @(y.IsCurrent?"bg-success":"bg-secondary")">@(y.IsCurrent?"Current":"Historical")</span></td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@y.Id" class="btn btn-sm btn-outline-primary">View</a><a asp-action="Edit" asp-route-id="@y.Id" class="btn btn-sm btn-outline-secondary">Edit</a></div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/></section>
