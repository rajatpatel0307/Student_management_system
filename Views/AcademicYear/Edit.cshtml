@model AcademicYear
@{ ViewData["Title"] = $"Edit {Model.Name}"; }
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Academic years / #@Model.Id / Edit</span><h1>Edit @Model.Name</h1><p>Only one academic year can be current at a time.</p></div><div class="page-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to details</a></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-track-changes class="edit-shell"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="alert alert-danger"></div><section class="edit-section"><div class="row g-3">
<div class="col-12"><label asp-for="Name" class="form-label required"></label><input asp-for="Name" class="form-control" maxlength="40" required /><span asp-validation-for="Name"></span></div>
<div class="col-md-6"><label asp-for="StartsOn" class="form-label required">Starts on</label><input asp-for="StartsOn" type="date" class="form-control" required /><span asp-validation-for="StartsOn"></span></div><div class="col-md-6"><label asp-for="EndsOn" class="form-label required">Ends on</label><input asp-for="EndsOn" type="date" class="form-control" required /><span asp-validation-for="EndsOn"></span></div>
<div class="col-12"><div class="form-check form-switch"><input asp-for="IsCurrent" class="form-check-input" /><label asp-for="IsCurrent" class="form-check-label">Current academic year</label></div></div>
</div></section><div class="sticky-form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a><div><button type="reset" class="btn btn-outline-secondary">Reset</button><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
