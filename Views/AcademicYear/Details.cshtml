@model Student_Management_System.Models.AcademicYearDetailsViewModel
@{ViewData["Title"]=Model.AcademicYear.Name;}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Academic calendar / Years</span><h1>@Model.AcademicYear.Name</h1><p>@Model.AcademicYear.StartsOn.ToString("dd MMM yyyy")–@Model.AcademicYear.EndsOn.ToString("dd MMM yyyy")</p></div><div class="page-actions"><a asp-action="Edit" asp-route-id="@Model.AcademicYear.Id" class="btn btn-primary">Edit year</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Semesters</span><strong class="metric-value">@Model.Semesters.Count</strong></article><article class="metric-card info"><span class="metric-label">Enrollments</span><strong class="metric-value">@Model.Enrollments.Count</strong></article><article class="metric-card success"><span class="metric-label">Exams</span><strong class="metric-value">@Model.Exams.Count</strong></article></div>
<section class="card section-card"><div class="section-title-row"><div><h2>Semesters by department</h2></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Semester</th><th>Department</th><th>Number</th></tr></thead><tbody>@foreach(var s in Model.Semesters){<tr><td><a asp-controller="Semesters" asp-action="Details" asp-route-id="@s.Id" class="record-link">@s.Name</a></td><td>@s.Department.Name</td><td>@s.Number</td></tr>}</tbody></table></div></section>
