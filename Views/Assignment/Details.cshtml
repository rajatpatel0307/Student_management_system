@model Student_Management_System.Models.AssignmentDetailsViewModel
@{ViewData["Title"]=Model.Assignment.Title;var item=Model.Assignment;}
<div class="page-header"><div class="page-header-copy"><span class="eyebrow">Coursework / Assignments / #@item.Id</span><h1>@item.Title</h1><p>@(item.Subject?.Name ?? "Unassigned subject") · @(item.Subject?.Class?.Name ?? "Unassigned class")</p></div><div class="page-actions">@if(User.IsInRole("HOD")||User.IsInRole("Professor")){<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit assignment</a>}<a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<div class="metric-grid mb-3"><article class="metric-card"><span class="metric-label">Eligible students</span><strong class="metric-value">@Model.EligibleStudents</strong></article><article class="metric-card success"><span class="metric-label">Submitted</span><strong class="metric-value">@Model.Submissions.Count</strong></article><article class="metric-card warning"><span class="metric-label">Pending</span><strong class="metric-value">@Math.Max(0,Model.EligibleStudents-Model.Submissions.Count)</strong></article><article class="metric-card info"><span class="metric-label">Evaluated</span><strong class="metric-value">@Model.Submissions.Count(s=>s.Score.HasValue)</strong></article></div>
<section class="card section-card mb-3"><div class="section-title-row"><div><h2>Instructions</h2><p>Due @item.DueUtc.ToLocalTime().ToString("dd MMMM yyyy, hh:mm tt")</p></div></div><p>@item.Instructions</p></section>
@if(User.IsInRole("HOD")||User.IsInRole("Professor"))
{
<section class="card section-card mb-3"><div class="section-title-row"><div><h2>Assessment rubric</h2><p>@item.Rubric.Sum(r=>r.MaximumScore).ToString("0.##") of @item.MaximumScore.ToString("0.##") points configured.</p></div></div><form asp-action="AddRubric" method="post" class="row g-3 align-items-end"><input type="hidden" name="assignmentId" value="@item.Id"/><div class="col-md-4"><label class="form-label" for="field-assignment-details-name-1990">Criterion</label><input id="field-assignment-details-name-1990" name="name" class="form-control" maxlength="160" required/></div><div class="col-md-2"><label class="form-label" for="field-assignment-details-maximumscore-2127">Maximum</label><input id="field-assignment-details-maximumscore-2127" name="maximumScore" type="number" min="0.01" max="@item.MaximumScore" step="0.01" class="form-control" required/></div><div class="col-md-4"><label class="form-label" for="field-assignment-details-description-2316">Description</label><input id="field-assignment-details-description-2316" name="description" class="form-control" maxlength="1000"/></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Add</button></div></form>@if(item.Rubric.Count>0){<div class="table-responsive mt-3"><table class="table"><thead><tr><th>Criterion</th><th>Description</th><th>Points</th></tr></thead><tbody>@foreach(var criterion in item.Rubric.OrderBy(r=>r.Id)){<tr><td>@criterion.Name</td><td>@(criterion.Description??"—")</td><td>@criterion.MaximumScore.ToString("0.##")</td></tr>}</tbody></table></div>}</section>
}
@if(User.IsInRole("Student"))
{
    var ownSubmission = Model.Submissions.FirstOrDefault();
    <section class="card section-card">
        <div class="section-title-row"><div><h2>@(ownSubmission == null ? "Submit assignment" : "Update submission")</h2><p>Each save creates a permanent submission version.</p></div></div>
        @if (item.DueUtc >= DateTime.UtcNow || item.AllowLateSubmission)
        {
            <form asp-action="Submit" method="post" enctype="multipart/form-data">
                <input type="hidden" name="assignmentId" value="@item.Id" />
                <label class="form-label" for="assignmentAnswer">Answer</label>
                <textarea id="assignmentAnswer" name="answer" class="form-control" rows="8" maxlength="4000" required>@ownSubmission?.Answer</textarea>
                <label class="form-label mt-3" for="assignmentAttachment">Attachment <span class="text-muted">(optional PDF, DOCX, or PPTX)</span></label>
                <input id="assignmentAttachment" name="attachment" type="file" accept=".pdf,.docx,.pptx" class="form-control" />
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <small class="text-muted">Maximum 4,000 characters.</small>
                    <button class="btn btn-primary" data-confirm="Submit this assignment version?">Save submission</button>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-warning mb-0">The submission deadline has passed.</div>
        }
        @if (ownSubmission != null)
        {
            <hr />
            <dl class="row mb-0">
                <dt class="col-sm-3">Latest submission</dt><dd class="col-sm-9">@ownSubmission.SubmittedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                <dt class="col-sm-3">Score</dt><dd class="col-sm-9">@(ownSubmission.Score.HasValue ? $"{ownSubmission.Score:0.##}/{item.MaximumScore:0.##}" : "Pending evaluation")</dd>
                <dt class="col-sm-3">Feedback</dt><dd class="col-sm-9">@(ownSubmission.Feedback ?? "No feedback yet")</dd>
                <dt class="col-sm-3">Versions</dt><dd class="col-sm-9">@ownSubmission.Versions.Count</dd>
            </dl>
            @if(ownSubmission.Versions.Any(v=>v.AttachmentStorageKey!=null)){<div class="d-flex flex-wrap gap-2 mt-3">@foreach(var version in ownSubmission.Versions.Where(v=>v.AttachmentStorageKey!=null).OrderByDescending(v=>v.VersionNumber)){<a asp-action="DownloadAttachment" asp-route-id="@version.Id" class="btn btn-sm btn-outline-primary">Download version @version.VersionNumber attachment</a>}</div>}
        }
    </section>
}
else
{
    <section class="card table-card">
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Student</th><th>Submitted</th><th>Status</th><th>Versions</th><th>Evaluation</th></tr></thead>
                <tbody>
                @foreach(var s in Model.Submissions)
                {
                    <tr>
                        <td><a asp-controller="Students" asp-action="Details" asp-route-id="@s.StudentId" asp-fragment="assignments" class="record-link">@s.Student?.FullName</a></td>
                        <td>@s.SubmittedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="badge @(s.SubmittedUtc<=item.DueUtc?"bg-success":"bg-warning")">@(s.SubmittedUtc<=item.DueUtc?"On time":"Late")</span></td>
                        <td>@s.Versions.Count @foreach(var version in s.Versions.Where(v=>v.AttachmentStorageKey!=null).OrderByDescending(v=>v.VersionNumber)){<a asp-action="DownloadAttachment" asp-route-id="@version.Id" class="d-block small">Attachment v@version.VersionNumber</a>}</td>
                        <td>
                            <form asp-action="Grade" method="post" class="row g-2 align-items-end">
                                <input type="hidden" name="submissionId" value="@s.Id" />
                                <div class="col-sm-3"><label class="form-label" for="score-@s.Id">Score / @item.MaximumScore.ToString("0.##")</label><input id="score-@s.Id" name="score" type="number" min="0" max="@item.MaximumScore" step="0.01" value="@s.Score" class="form-control form-control-sm" required /></div>
                                <div class="col-sm-7"><label class="form-label" for="feedback-@s.Id">Feedback</label><input id="feedback-@s.Id" name="feedback" value="@s.Feedback" maxlength="1000" class="form-control form-control-sm" /></div>
                                <div class="col-sm-2"><button class="btn btn-sm btn-primary w-100">Save</button></div>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
