@model Student_Management_System.Models.PagedResult<Assignment>
@using Student_Management_System.Models
@{ViewData["Title"]="Assignments";var query=ViewContext.HttpContext.Request.Query;}
<partial name="_ManagementHeader" model="@(new ManagementHeaderViewModel{Eyebrow="Coursework",Title="Assignments",Description="Track assigned work, deadlines and real student submission progress.",PrimaryAction=User.IsInRole("HOD")||User.IsInRole("Professor")?"Create":null,PrimaryLabel="Add assignment",PrimaryController="Assignment"})"/>
<partial name="_StatCards" model="@((IEnumerable<StatCardViewModel>)ViewBag.Stats)"/>
<form method="get" class="card filter-panel"><div class="filter-panel-grid"><div><label class="form-label" for="field-assignment-index-search-695">Search</label><input id="field-assignment-index-search-695" name="search" value="@Model.Search" class="form-control" placeholder="Title or subject"/></div><div><label class="form-label" for="field-assignment-index-status-842">Status</label><select id="field-assignment-index-status-842" name="status" class="form-select"><option value="">All</option><option value="active" selected="@(query["status"]=="active")">Active</option><option value="overdue" selected="@(query["status"]=="overdue")">Overdue</option></select></div><div class="filter-actions"><button class="btn btn-primary">Apply</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></div></form>
<section class="card table-card">@if(Model.Items.Count==0){<partial name="_EmptyRecords" model="@((""+"No assignments found","There are no assignments matching these filters.","",""))"/>}else{<div class="table-responsive"><table class="table" data-enhanced="true"><thead><tr><th>Assignment</th><th>Subject</th><th>Class</th><th>Due</th><th>Submissions</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var a in Model.Items){var overdue=a.DueUtc<DateTime.UtcNow;<tr><td><a asp-action="Details" asp-route-id="@a.Id" class="record-link">@a.Title</a></td><td><a asp-controller="Subject" asp-action="Details" asp-route-id="@a.SubjectId" class="record-link">@a.Subject?.Name</a></td><td>@a.Subject?.Class?.Name</td><td>@a.DueUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>@a.Submissions.Count</td><td><span class="badge @(overdue?"bg-danger":"bg-success")">@(overdue?"Overdue":"Active")</span></td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">View</a>@if(User.IsInRole("HOD")||User.IsInRole("Professor")){<a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Edit</a>}</div></td></tr>}</tbody></table></div><partial name="_ServerPagination" model="Model"/>}</section>
