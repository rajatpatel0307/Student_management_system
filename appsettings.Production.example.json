{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "CommandTimeoutSeconds": 45
  },
  "Smtp": {
    "Enabled": true,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "<SMTP_SENDER_FROM_SECRET_PROVIDER>",
    "Password": "<SMTP_APP_PASSWORD_FROM_SECRET_PROVIDER>",
    "UseStartTls": true,
    "TimeoutSeconds": 30
  },
  "DataProtection": {
    "KeyDirectory": "/var/lib/eduflow/data-protection-keys",
    "CertificateThumbprint": "SET_TO_CERTIFICATE_THUMBPRINT"
  },
  "PrivateUploads": {
    "RootPath": "/var/lib/eduflow/private-uploads"
  },
  "UploadMalwareScanner": {
    "Enabled": true,
    "Command": "clamdscan",
    "Arguments": [ "--no-summary" ],
    "TimeoutSeconds": 30
  },
  "ReverseProxy": {
    "KnownProxies": [ "10.0.0.10" ]
  },
  "SmsGateway": {
    "Enabled": false,
    "Endpoint": "",
    "ApiKey": "",
    "SenderId": "EduFlow"
  },
  "DatabaseBootstrap": {
    "ApplyMigrationsOnStartup": false
  },
  "SkipDatabaseBootstrap": false,
  "SeedDevelopmentData": false
}
