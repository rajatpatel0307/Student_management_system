{
  "SkipDatabaseBootstrap": true,
  "SeedDevelopmentData": false,
  "Smtp": {
    "Enabled": false
  },
  "DatabaseBootstrap": {
    "ApplyMigrationsOnStartup": true
  },
  "Database": {
    "UseWindowsIntegratedSecurityFallback": true,
    "LocalSqlExpressDatabase": "StudentDB",
    "CommandTimeoutSeconds": 45
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
